@using Finances.App.Client.Services
@using Finances.App.Shared
@implements IDisposable
@inject IFinanceStore Store
@inject WorkerContextService WorkerContext
@inject IStringLocalizer<AppStrings> L

<div class="d-flex align-items-center gap-2">
    <label class="form-label mb-0" style="white-space: nowrap; font-size: 0.8125rem;" for="global-worker-filter">@L["WorkerFilter_Label"]</label>
    @if (WorkerContext.SelectedWorkerId.HasValue)
    {
        <span class="badge badge-tint badge-tint-primary" title="@L["WorkerFilter_ActiveTitle"]">@L["WorkerFilter_Active"]</span>
    }
    <select id="global-worker-filter" class="form-select form-select-sm @(WorkerContext.SelectedWorkerId.HasValue ? "worker-filter-active" : null)"
            style="width: auto; min-width: 160px;"
            value="@WorkerContext.SelectedWorkerId" @onchange="OnWorkerChanged">
        <option value="">@L["WorkerFilter_All"]</option>
        @if (workers != null)
        {
            @foreach (var w in workers)
            {
                <option value="@w.Id">@w.Name</option>
            }
        }
    </select>
</div>

@code {
    private List<Worker>? workers;

    protected override async Task OnInitializedAsync()
    {
        WorkerContext.OnChange += StateHasChanged;
        Store.OnChange += HandleStoreChange;
        await LoadWorkersAsync();
    }

    private async Task LoadWorkersAsync()
    {
        workers = (await Store.GetWorkersAsync()).ToList();
        await WorkerContext.InitializeAsync();
        await WorkerContext.EnsureWorkerExistsAsync(workers.Select(worker => worker.Id));
    }

    private async Task OnWorkerChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var id))
            await WorkerContext.SetWorkerAsync(id);
        else
            await WorkerContext.SetWorkerAsync(null);
    }

    private void HandleStoreChange()
    {
        _ = InvokeAsync(async () =>
        {
            try
            {
                await LoadWorkersAsync();
                StateHasChanged();
            }
            catch (Exception ex)
            {
                Console.Error.WriteLine($"Worker selector refresh failed: {ex.Message}");
            }
        });
    }

    public void Dispose()
    {
        WorkerContext.OnChange -= StateHasChanged;
        Store.OnChange -= HandleStoreChange;
    }
}

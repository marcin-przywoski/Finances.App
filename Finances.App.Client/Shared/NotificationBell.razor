@inject NotificationService Notifications

<div class="notification-bell-wrapper">
    <button class="notification-bell-btn" @onclick="ToggleDropdown" title="@L["notificationBellTitle"]">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9" />
            <path d="M13.73 21a2 2 0 0 1-3.46 0" />
        </svg>
        @if (Notifications.UnreadCount > 0)
        {
            <span class="notification-badge">@(Notifications.UnreadCount > 9 ? "9+" : Notifications.UnreadCount.ToString())</span>
        }
    </button>

    @if (isOpen)
    {
        <div class="notification-dropdown">
            <div class="notification-dropdown-header">
                <span>@L["notificationBellHeader"]</span>
                @if (Notifications.UnreadCount > 0)
                {
                    <button class="notification-dismiss-all" @onclick="DismissAll">@L["notificationBellClearAll"]</button>
                }
            </div>

            @if (Notifications.Notifications.Count == 0)
            {
                <div class="notification-empty">@L["notificationBellEmpty"]</div>
            }
            else
            {
                <div class="notification-list">
                    @foreach (var n in Notifications.Notifications)
                    {
                        <div class="notification-item notification-@n.Type.ToString().ToLowerInvariant()">
                            <div class="notification-item-icon">
                                @if (n.Type == NotificationType.Warning)
                                {
                                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z" /><line x1="12" y1="9" x2="12" y2="13" /><line x1="12" y1="17" x2="12.01" y2="17" /></svg>
                                }
                                else if (n.Type == NotificationType.Action)
                                {
                                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10" /><polyline points="12 6 12 12 16 14" /></svg>
                                }
                                else
                                {
                                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10" /><line x1="12" y1="16" x2="12" y2="12" /><line x1="12" y1="8" x2="12.01" y2="8" /></svg>
                                }
                            </div>
                            <div class="notification-item-content">
                                <div class="notification-item-title">@n.Title</div>
                                <div class="notification-item-message">@n.Message</div>
                            </div>
                            <button class="notification-item-dismiss" @onclick="() => Dismiss(n.Id)" title="@L["notificationDismiss"]">
                                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="6" x2="6" y2="18" /><line x1="6" y1="6" x2="18" y2="18" /></svg>
                            </button>
                        </div>
                    }
                </div>
            }
        </div>
    }
</div>

@code {
    private bool isOpen;

    protected override void OnInitialized()
    {
        Notifications.OnChange += HandleChange;
    }

    private void ToggleDropdown()
    {
        isOpen = !isOpen;
    }

    private void Dismiss(string id)
    {
        Notifications.Dismiss(id);
    }

    private void DismissAll()
    {
        Notifications.DismissAll();
        isOpen = false;
    }

    private void HandleChange()
    {
        InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        Notifications.OnChange -= HandleChange;
    }
}

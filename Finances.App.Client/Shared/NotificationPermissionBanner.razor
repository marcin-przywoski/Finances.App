@implements IDisposable
@inject BrowserNotificationService BrowserNotifications
@inject ToastService Toast

@if (showBanner)
{
    <div class="notification-permission-banner" role="status" aria-live="polite">
        <div class="notification-permission-icon" aria-hidden="true">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9" />
                <path d="M13.73 21a2 2 0 0 1-3.46 0" />
            </svg>
        </div>
        <div class="notification-permission-copy">
            <strong>@L["notificationPermissionTitle"]</strong>
            <span>@L["notificationPermissionDescription"]</span>
        </div>
        <div class="notification-permission-actions">
            <button type="button" class="btn btn-sm btn-primary" @onclick="RequestAsync" disabled="@requesting">
                @L["notificationPermissionEnable"]
            </button>
            <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="DismissAsync">
                @L["notificationPermissionDismiss"]
            </button>
        </div>
    </div>
}

@code {
    private bool showBanner;
    private bool requesting;

    protected override async Task OnInitializedAsync()
    {
        BrowserNotifications.OnChange += HandleChange;
        await EvaluateAsync();
    }

    private async Task EvaluateAsync()
    {
        var permission = await BrowserNotifications.GetPermissionAsync();
        if (permission is BrowserNotificationPermission.Granted
            or BrowserNotificationPermission.Denied
            or BrowserNotificationPermission.Unsupported)
        {
            showBanner = false;
            StateHasChanged();
            return;
        }

        showBanner = !await BrowserNotifications.IsPromptDismissedAsync();
        StateHasChanged();
    }

    private async Task RequestAsync()
    {
        requesting = true;
        try
        {
            var result = await BrowserNotifications.RequestPermissionAsync();
            switch (result)
            {
                case BrowserNotificationPermission.Granted:
                    Toast.Show(L["notificationPermissionGranted"]);
                    showBanner = false;
                    break;
                case BrowserNotificationPermission.Denied:
                    Toast.Show(L["notificationPermissionDenied"], ToastLevel.Error);
                    showBanner = false;
                    break;
                case BrowserNotificationPermission.Unsupported:
                    Toast.Show(L["notificationPermissionUnsupported"], ToastLevel.Error);
                    showBanner = false;
                    break;
                default:
                    Toast.Show(L["notificationPermissionRemindLater"]);
                    break;
            }
        }
        finally
        {
            requesting = false;
            StateHasChanged();
        }
    }

    private async Task DismissAsync()
    {
        await BrowserNotifications.DismissPromptAsync();
        showBanner = false;
        StateHasChanged();
    }

    private async void HandleChange()
    {
        await InvokeAsync(EvaluateAsync);
    }

    public void Dispose()
    {
        BrowserNotifications.OnChange -= HandleChange;
    }
}

@implements IDisposable
@inject PwaUpdateService PwaUpdate
@inject IStringLocalizer<AppStrings> L

@if (ShowInstallBanner || ShowUpdateBanner)
{
    <div class="pwa-banner-stack">
        @if (ShowInstallBanner)
        {
            <section class="pwa-banner pwa-banner-install" role="status" aria-live="polite">
                <div class="pwa-banner-copy">
                    <span class="pwa-banner-badge">PWA</span>
                    <div>
                        <h2>@L["Pwa_InstallTitle"]</h2>
                        <p>@L["Pwa_InstallBody"]</p>
                    </div>
                </div>
                <div class="pwa-banner-actions">
                    <button type="button" class="btn btn-primary" @onclick="PromptInstallAsync">@L["Pwa_InstallButton"]</button>
                    <button type="button" class="btn btn-outline-secondary" @onclick="DismissInstall">@L["Pwa_Later"]</button>
                </div>
            </section>
        }

        @if (ShowUpdateBanner)
        {
            <section class="pwa-banner pwa-banner-update" role="status" aria-live="polite">
                <div class="pwa-banner-copy">
                    <span class="pwa-banner-badge">@L["Pwa_UpdateBadge"]</span>
                    <div>
                        <h2>@L["Pwa_UpdateTitle"]</h2>
                        <p>@GetUpdateMessage()</p>

                        @if (!string.IsNullOrWhiteSpace(PwaUpdate.State.AvailableRelease?.Title))
                        {
                            <small class="d-block opacity-75">@PwaUpdate.State.AvailableRelease!.Title</small>
                        }
                    </div>
                </div>
                <div class="pwa-banner-actions">
                    <button type="button" class="btn btn-primary" @onclick="ApplyUpdateAsync">@L["Pwa_ReloadNow"]</button>
                    <button type="button" class="btn btn-outline-secondary" @onclick="DismissUpdate">@L["Pwa_Later"]</button>
                </div>
            </section>
        }
    </div>
}

@code {
    private bool installAvailable;
    private bool installDismissed;
    private bool isStandalone;
    private bool updateAvailable;
    private bool updateDismissed;

    private bool ShowInstallBanner => installAvailable && !installDismissed && !isStandalone;
    private bool ShowUpdateBanner => updateAvailable && !updateDismissed;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        await PwaUpdate.EnsureInitializedAsync();
        ApplyState();
    }

    private void ApplyState()
    {
        var state = PwaUpdate.State;

        if (state.InstallAvailable && !installAvailable)
        {
            installDismissed = false;
        }

        if (state.UpdateAvailable && !updateAvailable)
        {
            updateDismissed = false;
        }

        installAvailable = state.InstallAvailable;
        updateAvailable = state.UpdateAvailable;
        isStandalone = state.IsStandalone;
    }

    private async Task PromptInstallAsync()
    {
        await PwaUpdate.PromptInstallAsync();
    }

    private async Task ApplyUpdateAsync()
    {
        await PwaUpdate.ApplyUpdateAsync();
    }

    private void DismissInstall()
    {
        installDismissed = true;
    }

    private void DismissUpdate()
    {
        updateDismissed = true;
    }

    private string GetUpdateMessage()
    {
        return string.IsNullOrWhiteSpace(PwaUpdate.State.AvailableVersion)
            ? L["Pwa_UpdateBodyGeneric"].Value
            : L["Pwa_UpdateBodyVersion", PwaUpdate.State.AvailableVersion!].Value;
    }

    private void HandlePwaStateChanged()
    {
        ApplyState();
        _ = InvokeAsync(StateHasChanged);
    }

    protected override void OnInitialized()
    {
        PwaUpdate.OnChange += HandlePwaStateChanged;
    }

    public void Dispose()
    {
        PwaUpdate.OnChange -= HandlePwaStateChanged;
    }
}
@inject IStringLocalizer<AppStrings> L

<div class="stat-card">
    <div class="d-flex justify-content-between align-items-start mb-2">
        <div class="stat-icon stat-icon-@Variant.ToString().ToLowerInvariant()">
            @IconContent
        </div>
        @if (TrendPercent.HasValue)
        {
            var isUp = TrendPercent.Value >= 0;
            var trendClass = isUp ? "trend-up" : "trend-down";
            <div class="stat-trend @trendClass">
                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
                    @if (isUp)
                    {
                        <polyline points="23 6 13.5 15.5 8.5 10.5 1 18"/>
                        <polyline points="17 6 23 6 23 12"/>
                    }
                    else
                    {
                        <polyline points="23 18 13.5 8.5 8.5 13.5 1 6"/>
                        <polyline points="17 18 23 18 23 12"/>
                    }
                </svg>
                <span><span class="visually-hidden-text">@(isUp ? L["Trend_Up"] : L["Trend_Down"]) </span>@(Math.Abs(TrendPercent.Value).ToString("F1"))%</span>
            </div>
        }
    </div>
    <div class="stat-value">@Value</div>
    <div class="stat-label">@Label</div>
    @if (!string.IsNullOrEmpty(Subtitle))
    {
        <div class="stat-subtitle">@Subtitle</div>
    }
</div>

@code {
    [Parameter] public string Value { get; set; } = "0";
    [Parameter] public string Label { get; set; } = "";
    [Parameter] public RenderFragment? IconContent { get; set; }
    [Parameter] public StatCardVariant Variant { get; set; } = StatCardVariant.Primary;
    [Parameter] public decimal? TrendPercent { get; set; }
    [Parameter] public string? Subtitle { get; set; }
}

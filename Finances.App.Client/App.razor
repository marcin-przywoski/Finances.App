@implements IDisposable

<Router AppAssembly="typeof(Program).Assembly">
    <Found Context="routeData">
        <RouteView RouteData="routeData" DefaultLayout="typeof(MainLayout)" @key="L.CurrentLocale" />
        <FocusOnNavigate RouteData="routeData" Selector="h1" />
    </Found>
    <NotFound>
        <LayoutView Layout="typeof(MainLayout)" @key="L.CurrentLocale">
            <div class="card p-4" style="max-width: 640px;">
                <h2 class="mb-2" style="font-weight: 700;">Page not found</h2>
                <p class="text-muted mb-0">The page you requested does not exist in this standalone build.</p>
            </div>
        </LayoutView>
    </NotFound>
</Router>

@code {
    protected override void OnInitialized()
    {
        L.OnChange += HandleLocaleChanged;
    }

    private void HandleLocaleChanged()
    {
        InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        L.OnChange -= HandleLocaleChanged;
    }
}
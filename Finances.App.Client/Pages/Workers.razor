@page "/workers"
@implements IDisposable
@inject IFinanceService Finance
@inject ToastService Toast
@inject WorkerContextService WorkerContext
@inject NavigationManager Nav

<PageTitle>Workers</PageTitle>

<div class="workspace-page">
    <section class="workspace-hero workspace-hero--team">
        <div class="workspace-hero-copy">
            <span class="workspace-kicker">Team setup</span>
            <h1 class="workspace-title">Workers</h1>
            <p class="workspace-description">Manage your team roster and default commission settings so service records and analytics reflect the right people and payout splits.</p>
        </div>
        <div class="workspace-hero-actions">
            <div class="workspace-action-row">
                <button class="btn btn-primary" @onclick="OpenAddModal">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="me-1"><path d="M12 5v14M5 12h14" /></svg>
                    Add worker
                </button>
            </div>
        </div>
    </section>

    @if (workers == null)
    {
        <LoadingSpinner />
    }
    else
    {
        <div class="workspace-summary-grid">
            <div class="workspace-summary-card">
                <span class="workspace-summary-label">Team members</span>
                <strong>@workers.Count</strong>
                <p>Workers available to assign in records and dashboards.</p>
            </div>
            <div class="workspace-summary-card">
                <span class="workspace-summary-label">Average commission</span>
                <strong>@(workers.Count > 0 ? workers.Average(w => w.DefaultCommissionPercentage).ToString("0.##") : "0")%</strong>
                <p>Typical default payout percentage across the team.</p>
            </div>
            <div class="workspace-summary-card">
                <span class="workspace-summary-label">Highest commission</span>
                <strong>@(workers.Count > 0 ? workers.Max(w => w.DefaultCommissionPercentage).ToString("0.##") : "0")%</strong>
                <p>Top commission rate currently configured.</p>
            </div>
            <div class="workspace-summary-card">
                <span class="workspace-summary-label">Linked users</span>
                <strong>@workers.Count(w => !string.IsNullOrWhiteSpace(w.ApplicationUserId))</strong>
                <p>Team members already tied to an app user identity.</p>
            </div>
        </div>

        @if (workers.Count == 0)
        {
            <div class="workspace-empty-state">
                <p>No workers yet. Add the first team member to start assigning services.</p>
            </div>
        }
        else
        {
            <section class="workspace-panel">
                <div class="workspace-panel-header workspace-panel-header-split">
                    <div>
                        <p class="workspace-panel-eyebrow">Roster</p>
                        <h2>Team member list</h2>
                        <p>Update names, payout defaults, and linked accounts for each stylist or staff member.</p>
                    </div>
                    <span class="workspace-badge">@workers.Count worker@(workers.Count == 1 ? "" : "s")</span>
                </div>
                <div class="table-responsive">
                    <table class="data-table workspace-table">
                        <thead>
                            <tr>
                                <th>Name</th>
                                <th>Commission %</th>
                                <th>Linked User</th>
                                <th class="workspace-table-actions">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var worker in workers)
                            {
                                <tr>
                                    <td class="fw-semibold">@worker.Name</td>
                                    <td>@worker.DefaultCommissionPercentage%</td>
                                    <td class="text-muted">@(worker.ApplicationUserId ?? "—")</td>
                                    <td class="workspace-table-actions">
                                        <button class="btn btn-sm btn-outline-primary me-1" @onclick="() => OpenAnalytics(worker)">Analytics</button>
                                        <button class="btn btn-sm btn-outline-secondary me-1" @onclick="() => OpenEditModal(worker)">Edit</button>
                                        <button class="btn btn-sm btn-outline-danger" @onclick="() => ConfirmDelete(worker)">Delete</button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </section>
        }
    }
</div>

@if (showModal)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.4);">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">@(isEditing ? "Edit Worker" : "Add Worker")</h5>
                    <button type="button" class="btn-close" @onclick="CloseModal"></button>
                </div>
                <EditForm Model="@formModel" OnValidSubmit="HandleSubmit">
                    <DataAnnotationsValidator />
                    <div class="modal-body">
                        <div class="mb-3">
                            <label class="form-label">Name</label>
                            <InputText class="form-control" @bind-Value="formModel.Name" />
                            <ValidationMessage For="() => formModel.Name" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Default Commission (%)</label>
                            <InputNumber class="form-control" @bind-Value="formModel.DefaultCommissionPercentage" />
                            <ValidationMessage For="() => formModel.DefaultCommissionPercentage" />
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" @onclick="CloseModal">Cancel</button>
                        <button type="submit" class="btn btn-primary" disabled="@saving">
                            @(saving ? "Saving..." : (isEditing ? "Update" : "Add"))
                        </button>
                    </div>
                </EditForm>
            </div>
        </div>
    </div>
}

<ConfirmDialog IsVisible="showDeleteConfirm"
               Title="Delete Worker"
               Message="@($"Are you sure you want to delete {deleteTarget?.Name}? This cannot be undone.")"
               ConfirmText="Delete"
               OnConfirm="HandleDelete"
               OnCancel="() => { showDeleteConfirm = false; }" />

@code {
    private List<Worker>? workers;
    private Worker formModel = new();
    private Worker? deleteTarget;
    private bool showModal, isEditing, saving, showDeleteConfirm;
    private int editId;

    protected override async Task OnInitializedAsync()
    {
        Finance.OnChange += HandleStoreChanged;
        await LoadWorkers();
    }

    private async Task LoadWorkers()
    {
        workers = (await Finance.GetWorkersAsync()).ToList();
    }

    private void OpenAddModal()
    {
        formModel = new Worker();
        isEditing = false;
        showModal = true;
    }

    private void OpenEditModal(Worker w)
    {
        formModel = new Worker { Id = w.Id, Name = w.Name, DefaultCommissionPercentage = w.DefaultCommissionPercentage, ApplicationUserId = w.ApplicationUserId };
        editId = w.Id;
        isEditing = true;
        showModal = true;
    }

    private void CloseModal() => showModal = false;

    private async Task HandleSubmit()
    {
        saving = true;
        try
        {
            if (isEditing)
            {
                await Finance.UpdateWorkerAsync(editId, formModel);
                Toast.Show("Worker updated");
            }
            else
            {
                await Finance.AddWorkerAsync(formModel);
                Toast.Show("Worker added");
            }
            await LoadWorkers();
            showModal = false;
        }
        catch (Exception ex)
        {
            Toast.Show(ex is InvalidDataException ? ex.Message : "Failed to save worker", ToastLevel.Error);
        }
        finally { saving = false; }
    }

    private void ConfirmDelete(Worker w)
    {
        deleteTarget = w;
        showDeleteConfirm = true;
    }

    private async Task OpenAnalytics(Worker worker)
    {
        await WorkerContext.SetWorkerAsync(worker.Id);
        Nav.NavigateTo("analytics");
    }

    private async Task HandleDelete()
    {
        if (deleteTarget == null) return;
        var result = await Finance.DeleteWorkerAsync(deleteTarget.Id);
        if (result.Success) Toast.Show("Worker deleted");
        else Toast.Show(result.ErrorMessage ?? "Failed to delete worker. It may have related records.", ToastLevel.Error);
        showDeleteConfirm = false;
        deleteTarget = null;
        await LoadWorkers();
    }

    private async void HandleStoreChanged()
    {
        await InvokeAsync(async () =>
        {
            await LoadWorkers();
            StateHasChanged();
        });
    }

    public void Dispose()
    {
        Finance.OnChange -= HandleStoreChanged;
    }
}

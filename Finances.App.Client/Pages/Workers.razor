@page "/workers"
@inherits CrudPageBase<Worker>
@inject IFinanceStore Store

<PageTitle>Workers</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="page-title mb-1">Workers</h1>
        <p class="text-muted mb-0">Manage your team members and their commission rates.</p>
    </div>
    <button class="btn btn-primary" @onclick="OpenAddModal">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="me-1" aria-hidden="true"><path d="M12 5v14M5 12h14"/></svg>
        Add Worker
    </button>
</div>

@if (items == null)
{
    <LoadingSpinner />
}
else if (items.Count == 0)
{
    <div class="card p-5 text-center">
        <p class="text-muted mb-3">No workers yet. Add your first team member to get started.</p>
        <div><button class="btn btn-primary" @onclick="OpenAddModal">Add Worker</button></div>
    </div>
}
else
{
    <div class="card">
        <div class="table-responsive">
            <table class="table table-hover mb-0">
                <thead>
                    <tr>
                        <th>Name</th>
                        <th>Commission %</th>
                        <th style="width: 140px;">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var worker in items)
                    {
                        <tr>
                            <td class="fw-semibold">@worker.Name</td>
                            <td>@worker.DefaultCommissionPercentage%</td>
                            <td>
                                <button class="btn btn-sm btn-outline-secondary me-1" @onclick="() => OpenEditModal(worker)">Edit</button>
                                <button class="btn btn-sm btn-outline-danger" @onclick="() => ConfirmDelete(worker)">Delete</button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}

<ModalDialog IsVisible="showModal" Title="@(isEditing ? "Edit Worker" : "Add Worker")" OnClose="CloseModal">
    <EditForm Model="@formModel" OnValidSubmit="HandleSubmit">
        <DataAnnotationsValidator />
        <div class="modal-body">
            <div class="mb-3">
                <label class="form-label" for="worker-name">Name</label>
                <InputText id="worker-name" class="form-control" @bind-Value="formModel.Name" />
                <ValidationMessage For="() => formModel.Name" />
            </div>
            <div class="mb-3">
                <label class="form-label" for="worker-commission">Default Commission (%)</label>
                <InputNumber id="worker-commission" class="form-control" @bind-Value="formModel.DefaultCommissionPercentage" />
                <ValidationMessage For="() => formModel.DefaultCommissionPercentage" />
            </div>
        </div>
        <div class="modal-footer">
            <button type="button" class="btn btn-secondary" @onclick="CloseModal">Cancel</button>
            <button type="submit" class="btn btn-primary" disabled="@saving">
                @(saving ? "Saving..." : (isEditing ? "Update" : "Add"))
            </button>
        </div>
    </EditForm>
</ModalDialog>

<ConfirmDialog IsVisible="showDeleteConfirm"
               Title="Delete Worker"
               Message="@($"Delete {deleteTarget?.Name}? You can undo right after deleting.")"
               ConfirmText="Delete"
               OnConfirm="HandleDelete"
               OnCancel="() => { showDeleteConfirm = false; }" />

@code {
    protected override string EntityName => "Worker";

    protected override async Task<IReadOnlyList<Worker>> LoadItemsAsync() => await Store.GetWorkersAsync();

    protected override Task AddItemAsync(Worker item) => Store.AddWorkerAsync(item);

    protected override Task UpdateItemAsync(int id, Worker item) => Store.UpdateWorkerAsync(id, item);

    protected override Task<DeleteResult> DeleteItemAsync(Worker item) => Store.DeleteWorkerAsync(item.Id);

    protected override int GetId(Worker item) => item.Id;

    protected override Worker CloneItem(Worker item) => new()
    {
        Id = item.Id,
        Name = item.Name,
        DefaultCommissionPercentage = item.DefaultCommissionPercentage
    };
}

@page "/workers"
@inherits CrudPageBase<Worker>
@inject IFinanceStore Store

<PageTitle>@L["Workers_Title"]</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="page-title mb-1">@L["Workers_Title"]</h1>
        <p class="text-muted mb-0">@L["Workers_Subtitle"]</p>
    </div>
    <button class="btn btn-primary" @onclick="OpenAddModal">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="me-1" aria-hidden="true"><path d="M12 5v14M5 12h14"/></svg>
        @L["Workers_Add"]
    </button>
</div>

@if (items == null)
{
    <LoadingSpinner />
}
else if (items.Count == 0)
{
    <div class="card p-5 text-center">
        <p class="text-muted mb-3">@L["Workers_Empty"]</p>
        <div><button class="btn btn-primary" @onclick="OpenAddModal">@L["Workers_Add"]</button></div>
    </div>
}
else
{
    <div class="card">
        <div class="table-responsive">
            <table class="table table-hover mb-0">
                <thead>
                    <tr>
                        <th>@L["Workers_Name"]</th>
                        <th>@L["Common_Commission"]</th>
                        <th style="width: 140px;">@L["Common_Actions"]</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var worker in items)
                    {
                        <tr>
                            <td class="fw-semibold">@worker.Name</td>
                            <td>@worker.DefaultCommissionPercentage%</td>
                            <td>
                                <button class="btn btn-sm btn-outline-secondary me-1" @onclick="() => OpenEditModal(worker)">@L["Common_Edit"]</button>
                                <button class="btn btn-sm btn-outline-danger" @onclick="() => ConfirmDelete(worker)">@L["Common_Delete"]</button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}

<ModalDialog IsVisible="showModal" Title="@(isEditing ? L["Workers_EditTitle"] : L["Workers_Add"])" OnClose="CloseModal">
    <EditForm Model="@formModel" OnValidSubmit="HandleSubmit">
        <DataAnnotationsValidator />
        <div class="modal-body">
            <div class="mb-3">
                <label class="form-label" for="worker-name">@L["Workers_Name"]</label>
                <InputText id="worker-name" class="form-control" @bind-Value="formModel.Name" />
                <ValidationMessage For="() => formModel.Name" />
            </div>
            <div class="mb-3">
                <label class="form-label" for="worker-commission">@L["Workers_DefaultCommission"]</label>
                <InputNumber id="worker-commission" class="form-control" @bind-Value="formModel.DefaultCommissionPercentage" />
                <ValidationMessage For="() => formModel.DefaultCommissionPercentage" />
            </div>
        </div>
        <div class="modal-footer">
            <button type="button" class="btn btn-secondary" @onclick="CloseModal">@L["Common_Cancel"]</button>
            <button type="submit" class="btn btn-primary" disabled="@saving">
                @(saving ? L["Common_Saving"] : (isEditing ? L["Common_Update"] : L["Common_Add"]))
            </button>
        </div>
    </EditForm>
</ModalDialog>

<ConfirmDialog IsVisible="showDeleteConfirm"
               Title="@L["Workers_DeleteTitle"]"
               Message="@L["Crud_DeleteMessage", deleteTarget?.Name ?? ""]"
               ConfirmText="@L["Common_Delete"]"
               OnConfirm="HandleDelete"
               OnCancel="() => { showDeleteConfirm = false; }" />

@code {
    protected override string ToastAdded => L["Workers_Added"];
    protected override string ToastUpdated => L["Workers_Updated"];
    protected override string ToastDeleted => L["Workers_Deleted"];

    protected override async Task<IReadOnlyList<Worker>> LoadItemsAsync() => await Store.GetWorkersAsync();

    protected override Task AddItemAsync(Worker item) => Store.AddWorkerAsync(item);

    protected override Task UpdateItemAsync(int id, Worker item) => Store.UpdateWorkerAsync(id, item);

    protected override Task<DeleteResult> DeleteItemAsync(Worker item) => Store.DeleteWorkerAsync(item.Id);

    protected override int GetId(Worker item) => item.Id;

    protected override Worker CloneItem(Worker item) => new()
    {
        Id = item.Id,
        Name = item.Name,
        DefaultCommissionPercentage = item.DefaultCommissionPercentage
    };
}

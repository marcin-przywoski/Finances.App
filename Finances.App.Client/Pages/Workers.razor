@page "/workers"
@implements IDisposable
@inject IFinanceService Finance
@inject ToastService Toast
@inject WorkerContextService WorkerContext
@inject NavigationManager Nav

<PageTitle>@L["workersPageTitle"]</PageTitle>

<div class="workspace-page">
    <section class="workspace-hero workspace-hero--team">
        <div class="workspace-hero-copy">
            <span class="workspace-kicker">@L["workersKicker"]</span>
            <h1 class="workspace-title">@L["workersTitle"]</h1>
            <p class="workspace-description">@L["workersDescription"]</p>
        </div>
        <div class="workspace-hero-actions">
            <div class="workspace-action-row">
                <button class="btn btn-primary" @onclick="OpenAddModal">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="me-1"><path d="M12 5v14M5 12h14" /></svg>
                    @L["workersAddButton"]
                </button>
            </div>
        </div>
    </section>

    @if (workers == null)
    {
        <LoadingSpinner />
    }
    else
    {
        <div class="workspace-summary-grid">
            <div class="workspace-summary-card">
                <span class="workspace-summary-label">@L["workersSummaryTeam"]</span>
                <strong>@workers.Count</strong>
                <p>@L["workersSummaryTeamDesc"]</p>
            </div>
            <div class="workspace-summary-card">
                <span class="workspace-summary-label">@L["workersSummaryAvgComm"]</span>
                <strong>@(workers.Count > 0 ? workers.Average(w => w.DefaultCommissionPercentage).ToString("0.##") : "0")%</strong>
                <p>@L["workersSummaryAvgCommDesc"]</p>
            </div>
            <div class="workspace-summary-card">
                <span class="workspace-summary-label">@L["workersSummaryHighestComm"]</span>
                <strong>@(workers.Count > 0 ? workers.Max(w => w.DefaultCommissionPercentage).ToString("0.##") : "0")%</strong>
                <p>@L["workersSummaryHighestCommDesc"]</p>
            </div>
            <div class="workspace-summary-card">
                <span class="workspace-summary-label">@L["workersSummaryLinked"]</span>
                <strong>@workers.Count(w => !string.IsNullOrWhiteSpace(w.ApplicationUserId))</strong>
                <p>@L["workersSummaryLinkedDesc"]</p>
            </div>
        </div>

        @if (workers.Count == 0)
        {
            <div class="workspace-empty-state">
                <p>@L["workersEmpty"]</p>
            </div>
        }
        else
        {
            <section class="workspace-panel">
                <div class="workspace-panel-header workspace-panel-header-split">
                    <div>
                        <p class="workspace-panel-eyebrow">@L["workersPanelEyebrow"]</p>
                        <h2>@L["workersPanelTitle"]</h2>
                        <p>@L["workersPanelDesc"]</p>
                    </div>
                    <span class="workspace-badge">@workers.Count worker@(workers.Count == 1 ? "" : "s")</span>
                </div>
                <div class="table-responsive">
                    <table class="data-table workspace-table">
                        <thead>
                            <tr>
                                <th>@L["workersThName"]</th>
                                <th>@L["workersThCommission"]</th>
                                <th>@L["workersThLinkedUser"]</th>
                                <th class="workspace-table-actions">@L["workersThActions"]</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var worker in workers)
                            {
                                <tr>
                                    <td class="fw-semibold">@worker.Name</td>
                                    <td>@worker.DefaultCommissionPercentage%</td>
                                    <td class="text-muted">@(worker.ApplicationUserId ?? "—")</td>
                                    <td class="workspace-table-actions">
                                        <button class="btn btn-sm btn-outline-primary me-1" @onclick="() => OpenAnalytics(worker)">@L["workersAnalyticsButton"]</button>
                                        <button class="btn btn-sm btn-outline-secondary me-1" @onclick="() => OpenEditModal(worker)">@L["commonEdit"]</button>
                                        <button class="btn btn-sm btn-outline-danger" @onclick="() => ConfirmDelete(worker)">@L["commonDelete"]</button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </section>
        }
    }
</div>

@if (showModal)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.4);">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">@(isEditing ? L["workersModalTitleEdit"] : L["workersModalTitleAdd"])</h5>
                    <button type="button" class="btn-close" @onclick="CloseModal"></button>
                </div>
                <EditForm Model="@formModel" OnValidSubmit="HandleSubmit">
                    <DataAnnotationsValidator />
                    <div class="modal-body">
                        <div class="mb-3">
                            <label class="form-label">@L["workersModalLabelName"]</label>
                            <InputText class="form-control" @bind-Value="formModel.Name" />
                            <ValidationMessage For="() => formModel.Name" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label">@L["workersModalLabelCommission"]</label>
                            <InputNumber class="form-control" @bind-Value="formModel.DefaultCommissionPercentage" />
                            <ValidationMessage For="() => formModel.DefaultCommissionPercentage" />
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" @onclick="CloseModal">@L["workersModalCancel"]</button>
                        <button type="submit" class="btn btn-primary" disabled="@saving">
                            @(saving ? L["workersModalSaving"] : (isEditing ? L["workersModalUpdate"] : L["workersModalAdd"]))
                        </button>
                    </div>
                </EditForm>
            </div>
        </div>
    </div>
}

<ConfirmDialog IsVisible="showDeleteConfirm"
               Title="@L["workersDeleteTitle"]"
               Message="@(L.T("workersDeleteMsg", deleteTarget?.Name ?? ""))"
               ConfirmText="@L["workersDeleteConfirm"]"
               OnConfirm="HandleDelete"
               OnCancel="() => { showDeleteConfirm = false; }" />

@code {
    private List<Worker>? workers;
    private Worker formModel = new();
    private Worker? deleteTarget;
    private bool showModal, isEditing, saving, showDeleteConfirm;
    private int editId;

    protected override async Task OnInitializedAsync()
    {
        Finance.OnChange += HandleStoreChanged;
        await LoadWorkers();
    }

    private async Task LoadWorkers()
    {
        workers = (await Finance.GetWorkersAsync()).ToList();
    }

    private void OpenAddModal()
    {
        formModel = new Worker();
        isEditing = false;
        showModal = true;
    }

    private void OpenEditModal(Worker w)
    {
        formModel = new Worker { Id = w.Id, Name = w.Name, DefaultCommissionPercentage = w.DefaultCommissionPercentage, ApplicationUserId = w.ApplicationUserId };
        editId = w.Id;
        isEditing = true;
        showModal = true;
    }

    private void CloseModal() => showModal = false;

    private async Task HandleSubmit()
    {
        saving = true;
        try
        {
            if (isEditing)
            {
                await Finance.UpdateWorkerAsync(editId, formModel);
                Toast.Show(L["workersToastUpdated"]);
            }
            else
            {
                await Finance.AddWorkerAsync(formModel);
                Toast.Show(L["workersToastAdded"]);
            }
            await LoadWorkers();
            showModal = false;
        }
        catch (Exception ex)
        {
            Toast.Show(ex is InvalidDataException ? ex.Message : L["workersToastFailed"], ToastLevel.Error);
        }
        finally { saving = false; }
    }

    private void ConfirmDelete(Worker w)
    {
        deleteTarget = w;
        showDeleteConfirm = true;
    }

    private async Task OpenAnalytics(Worker worker)
    {
        await WorkerContext.SetWorkerAsync(worker.Id);
        Nav.NavigateTo("analytics");
    }

    private async Task HandleDelete()
    {
        if (deleteTarget == null) return;
        var result = await Finance.DeleteWorkerAsync(deleteTarget.Id);
        if (result.Success) Toast.Show(L["workersToastDeleted"]);
        else Toast.Show(result.ErrorMessage ?? L["workersToastDeleteFailed"], ToastLevel.Error);
        showDeleteConfirm = false;
        deleteTarget = null;
        await LoadWorkers();
    }

    private async void HandleStoreChanged()
    {
        await InvokeAsync(async () =>
        {
            await LoadWorkers();
            StateHasChanged();
        });
    }

    public void Dispose()
    {
        Finance.OnChange -= HandleStoreChanged;
    }
}

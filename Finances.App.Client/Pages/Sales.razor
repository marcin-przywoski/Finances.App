@page "/sales"
@inject HttpClient Http
@inject ToastService Toast

<PageTitle>Product Sales</PageTitle>

<div class="workspace-page">
    <section class="workspace-hero workspace-hero--history">
        <div class="workspace-hero-copy">
            <span class="workspace-kicker">Retail ledger</span>
            <h1 class="workspace-title">Product sales</h1>
            <p class="workspace-description">Track retail sales, review basket values, and fix incorrect checkout entries for the selected period.</p>
        </div>
        <div class="workspace-hero-actions">
            <div class="workspace-action-row">
                <button class="btn btn-primary" @onclick="OpenAddModal">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="me-1"><path d="M12 5v14M5 12h14" /></svg>
                    Record sale
                </button>
            </div>
            <div class="workspace-filter-panel">
                <span>Date range</span>
                <DateRangeFilter From="@dateFrom" To="@dateTo" OnRangeChanged="OnDateRangeChanged" />
            </div>
        </div>
    </section>

    @if (allSales == null)
    {
        <LoadingSpinner />
    }
    else
    {
        var filtered = GetFilteredSales();

        <div class="workspace-summary-grid">
            <div class="workspace-summary-card">
                <span class="workspace-summary-label">Sales</span>
                <strong>@filtered.Count</strong>
                <p>Retail transactions in the selected period.</p>
            </div>
            <div class="workspace-summary-card">
                <span class="workspace-summary-label">Units sold</span>
                <strong>@filtered.Sum(s => s.Quantity)</strong>
                <p>Total product units checked out.</p>
            </div>
            <div class="workspace-summary-card">
                <span class="workspace-summary-label">Retail revenue</span>
                <strong>@filtered.Sum(s => s.TotalPrice).ToString("C")</strong>
                <p>Gross retail takings for this range.</p>
            </div>
            <div class="workspace-summary-card">
                <span class="workspace-summary-label">Average basket</span>
                <strong>@(filtered.Count > 0 ? (filtered.Sum(s => s.TotalPrice) / filtered.Count).ToString("C") : "$0.00")</strong>
                <p>Average value per recorded sale.</p>
            </div>
        </div>

        @if (filtered.Count == 0)
        {
            <div class="workspace-empty-state">
                <p>No product sales were found for the selected period.</p>
            </div>
        }
        else
        {
            <section class="workspace-panel">
                <div class="workspace-panel-header workspace-panel-header-split">
                    <div>
                        <p class="workspace-panel-eyebrow">Transactions</p>
                        <h2>Recorded retail sales</h2>
                        <p>Review product, client, and basket details for every checkout entry.</p>
                    </div>
                    <span class="workspace-badge">@filtered.Count sale@(filtered.Count == 1 ? "" : "s")</span>
                </div>
                <div class="table-responsive">
                    <table class="data-table workspace-table">
                        <thead>
                            <tr>
                                <th @onclick='() => SetSort("date")' style="cursor:pointer;">
                                    Date @SortIcon("date")
                                </th>
                                <th>Product</th>
                                <th>Worker</th>
                                <th>Client</th>
                                <th>Qty</th>
                                <th @onclick='() => SetSort("price")' style="cursor:pointer;">
                                    Unit Price @SortIcon("price")
                                </th>
                                <th @onclick='() => SetSort("total")' style="cursor:pointer;">
                                    Total @SortIcon("total")
                                </th>
                                <th>Notes</th>
                                <th class="workspace-table-actions">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var s in filtered)
                            {
                                <tr>
                                    <td>@s.DateSold.ToString("yyyy-MM-dd")</td>
                                    <td class="fw-semibold">@(s.Product?.Name ?? "—")</td>
                                    <td>@(s.Worker?.Name ?? "—")</td>
                                    <td class="text-muted">@(s.ClientName ?? "—")</td>
                                    <td>@s.Quantity</td>
                                    <td>@s.UnitPrice.ToString("C")</td>
                                    <td class="fw-semibold">@s.TotalPrice.ToString("C")</td>
                                    <td class="text-muted" style="max-width: 150px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">@(s.Notes ?? "")</td>
                                    <td class="workspace-table-actions">
                                        <button class="btn btn-sm btn-outline-secondary me-1" @onclick="() => OpenEditModal(s)">Edit</button>
                                        <button class="btn btn-sm btn-outline-danger" @onclick="() => ConfirmDelete(s)">Delete</button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                        <tfoot>
                            <tr>
                                <td colspan="4">Totals</td>
                                <td>@filtered.Sum(s => s.Quantity)</td>
                                <td></td>
                                <td>@filtered.Sum(s => s.TotalPrice).ToString("C")</td>
                                <td colspan="2"></td>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            </section>
        }
    }
</div>

@if (showModal)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.4);">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">@(isEditing ? "Edit Sale" : "Record Product Sale")</h5>
                    <button type="button" class="btn-close" @onclick="CloseModal"></button>
                </div>
                <EditForm Model="@formModel" OnValidSubmit="HandleSubmit">
                    <DataAnnotationsValidator />
                    <div class="modal-body">
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label class="form-label">Product</label>
                                <select class="form-select" value="@formModel.ProductId" @onchange="OnProductChanged">
                                    <option value="0">-- Select Product --</option>
                                    @if (products != null)
                                    {
                                        @foreach (var p in products)
                                        {
                                            <option value="@p.Id">@p.Name (@p.Price.ToString("C"))</option>
                                        }
                                    }
                                </select>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">Worker (optional)</label>
                                <select class="form-select" value="@(formModel.WorkerId ?? 0)" @onchange="OnWorkerChanged">
                                    <option value="0">— None —</option>
                                    @if (workers != null)
                                    {
                                        @foreach (var w in workers)
                                        {
                                            <option value="@w.Id">@w.Name</option>
                                        }
                                    }
                                </select>
                            </div>
                            <div class="col-md-4">
                                <label class="form-label">Date</label>
                                <InputDate class="form-control" @bind-Value="formModel.DateSold" />
                            </div>
                            <div class="col-md-4">
                                <label class="form-label">Quantity</label>
                                <InputNumber class="form-control" @bind-Value="formModel.Quantity" />
                                <ValidationMessage For="() => formModel.Quantity" />
                            </div>
                            <div class="col-md-4">
                                <label class="form-label">Unit Price</label>
                                <InputNumber class="form-control" @bind-Value="formModel.UnitPrice" />
                                <ValidationMessage For="() => formModel.UnitPrice" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">Client Name</label>
                                <InputText class="form-control" @bind-Value="formModel.ClientName" placeholder="Optional" />
                            </div>
                            <div class="col-12">
                                <label class="form-label">Notes</label>
                                <InputTextArea class="form-control" @bind-Value="formModel.Notes" rows="2" />
                            </div>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <div class="me-auto">
                            @if (formModel.Quantity > 0 && formModel.UnitPrice > 0)
                            {
                                <span class="text-muted" style="font-size: 0.875rem;">
                                    Total: <strong>@((formModel.UnitPrice * formModel.Quantity).ToString("C"))</strong>
                                </span>
                            }
                        </div>
                        <button type="button" class="btn btn-secondary" @onclick="CloseModal">Cancel</button>
                        <button type="submit" class="btn btn-primary" disabled="@saving">
                            @(saving ? "Saving..." : (isEditing ? "Update" : "Save"))
                        </button>
                    </div>
                </EditForm>
            </div>
        </div>
    </div>
}

<ConfirmDialog IsVisible="showDeleteConfirm"
               Title="Delete Sale"
               Message="@($"Are you sure you want to delete this product sale from {deleteTarget?.DateSold.ToString("yyyy-MM-dd")}? This cannot be undone.")"
               ConfirmText="Delete"
               OnConfirm="HandleDelete"
               OnCancel="() => { showDeleteConfirm = false; }" />

<Toast />

@code {
    private List<ProductSale>? allSales;
    private List<Product>? products;
    private List<Worker>? workers;
    private DateTime? dateFrom;
    private DateTime? dateTo;
    private string sortColumn = "date";
    private bool sortAsc = false;

    private ProductSale formModel = new();
    private bool showModal, isEditing, saving;
    private int editId;

    private ProductSale? deleteTarget;
    private bool showDeleteConfirm;

    protected override async Task OnInitializedAsync()
    {
        allSales = await Http.GetFromJsonAsync<List<ProductSale>>("api/productsales");
        products = await Http.GetFromJsonAsync<List<Product>>("api/products");
        workers = await Http.GetFromJsonAsync<List<Worker>>("api/workers");
    }

    private void OnDateRangeChanged((DateTime? From, DateTime? To) range)
    {
        dateFrom = range.From;
        dateTo = range.To;
    }

    private List<ProductSale> GetFilteredSales()
    {
        if (allSales == null) return new();

        var q = allSales.AsEnumerable();

        if (dateFrom.HasValue)
            q = q.Where(s => s.DateSold.Date >= dateFrom.Value.Date);

        if (dateTo.HasValue)
            q = q.Where(s => s.DateSold.Date <= dateTo.Value.Date);

        q = sortColumn switch
        {
            "date" => sortAsc ? q.OrderBy(s => s.DateSold) : q.OrderByDescending(s => s.DateSold),
            "price" => sortAsc ? q.OrderBy(s => s.UnitPrice) : q.OrderByDescending(s => s.UnitPrice),
            "total" => sortAsc ? q.OrderBy(s => s.TotalPrice) : q.OrderByDescending(s => s.TotalPrice),
            _ => q.OrderByDescending(s => s.DateSold)
        };

        return q.ToList();
    }

    private void SetSort(string column)
    {
        if (sortColumn == column)
            sortAsc = !sortAsc;
        else
        {
            sortColumn = column;
            sortAsc = true;
        }
    }

    private string SortIcon(string column)
    {
        if (sortColumn != column) return "";
        return sortAsc ? "▲" : "▼";
    }

    private void OpenAddModal()
    {
        formModel = new ProductSale { DateSold = DateTime.Today, Quantity = 1 };
        isEditing = false;
        showModal = true;
    }

    private void OpenEditModal(ProductSale sale)
    {
        formModel = new ProductSale
        {
            Id = sale.Id,
            ProductId = sale.ProductId,
            WorkerId = sale.WorkerId,
            DateSold = sale.DateSold,
            Quantity = sale.Quantity,
            UnitPrice = sale.UnitPrice,
            ClientName = sale.ClientName,
            Notes = sale.Notes
        };
        editId = sale.Id;
        isEditing = true;
        showModal = true;
    }

    private void CloseModal() => showModal = false;

    private void OnProductChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var id))
        {
            formModel.ProductId = id;
            var p = products?.FirstOrDefault(x => x.Id == id);
            if (p != null)
                formModel.UnitPrice = p.Price;
        }
    }

    private void OnWorkerChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var id))
            formModel.WorkerId = id == 0 ? null : id;
    }

    private async Task HandleSubmit()
    {
        if (formModel.ProductId == 0)
        {
            Toast.Show("Please select a product.", ToastLevel.Error);
            return;
        }

        saving = true;
        try
        {
            if (isEditing)
            {
                var resp = await Http.PutAsJsonAsync($"api/productsales/{editId}", formModel);
                if (resp.IsSuccessStatusCode)
                {
                    Toast.Show("Sale updated");
                    allSales = await Http.GetFromJsonAsync<List<ProductSale>>("api/productsales");
                    showModal = false;
                }
                else Toast.Show("Failed to update sale", ToastLevel.Error);
            }
            else
            {
                var resp = await Http.PostAsJsonAsync("api/productsales", formModel);
                if (resp.IsSuccessStatusCode)
                {
                    Toast.Show("Sale recorded!");
                    allSales = await Http.GetFromJsonAsync<List<ProductSale>>("api/productsales");
                    showModal = false;
                }
                else Toast.Show("Failed to record sale", ToastLevel.Error);
            }
        }
        finally { saving = false; }
    }

    private void ConfirmDelete(ProductSale sale)
    {
        deleteTarget = sale;
        showDeleteConfirm = true;
    }

    private async Task HandleDelete()
    {
        if (deleteTarget == null) return;
        var resp = await Http.DeleteAsync($"api/productsales/{deleteTarget.Id}");
        if (resp.IsSuccessStatusCode)
        {
            Toast.Show("Sale deleted");
            allSales = await Http.GetFromJsonAsync<List<ProductSale>>("api/productsales");
        }
        else Toast.Show("Failed to delete sale", ToastLevel.Error);
        showDeleteConfirm = false;
        deleteTarget = null;
    }
}

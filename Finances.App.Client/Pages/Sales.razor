@page "/sales"
@implements IDisposable
@inject IFinanceStore Store
@inject MoneyFormat Money
@inject WorkerContextService WorkerContext
@inject ToastService Toast
@inject IStringLocalizer<AppStrings> L

<PageTitle>@L["Sales_Title"]</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="page-title mb-1">@L["Sales_Title"]</h1>
        <p class="text-muted mb-0">@L["Sales_Subtitle"]</p>
    </div>
    <button class="btn btn-primary" @onclick="OpenAddModal">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="me-1" aria-hidden="true"><path d="M12 5v14M5 12h14"/></svg>
        @L["Sales_RecordSale"]
    </button>
</div>

<div class="d-flex flex-wrap align-items-center gap-3">
    <DateRangeFilter From="@dateFrom" To="@dateTo" OnRangeChanged="OnDateRangeChanged" />
    <div class="ms-auto" style="min-width: 240px;">
        <label class="visually-hidden-text" for="sales-search">@L["Sales_SearchLabel"]</label>
        <input id="sales-search" type="search" class="form-control form-control-sm"
               placeholder="@L["Sales_SearchPlaceholder"]" @oninput="OnSearchInput" />
    </div>
</div>

@if (allSales == null)
{
    <LoadingSpinner />
}
else if (filtered.Count == 0)
{
    <div class="card p-5 text-center mt-3">
        <p class="text-muted mb-3">@L["Sales_Empty"]</p>
        <div><button class="btn btn-primary" @onclick="OpenAddModal">@L["Sales_RecordSale"]</button></div>
    </div>
}
else
{
    <div class="card mt-3">
        <div class="table-responsive" style="max-height: 70vh; overflow-y: auto;">
            <table class="table table-hover mb-0">
                <thead>
                    <tr>
                        <th aria-sort="@sort.AriaSort("date")">
                            <button type="button" class="sort-button" @onclick='() => SetSort("date")'>@L["Common_Date"] <span aria-hidden="true">@sort.Icon("date")</span></button>
                        </th>
                        <th>@L["Sales_Product"]</th>
                        <th>@L["Common_Worker"]</th>
                        <th>@L["Common_Client"]</th>
                        <th>@L["Sales_Qty"]</th>
                        <th aria-sort="@sort.AriaSort("price")">
                            <button type="button" class="sort-button" @onclick='() => SetSort("price")'>@L["Sales_UnitPrice"] <span aria-hidden="true">@sort.Icon("price")</span></button>
                        </th>
                        <th aria-sort="@sort.AriaSort("total")">
                            <button type="button" class="sort-button" @onclick='() => SetSort("total")'>@L["Common_Total"] <span aria-hidden="true">@sort.Icon("total")</span></button>
                        </th>
                        <th>@L["Common_Notes"]</th>
                        <th style="width: 100px;">@L["Common_Actions"]</th>
                    </tr>
                </thead>
                <tbody>
                    <Virtualize Items="filtered" Context="s" SpacerElement="tr">
                        <tr @key="s.Id">
                            <td>@s.DateSold.ToDateKey()</td>
                            <td class="fw-semibold">@(s.Product?.Name ?? "—")</td>
                            <td>@(s.Worker?.Name ?? "—")</td>
                            <td class="text-muted">@(s.ClientName ?? "—")</td>
                            <td>@s.Quantity</td>
                            <td>@Money.Format(s.UnitPrice)</td>
                            <td class="fw-semibold">@Money.Format(s.TotalPrice)</td>
                            <td class="text-muted" style="max-width: 150px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;" title="@s.Notes">@(s.Notes ?? "")</td>
                            <td>
                                <button class="btn btn-sm btn-outline-secondary me-1" @onclick="() => OpenEditModal(s)">@L["Common_Edit"]</button>
                                <button class="btn btn-sm btn-outline-danger" @onclick="() => ConfirmDelete(s)">@L["Common_Delete"]</button>
                            </td>
                        </tr>
                    </Virtualize>
                </tbody>
                <tfoot>
                    <tr class="fw-bold" style="background-color: var(--body-bg);">
                        <td colspan="4">@L["Common_Totals"]</td>
                        <td>@totalQuantity</td>
                        <td></td>
                        <td>@Money.Format(totalRevenue)</td>
                        <td colspan="2"></td>
                    </tr>
                </tfoot>
            </table>
        </div>
    </div>
}

<ModalDialog IsVisible="showModal" Title="@(isEditing ? L["Sales_EditTitle"] : L["Sales_AddTitle"])" OnClose="CloseModal">
    <EditForm Model="@formModel" OnValidSubmit="HandleSubmit">
        <DataAnnotationsValidator />
        <div class="modal-body">
            <div class="row g-3">
                <div class="col-md-6">
                    <label class="form-label" for="sale-product">@L["Sales_Product"]</label>
                    <select id="sale-product" class="form-select" value="@formModel.ProductId" @onchange="OnProductChanged">
                        <option value="0">@L["Sales_SelectProduct"]</option>
                        @if (products != null)
                        {
                            @foreach (var p in products)
                            {
                                <option value="@p.Id">@p.Name (@Money.Format(p.Price))</option>
                            }
                        }
                    </select>
                </div>
                <div class="col-md-6">
                    <label class="form-label" for="sale-worker">@L["Sales_WorkerOptional"]</label>
                    <select id="sale-worker" class="form-select" value="@(formModel.WorkerId ?? 0)" @onchange="OnWorkerChanged">
                        <option value="0">@L["Sales_NoWorker"]</option>
                        @if (workers != null)
                        {
                            @foreach (var w in workers)
                            {
                                <option value="@w.Id">@w.Name</option>
                            }
                        }
                    </select>
                </div>
                <div class="col-md-4">
                    <label class="form-label" for="sale-date">@L["Common_Date"]</label>
                    <InputDate id="sale-date" class="form-control" @bind-Value="formModel.DateSold" />
                </div>
                <div class="col-md-4">
                    <label class="form-label" for="sale-quantity">@L["Sales_Quantity"]</label>
                    <InputNumber id="sale-quantity" class="form-control" @bind-Value="formModel.Quantity" />
                    <ValidationMessage For="() => formModel.Quantity" />
                </div>
                <div class="col-md-4">
                    <label class="form-label" for="sale-price">@L["Sales_UnitPriceFull"]</label>
                    <InputNumber id="sale-price" class="form-control" @bind-Value="formModel.UnitPrice" />
                    <ValidationMessage For="() => formModel.UnitPrice" />
                </div>
                <div class="col-md-6">
                    <label class="form-label" for="sale-client">@L["Common_ClientName"]</label>
                    <InputText id="sale-client" class="form-control" @bind-Value="formModel.ClientName" placeholder="@L["Common_Optional"]" />
                </div>
                <div class="col-12">
                    <label class="form-label" for="sale-notes">@L["Common_Notes"]</label>
                    <InputTextArea id="sale-notes" class="form-control" @bind-Value="formModel.Notes" rows="2" />
                </div>
            </div>
        </div>
        <div class="modal-footer">
            <div class="me-auto">
                @if (formModel.Quantity > 0 && formModel.UnitPrice > 0)
                {
                    <span class="text-muted" style="font-size: 0.875rem;">
                        @L["Sales_TotalLabel"] <strong>@(Money.Format(formModel.UnitPrice * formModel.Quantity))</strong>
                    </span>
                }
            </div>
            <button type="button" class="btn btn-secondary" @onclick="CloseModal">@L["Common_Cancel"]</button>
            <button type="submit" class="btn btn-primary" disabled="@saving">
                @(saving ? L["Common_Saving"] : (isEditing ? L["Common_Update"] : L["Common_Save"]))
            </button>
        </div>
    </EditForm>
</ModalDialog>

<ConfirmDialog IsVisible="showDeleteConfirm"
               Title="@L["Sales_DeleteTitle"]"
               Message="@L["Sales_DeleteMessage", deleteTarget?.DateSold.ToDateKey() ?? ""]"
               ConfirmText="@L["Common_Delete"]"
               OnConfirm="HandleDelete"
               OnCancel="() => { showDeleteConfirm = false; }" />

@code {
    private List<ProductSale>? allSales;
    private List<ProductSale> filtered = new();
    private List<Product>? products;
    private List<Worker>? workers;
    private DateTime? dateFrom;
    private DateTime? dateTo;
    private string searchTerm = string.Empty;
    private CancellationTokenSource? searchCts;
    private int totalQuantity;
    private decimal totalRevenue;
    private readonly SortState sort = new("date");

    private ProductSale formModel = new();
    private bool showModal, isEditing, saving;
    private int editId;

    private ProductSale? deleteTarget;
    private bool showDeleteConfirm;

    protected override async Task OnInitializedAsync()
    {
        WorkerContext.OnChange += HandleWorkerChanged;
        await WorkerContext.InitializeAsync();
        allSales = (await Store.GetProductSalesAsync()).ToList();
        products = (await Store.GetProductsAsync()).ToList();
        workers = (await Store.GetWorkersAsync()).ToList();
        ApplyFilter();
    }

    private void HandleWorkerChanged()
    {
        _ = InvokeAsync(() =>
        {
            ApplyFilter();
            StateHasChanged();
        });
    }

    public void Dispose()
    {
        WorkerContext.OnChange -= HandleWorkerChanged;
        searchCts?.Cancel();
    }

    private void OnDateRangeChanged((DateTime? From, DateTime? To) range)
    {
        dateFrom = range.From;
        dateTo = range.To;
        ApplyFilter();
    }

    private void SetSort(string column)
    {
        sort.Toggle(column);
        ApplyFilter();
    }

    private void OnSearchInput(ChangeEventArgs e)
    {
        searchTerm = e.Value?.ToString() ?? string.Empty;
        searchCts?.Cancel();
        searchCts = new CancellationTokenSource();
        _ = DebounceSearchAsync(searchCts.Token);
    }

    private async Task DebounceSearchAsync(CancellationToken token)
    {
        try
        {
            await Task.Delay(250, token);
            ApplyFilter();
            StateHasChanged();
        }
        catch (TaskCanceledException)
        {
            // Superseded by newer input.
        }
    }

    private static bool Matches(string? value, string term)
    {
        return value?.Contains(term, StringComparison.CurrentCultureIgnoreCase) == true;
    }

    // Recomputed on state changes rather than inside the render body, so the
    // filter+sort (and the footer totals) do not re-run on every re-render.
    private void ApplyFilter()
    {
        if (allSales == null)
        {
            filtered = new();
            totalQuantity = 0;
            totalRevenue = 0;
            return;
        }

        var q = allSales.AsEnumerable();

        if (WorkerContext.SelectedWorkerId.HasValue)
            q = q.Where(s => s.WorkerId == WorkerContext.SelectedWorkerId.Value);

        if (dateFrom.HasValue)
            q = q.Where(s => s.DateSold.Date >= dateFrom.Value.Date);

        if (dateTo.HasValue)
            q = q.Where(s => s.DateSold.Date <= dateTo.Value.Date);

        var term = searchTerm.Trim();
        if (term.Length > 0)
        {
            q = q.Where(s => Matches(s.ClientName, term)
                || Matches(s.Notes, term)
                || Matches(s.Worker?.Name, term)
                || Matches(s.Product?.Name, term));
        }

        q = sort.Column switch
        {
            "date" => sort.Ascending ? q.OrderBy(s => s.DateSold) : q.OrderByDescending(s => s.DateSold),
            "price" => sort.Ascending ? q.OrderBy(s => s.UnitPrice) : q.OrderByDescending(s => s.UnitPrice),
            "total" => sort.Ascending ? q.OrderBy(s => s.TotalPrice) : q.OrderByDescending(s => s.TotalPrice),
            _ => q.OrderByDescending(s => s.DateSold)
        };

        filtered = q.ToList();
        totalQuantity = filtered.Sum(s => s.Quantity);
        totalRevenue = filtered.Sum(s => s.TotalPrice);
    }

    private void OpenAddModal()
    {
        formModel = new ProductSale { DateSold = DateTime.Today, Quantity = 1 };
        isEditing = false;
        showModal = true;
    }

    private void OpenEditModal(ProductSale sale)
    {
        formModel = new ProductSale
        {
            Id = sale.Id,
            ProductId = sale.ProductId,
            WorkerId = sale.WorkerId,
            DateSold = sale.DateSold,
            Quantity = sale.Quantity,
            UnitPrice = sale.UnitPrice,
            ClientName = sale.ClientName,
            Notes = sale.Notes
        };
        editId = sale.Id;
        isEditing = true;
        showModal = true;
    }

    private void CloseModal() => showModal = false;

    private void OnProductChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var id))
        {
            formModel.ProductId = id;
            var p = products?.FirstOrDefault(x => x.Id == id);
            if (p != null)
                formModel.UnitPrice = p.Price;
        }
    }

    private void OnWorkerChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var id))
            formModel.WorkerId = id == 0 ? null : id;
    }

    private async Task HandleSubmit()
    {
        if (formModel.ProductId == 0)
        {
            Toast.Show(L["Sales_SelectProductError"], ToastLevel.Error);
            return;
        }

        saving = true;
        try
        {
            if (isEditing)
            {
                await Store.UpdateProductSaleAsync(editId, formModel);
                Toast.Show(L["Sales_Updated"]);
            }
            else
            {
                await Store.AddProductSaleAsync(formModel);
                Toast.Show(L["Sales_Recorded"]);
            }
            allSales = (await Store.GetProductSalesAsync()).ToList();
            products = (await Store.GetProductsAsync()).ToList();
            ApplyFilter();
            showModal = false;
        }
        catch (Exception ex)
        {
            Toast.Show(UserFacingError.Message(ex), ToastLevel.Error);
        }
        finally { saving = false; }
    }

    private void ConfirmDelete(ProductSale sale)
    {
        deleteTarget = sale;
        showDeleteConfirm = true;
    }

    private async Task HandleDelete()
    {
        if (deleteTarget == null) return;
        var deleted = deleteTarget;
        try
        {
            await Store.DeleteProductSaleAsync(deleted.Id);
            // Undo goes back through AddProductSaleAsync, so stock is
            // re-decremented with the usual sufficiency check; if the stock
            // was sold meanwhile the undo fails with the real reason.
            Toast.Show(L["Sales_Deleted"], ToastLevel.Success, L["Common_Undo"], async () =>
            {
                await Store.AddProductSaleAsync(deleted);
                await InvokeAsync(async () =>
                {
                    allSales = (await Store.GetProductSalesAsync()).ToList();
                    products = (await Store.GetProductsAsync()).ToList();
                    ApplyFilter();
                    StateHasChanged();
                });
            });
            allSales = (await Store.GetProductSalesAsync()).ToList();
            products = (await Store.GetProductsAsync()).ToList();
            ApplyFilter();
        }
        catch (Exception ex)
        {
            Toast.Show(UserFacingError.Message(ex), ToastLevel.Error);
        }
        showDeleteConfirm = false;
        deleteTarget = null;
    }
}

@page "/analytics"
@implements IAsyncDisposable
@inject IAnalyticsService AnalyticsService
@inject MoneyFormat Money
@inject ThemeService Theme
@inject IJSRuntime JS
@inject WorkerContextService WorkerContext

<PageTitle>Analytics</PageTitle>

<div class="mb-4">
    <h1 class="page-title mb-1">Analytics</h1>
    <p class="text-muted mb-0">Revenue trends, forecasting, and detailed breakdowns.</p>
</div>

<DateRangeFilter From="@dateFrom" To="@dateTo" OnRangeChanged="OnDateRangeChanged" />

@if (loading)
{
    <LoadingSpinner />
}
else
{
    <!-- Forecast Section -->
    <div class="row g-3 mt-1">
        <div class="col-12">
            <div class="card p-3">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <div>
                        <h6 class="fw-semibold mb-0">Revenue Forecast</h6>
                        <small class="text-muted">Linear regression on @(dateFrom.HasValue ? "the selected range" : "the last 90 days") &middot; @forecastDays-day projection</small>
                    </div>
                    <div class="d-flex align-items-center gap-2">
                        <label class="text-muted" style="font-size: 0.8rem;" for="forecast-days">Forecast days:</label>
                        <select id="forecast-days" class="form-select form-select-sm" style="width: 80px;" value="@forecastDays" @onchange="OnForecastDaysChanged">
                            <option value="7">7</option>
                            <option value="14">14</option>
                            <option value="30">30</option>
                        </select>
                    </div>
                </div>
                @if (forecastResult != null && forecastResult.Historical.Length > 0)
                {
                    <div class="row mb-3">
                        <div class="col-auto">
                            <span class="badge badge-tint badge-tint-primary">
                                Slope: @forecastResult.Slope.ToString("F2")/day
                            </span>
                        </div>
                        <div class="col-auto">
                            <span class="badge badge-tint badge-tint-indigo">
                                R&sup2;: @forecastResult.RSquared.ToString("F4")
                            </span>
                        </div>
                        <div class="col-auto">
                            @{
                                var direction = forecastResult.Slope > 0 ? "Upward" : forecastResult.Slope < 0 ? "Downward" : "Flat";
                                var dirClass = forecastResult.Slope > 0 ? "badge-tint-up" : forecastResult.Slope < 0 ? "badge-tint-down" : "badge-tint-flat";
                            }
                            <span class="badge badge-tint @dirClass">
                                Trend: @direction
                            </span>
                        </div>
                    </div>
                }
                @if (forecastResult != null && forecastResult.Historical.Length > 0)
                {
                    <div style="height: 340px;">
                        <canvas id="forecastChart"></canvas>
                    </div>
                }
                else
                {
                    <div class="d-flex align-items-center justify-content-center" style="height: 340px;">
                        <p class="text-muted mb-0">Not enough data to forecast yet — record services on at least two different days.</p>
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- Combined Revenue Timeline -->
    <div class="row g-3 mt-1">
        <div class="col-12">
            <div class="card p-3">
                <h6 class="fw-semibold mb-3">Services vs Products Revenue</h6>
                @if (combinedTimeline?.Points.Count > 0)
                {
                    <div style="height: 300px;">
                        <canvas id="analyticsTimelineChart"></canvas>
                    </div>
                }
                else
                {
                    <div class="d-flex align-items-center justify-content-center" style="height: 300px;">
                        <p class="text-muted mb-0">No revenue in this period.</p>
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- Breakdowns -->
    <div class="row g-3 mt-1">
        <div class="col-lg-6">
            <div class="card p-3">
                <h6 class="fw-semibold mb-3">Revenue by Worker</h6>
                @if (workerData != null && workerData.Length > 0)
                {
                    <div style="height: 300px;">
                        <canvas id="revenueByWorkerChart"></canvas>
                    </div>
                }
                else
                {
                    <div class="d-flex align-items-center justify-content-center" style="height: 300px;">
                        <p class="text-muted mb-0">No data for this period.</p>
                    </div>
                }
            </div>
        </div>
        <div class="col-lg-6">
            <div class="card p-3">
                <h6 class="fw-semibold mb-3">Service Popularity</h6>
                @if (serviceData != null && serviceData.Length > 0)
                {
                    <div style="height: 300px;">
                        <canvas id="servicePopularityChart"></canvas>
                    </div>
                }
                else
                {
                    <div class="d-flex align-items-center justify-content-center" style="height: 300px;">
                        <p class="text-muted mb-0">No data for this period.</p>
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- Day of Week + Top Products -->
    <div class="row g-3 mt-1">
        <div class="col-lg-6">
            <div class="card p-3">
                <h6 class="fw-semibold mb-3">Revenue by Day of Week</h6>
                @if (dayOfWeekData?.Any(d => d.Count > 0) == true)
                {
                    <div style="height: 280px;">
                        <canvas id="dayOfWeekAnalyticsChart"></canvas>
                    </div>
                }
                else
                {
                    <div class="d-flex align-items-center justify-content-center" style="height: 280px;">
                        <p class="text-muted mb-0">No data for this period.</p>
                    </div>
                }
            </div>
        </div>
        <div class="col-lg-6">
            <div class="card p-3">
                <h6 class="fw-semibold mb-3">Top Products</h6>
                @if (topProducts != null && topProducts.Length > 0)
                {
                    <div style="height: 280px;">
                        <canvas id="topProductsChart"></canvas>
                    </div>
                }
                else
                {
                    <div class="d-flex align-items-center justify-content-center" style="height: 280px;">
                        <p class="text-muted mb-0">No product sales in this period.</p>
                    </div>
                }
            </div>
        </div>
    </div>

    <div class="row g-3 mt-1">
        <div class="col-lg-8">
            <div class="card p-3">
                <h6 class="fw-semibold mb-3">Daily Revenue</h6>
                @if (dailyData != null && dailyData.Length > 0)
                {
                    <div style="height: 300px;">
                        <canvas id="dailyTrendChart"></canvas>
                    </div>
                }
                else
                {
                    <div class="d-flex align-items-center justify-content-center" style="height: 300px;">
                        <p class="text-muted mb-0">No data for this period.</p>
                    </div>
                }
            </div>
        </div>
        <div class="col-lg-4">
            <div class="card p-3">
                <h6 class="fw-semibold mb-3">Top Services by Revenue</h6>
                @if (serviceData != null && serviceData.Length > 0)
                {
                    var maxServiceRevenue = serviceData.Max(x => x.Revenue);
                    <div class="list-group list-group-flush">
                        @foreach (var s in serviceData.OrderByDescending(x => x.Revenue).Take(5))
                        {
                            <div class="list-group-item px-0" style="border-color: var(--border-color);">
                                <div class="d-flex justify-content-between mb-1">
                                    <div>
                                        <div class="fw-semibold" style="font-size: 0.875rem;">@s.Service</div>
                                        <div class="text-muted" style="font-size: 0.75rem;">@s.Count services</div>
                                    </div>
                                    <span class="fw-semibold" style="color: var(--primary);">@Money.Format(s.Revenue)</span>
                                </div>
                                @if (maxServiceRevenue > 0)
                                {
                                    var pct = (double)s.Revenue / (double)maxServiceRevenue * 100;
                                    <div class="progress-bar-custom">
                                        <div class="progress-fill" style="width: @($"{pct:F0}")%;"></div>
                                    </div>
                                }
                            </div>
                        }
                    </div>
                }
                else
                {
                    <p class="text-muted mb-0" style="font-size: 0.875rem;">No data for this period.</p>
                }
            </div>
        </div>
    </div>

    <!-- Expenses -->
    <div class="row g-3 mt-1">
        <div class="col-12">
            <div class="card p-3">
                <div class="mb-3">
                    <h6 class="fw-semibold mb-0">Expenses</h6>
                    <small class="text-muted">Business-level costs for the selected period — the worker filter does not apply here.</small>
                </div>
                @if (expenseSummary != null && expenseSummary.ByCategory.Count > 0)
                {
                    <div class="row g-3">
                        <div class="col-md-4">
                            <div class="mb-3">
                                <span class="text-muted small">Total expenses</span>
                                <div class="fs-4 fw-bold">@Money.Format(expenseSummary.Total)</div>
                            </div>
                            <div>
                                <span class="text-muted small">Net after expenses</span>
                                <div class="fs-4 fw-bold" style="color: @(NetAfterExpenses >= 0 ? "var(--success)" : "var(--danger)");">
                                    @Money.Format(NetAfterExpenses)
                                </div>
                                <div class="text-muted" style="font-size: 0.75rem;">Salon share + product revenue − expenses</div>
                            </div>
                        </div>
                        <div class="col-md-8">
                            @{
                                var maxCategoryTotal = expenseSummary.ByCategory.Max(c => c.Total);
                            }
                            <div class="list-group list-group-flush">
                                @foreach (var category in expenseSummary.ByCategory)
                                {
                                    <div class="list-group-item px-0" style="border-color: var(--border-color);">
                                        <div class="d-flex justify-content-between mb-1">
                                            <div>
                                                <div class="fw-semibold" style="font-size: 0.875rem;">@category.Category</div>
                                                <div class="text-muted" style="font-size: 0.75rem;">@category.Count @(category.Count == 1 ? "expense" : "expenses")</div>
                                            </div>
                                            <span class="fw-semibold" style="color: var(--danger);">@Money.Format(category.Total)</span>
                                        </div>
                                        @if (maxCategoryTotal > 0)
                                        {
                                            var pct = (double)category.Total / (double)maxCategoryTotal * 100;
                                            <div class="progress-bar-custom">
                                                <div class="progress-fill" style="width: @($"{pct:F0}")%;"></div>
                                            </div>
                                        }
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                }
                else
                {
                    <p class="text-muted mb-0">No expenses recorded for this period. <a href="expenses">Add expenses</a> to see net profit after costs.</p>
                }
            </div>
        </div>
    </div>

    <div class="row g-3 mt-1 mb-4">
        <div class="col-12">
            <div class="card p-3">
                <h6 class="fw-semibold mb-3">Commission Report</h6>
                @if (workerData != null && workerData.Length > 0)
                {
                    <div class="table-responsive">
                        <table class="table table-hover mb-0">
                            <thead>
                                <tr>
                                    <th>Worker</th>
                                    <th>Revenue</th>
                                    <th>Tips</th>
                                    <th>Total</th>
                                    <th>Share</th>
                                </tr>
                            </thead>
                            <tbody>
                                @{
                                    var grandTotal = workerData.Sum(w => w.Revenue + w.Tips);
                                }
                                @foreach (var w in workerData)
                                {
                                    var total = w.Revenue + w.Tips;
                                    var share = grandTotal > 0 ? (total / grandTotal * 100) : 0;
                                    <tr>
                                        <td class="fw-semibold">@w.Worker</td>
                                        <td>@Money.Format(w.Revenue)</td>
                                        <td>@Money.Format(w.Tips)</td>
                                        <td class="fw-semibold">@Money.Format(total)</td>
                                        <td>
                                            <div class="d-flex align-items-center gap-2">
                                                <div class="progress-bar-custom" style="width: 80px;">
                                                    <div class="progress-fill" style="width: @($"{share:F0}")%;"></div>
                                                </div>
                                                <span class="text-muted" style="font-size: 0.75rem;">@share.ToString("F1")%</span>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                            <tfoot>
                                <tr class="fw-bold" style="background-color: var(--body-bg);">
                                    <td>Total</td>
                                    <td>@Money.Format(workerData.Sum(w => w.Revenue))</td>
                                    <td>@Money.Format(workerData.Sum(w => w.Tips))</td>
                                    <td>@Money.Format(workerData.Sum(w => w.Revenue + w.Tips))</td>
                                    <td></td>
                                </tr>
                            </tfoot>
                        </table>
                    </div>
                }
                else
                {
                    <p class="text-muted mb-0">No data for this period.</p>
                }
            </div>
        </div>
    </div>
}

@code {
    private bool loading = true;
    private DateTime? dateFrom;
    private DateTime? dateTo;
    private int forecastDays = 14;
    private WorkerRevenueResult[]? workerData;
    private ServicePopularityResult[]? serviceData;
    private DailyEarningResult[]? dailyData;
    private ForecastResult? forecastResult;
    private DayOfWeekResult[]? dayOfWeekData;
    private TopProductResult[]? topProducts;
    private CombinedTimelineResult? combinedTimeline;
    private ExpenseSummaryResult? expenseSummary;
    private SummaryResult? businessSummary;
    private decimal businessProductRevenue;
    private bool needsChartRender;

    // Salon-side earnings (salon share of services plus all product revenue)
    // minus expenses; deliberately unfiltered by worker, like the expenses.
    private decimal NetAfterExpenses =>
        (businessSummary?.TotalSalonShare ?? 0) + businessProductRevenue - (expenseSummary?.Total ?? 0);

    private static readonly string[] ChartIds =
    [
        "forecastChart", "analyticsTimelineChart", "revenueByWorkerChart",
        "servicePopularityChart", "dayOfWeekAnalyticsChart", "topProductsChart", "dailyTrendChart"
    ];

    // Locale null = browser default; the currency comes from settings.
    private object MoneyOptions => new { locale = (string?)null, currency = Money.CurrencyCode };

    protected override async Task OnInitializedAsync()
    {
        WorkerContext.OnChange += HandleWorkerChanged;
        Theme.OnChange += HandleThemeChanged;
        await WorkerContext.InitializeAsync();
        var today = DateTime.Today;
        dateFrom = new DateTime(today.Year, today.Month, 1);
        dateTo = today;
        await LoadData();
    }

    private void HandleWorkerChanged()
    {
        _ = InvokeAsync(async () =>
        {
            try
            {
                await LoadData();
                StateHasChanged();
            }
            catch (Exception ex)
            {
                Console.Error.WriteLine($"Analytics reload failed: {ex.Message}");
            }
        });
    }

    private void HandleThemeChanged()
    {
        // Charts hold their colors, so a theme change means re-rendering them
        // to pick up the new token values.
        _ = InvokeAsync(() =>
        {
            needsChartRender = true;
            StateHasChanged();
        });
    }

    public async ValueTask DisposeAsync()
    {
        WorkerContext.OnChange -= HandleWorkerChanged;
        Theme.OnChange -= HandleThemeChanged;

        try
        {
            await JS.InvokeVoidAsync("financeCharts.destroyMany", (object)ChartIds);
        }
        catch (Exception)
        {
            // JS runtime may already be gone during teardown.
        }
    }

    private async Task OnDateRangeChanged((DateTime? From, DateTime? To) range)
    {
        dateFrom = range.From;
        dateTo = range.To;
        await LoadData();
    }

    private async Task OnForecastDaysChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var days))
        {
            forecastDays = days;
            await LoadForecast();
            needsChartRender = true;
        }
    }

    private async Task LoadData()
    {
        loading = true;
        try
        {
            var wId = WorkerContext.SelectedWorkerId;
            workerData = (await AnalyticsService.GetRevenueByWorkerAsync(dateFrom, dateTo)).ToArray();
            serviceData = (await AnalyticsService.GetServicePopularityAsync(wId, dateFrom, dateTo)).ToArray();
            dailyData = (await AnalyticsService.GetDailyEarningsAsync(wId, dateFrom, dateTo)).ToArray();
            await LoadForecast();

            dayOfWeekData = (await AnalyticsService.GetRevenueByDayOfWeekAsync(wId, dateFrom, dateTo)).ToArray();
            topProducts = (await AnalyticsService.GetTopProductsAsync(wId, dateFrom, dateTo)).ToArray();
            combinedTimeline = await AnalyticsService.GetCombinedTimelineAsync(wId, dateFrom, dateTo);

            // Expense card inputs are business-level: no worker filter.
            expenseSummary = await AnalyticsService.GetExpenseSummaryAsync(dateFrom, dateTo);
            businessSummary = await AnalyticsService.GetSummaryAsync(null, dateFrom, dateTo);
            businessProductRevenue = (await AnalyticsService.GetCombinedTimelineAsync(null, dateFrom, dateTo))
                .Points.Sum(point => point.ProductRevenue);
        }
        catch (Exception ex)
        {
            Console.Error.WriteLine($"Analytics load failed: {ex.Message}");
        }
        finally
        {
            loading = false;
            needsChartRender = true;
        }
    }

    private async Task LoadForecast()
    {
        try
        {
            // Same filters as every other chart on this page.
            forecastResult = await AnalyticsService.GetForecastAsync(WorkerContext.SelectedWorkerId, forecastDays, dateFrom, dateTo);
        }
        catch (Exception ex)
        {
            Console.Error.WriteLine($"Forecast load failed: {ex.Message}");
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (needsChartRender)
        {
            needsChartRender = false;
            // Yield to let Blazor commit the DOM before JS reads canvas dimensions
            await Task.Yield();
            await RenderCharts();
        }
    }

    private async Task RenderCharts()
    {
        // Each chart is wrapped individually so one failure doesn't block others
        try { await RenderForecastChart(); } catch (Exception ex) { Console.Error.WriteLine($"Forecast chart failed: {ex.Message}"); }

        try
        {
            if (combinedTimeline?.Points != null && combinedTimeline.Points.Count > 0)
            {
                var labels = combinedTimeline.Points.Select(p => p.Date).ToArray();
                var datasets = new object[]
                {
                    new { label = "Services", data = combinedTimeline.Points.Select(p => p.ServiceRevenue).ToArray() },
                    new { label = "Products", data = combinedTimeline.Points.Select(p => p.ProductRevenue).ToArray() }
                };
                await JS.InvokeVoidAsync("financeCharts.renderStackedBarChart", "analyticsTimelineChart", labels, datasets, MoneyOptions);
            }
            else
            {
                await JS.InvokeVoidAsync("financeCharts.destroy", "analyticsTimelineChart");
            }
        }
        catch (Exception ex) { Console.Error.WriteLine($"Chart failed (combined timeline): {ex.Message}"); }

        try
        {
            if (workerData != null && workerData.Length > 0)
            {
                var labels = workerData.Select(w => w.Worker).ToArray();
                var datasets = new object[]
                {
                    new { label = "Revenue", data = workerData.Select(w => w.Revenue).ToArray() },
                    new { label = "Tips", data = workerData.Select(w => w.Tips).ToArray() }
                };
                await JS.InvokeVoidAsync("financeCharts.renderBarChart", "revenueByWorkerChart", labels, datasets, MoneyOptions);
            }
            else
            {
                await JS.InvokeVoidAsync("financeCharts.destroy", "revenueByWorkerChart");
            }
        }
        catch (Exception ex) { Console.Error.WriteLine($"Chart failed (worker revenue): {ex.Message}"); }

        try
        {
            if (serviceData != null && serviceData.Length > 0)
            {
                var labels = serviceData.Select(s => s.Service).ToArray();
                var data = serviceData.Select(s => (decimal)s.Count).ToArray();
                // Counts, not money: no currency option.
                await JS.InvokeVoidAsync("financeCharts.renderDoughnutChart", "servicePopularityChart", labels, data, (object?)null);
            }
            else
            {
                await JS.InvokeVoidAsync("financeCharts.destroy", "servicePopularityChart");
            }
        }
        catch (Exception ex) { Console.Error.WriteLine($"Chart failed (service popularity): {ex.Message}"); }

        try
        {
            // Guard matches the markup: the canvas only exists when at least
            // one day has records.
            if (dayOfWeekData?.Any(d => d.Count > 0) == true)
            {
                var labels = dayOfWeekData.Select(d => d.Day).ToArray();
                var data = dayOfWeekData.Select(d => d.Revenue).ToArray();
                await JS.InvokeVoidAsync("financeCharts.renderBarChart", "dayOfWeekAnalyticsChart", labels,
                    new object[] { new { label = "Revenue", data = data } }, MoneyOptions);
            }
            else
            {
                await JS.InvokeVoidAsync("financeCharts.destroy", "dayOfWeekAnalyticsChart");
            }
        }
        catch (Exception ex) { Console.Error.WriteLine($"Chart failed (day-of-week): {ex.Message}"); }

        try
        {
            if (topProducts != null && topProducts.Length > 0)
            {
                var labels = topProducts.Select(p => p.Product).ToArray();
                var data = topProducts.Select(p => p.Revenue).ToArray();
                await JS.InvokeVoidAsync("financeCharts.renderHorizontalBarChart", "topProductsChart", labels, data, MoneyOptions);
            }
            else
            {
                await JS.InvokeVoidAsync("financeCharts.destroy", "topProductsChart");
            }
        }
        catch (Exception ex) { Console.Error.WriteLine($"Chart failed (top products): {ex.Message}"); }

        try
        {
            if (dailyData != null && dailyData.Length > 0)
            {
                var labels = dailyData.Select(d => d.Date).ToArray();
                var datasets = new object[]
                {
                    new { label = "Revenue", data = dailyData.Select(d => d.Revenue).ToArray() }
                };
                await JS.InvokeVoidAsync("financeCharts.renderLineChart", "dailyTrendChart", labels, datasets, MoneyOptions);
            }
            else
            {
                await JS.InvokeVoidAsync("financeCharts.destroy", "dailyTrendChart");
            }
        }
        catch (Exception ex) { Console.Error.WriteLine($"Chart failed (daily trend): {ex.Message}"); }
    }

    private async Task RenderForecastChart()
    {
        try
        {
            if (forecastResult != null && forecastResult.Historical.Length > 0)
            {
                var histLabels = forecastResult.Historical.Select(h => h.Date).ToArray();
                var actualData = forecastResult.Historical.Select(h => h.Actual).ToArray();
                var trendData = forecastResult.Historical.Select(h => h.Trend).ToArray();
                var forecastLabels = forecastResult.Forecast.Select(f => f.Date).ToArray();
                var forecastData = forecastResult.Forecast.Select(f => f.Predicted).ToArray();

                await JS.InvokeVoidAsync("financeCharts.renderForecastChart",
                    "forecastChart", histLabels, actualData, trendData, forecastLabels, forecastData, MoneyOptions);
            }
            else
            {
                await JS.InvokeVoidAsync("financeCharts.destroy", "forecastChart");
            }
        }
        catch (Exception ex) { Console.Error.WriteLine($"Chart failed (forecast render): {ex.Message}"); }
    }

}

@page "/products"
@implements IDisposable
@inject HttpClient Http
@inject LocalFinanceStore Store
@inject ToastService Toast

<PageTitle>Products</PageTitle>

<div class="workspace-page">
    <section class="workspace-hero workspace-hero--catalog">
        <div class="workspace-hero-copy">
            <span class="workspace-kicker">Retail catalog</span>
            <h1 class="workspace-title">Products</h1>
            <p class="workspace-description">Maintain the retail catalog, keep pricing tidy, and spot stock items that need attention before the next sale.</p>
        </div>
        <div class="workspace-hero-actions">
            <div class="workspace-action-row">
                <button class="btn btn-primary" @onclick="OpenAddModal">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="me-1"><path d="M12 5v14M5 12h14" /></svg>
                    Add product
                </button>
            </div>
        </div>
    </section>

    @if (products == null)
    {
        <LoadingSpinner />
    }
    else
    {
        <div class="workspace-summary-grid">
            <div class="workspace-summary-card">
                <span class="workspace-summary-label">Products</span>
                <strong>@products.Count</strong>
                <p>Total retail items currently available in the catalog.</p>
            </div>
            <div class="workspace-summary-card">
                <span class="workspace-summary-label">Low stock</span>
                <strong>@products.Count(p => p.StockQuantity <= 3)</strong>
                <p>Items with three or fewer units remaining.</p>
            </div>
            <div class="workspace-summary-card">
                <span class="workspace-summary-label">Average price</span>
                <strong>@(products.Count > 0 ? products.Average(p => p.Price).ToString("C") : "$0.00")</strong>
                <p>Typical shelf price across the retail assortment.</p>
            </div>
            <div class="workspace-summary-card">
                <span class="workspace-summary-label">Categories</span>
                <strong>@products.Select(p => p.Category).Where(category => !string.IsNullOrWhiteSpace(category)).Distinct(StringComparer.OrdinalIgnoreCase).Count()</strong>
                <p>Named product groupings in the current catalog.</p>
            </div>
        </div>

        @if (products.Count == 0)
        {
            <div class="workspace-empty-state">
                <p>No products yet. Add the first retail item to start building the catalog.</p>
            </div>
        }
        else
        {
            <section class="workspace-panel">
                <div class="workspace-panel-header workspace-panel-header-split">
                    <div>
                        <p class="workspace-panel-eyebrow">Catalog</p>
                        <h2>Retail product list</h2>
                        <p>Keep names, categories, pricing, and stock levels accurate for front-desk sales.</p>
                    </div>
                    <span class="workspace-badge">@products.Count product@(products.Count == 1 ? "" : "s")</span>
                </div>
                <div class="table-responsive">
                    <table class="data-table workspace-table">
                        <thead>
                            <tr>
                                <th>Product Name</th>
                                <th>Category</th>
                                <th>Price</th>
                                <th>Stock</th>
                                <th class="workspace-table-actions">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var p in products)
                            {
                                <tr>
                                    <td class="fw-semibold">@p.Name</td>
                                    <td class="text-muted">@(p.Category ?? "—")</td>
                                    <td>@p.Price.ToString("C")</td>
                                    <td>
                                        @if (p.StockQuantity <= 3)
                                        {
                                            <span class="badge bg-danger">@p.StockQuantity</span>
                                        }
                                        else
                                        {
                                            <span>@p.StockQuantity</span>
                                        }
                                    </td>
                                    <td class="workspace-table-actions">
                                        <button class="btn btn-sm btn-outline-secondary me-1" @onclick="() => OpenEditModal(p)">Edit</button>
                                        <button class="btn btn-sm btn-outline-danger" @onclick="() => ConfirmDelete(p)">Delete</button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </section>
        }
    }
</div>

@if (showModal)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.4);">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">@(isEditing ? "Edit Product" : "Add Product")</h5>
                    <button type="button" class="btn-close" @onclick="CloseModal"></button>
                </div>
                <EditForm Model="@formModel" OnValidSubmit="HandleSubmit">
                    <DataAnnotationsValidator />
                    <div class="modal-body">
                        <div class="mb-3">
                            <label class="form-label">Product Name</label>
                            <InputText class="form-control" @bind-Value="formModel.Name" />
                            <ValidationMessage For="() => formModel.Name" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Category</label>
                            <InputText class="form-control" @bind-Value="formModel.Category" placeholder="e.g. Hair Care, Styling, Tools" />
                        </div>
                        <div class="row g-3">
                            <div class="col-6">
                                <label class="form-label">Price</label>
                                <InputNumber class="form-control" @bind-Value="formModel.Price" />
                                <ValidationMessage For="() => formModel.Price" />
                            </div>
                            <div class="col-6">
                                <label class="form-label">Stock Quantity</label>
                                <InputNumber class="form-control" @bind-Value="formModel.StockQuantity" />
                                <ValidationMessage For="() => formModel.StockQuantity" />
                            </div>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" @onclick="CloseModal">Cancel</button>
                        <button type="submit" class="btn btn-primary" disabled="@saving">
                            @(saving ? "Saving..." : (isEditing ? "Update" : "Add"))
                        </button>
                    </div>
                </EditForm>
            </div>
        </div>
    </div>
}

<ConfirmDialog IsVisible="showDeleteConfirm"
               Title="Delete Product"
               Message="@($"Are you sure you want to delete {deleteTarget?.Name}?")"
               ConfirmText="Delete"
               OnConfirm="HandleDelete"
               OnCancel="() => { showDeleteConfirm = false; }" />

@code {
    private List<Product>? products;
    private Product formModel = new();
    private Product? deleteTarget;
    private bool showModal, isEditing, saving, showDeleteConfirm;
    private int editId;

    protected override async Task OnInitializedAsync()
    {
        Store.OnChange += HandleStoreChanged;
        await LoadProducts();
    }

    private async Task LoadProducts()
    {
        products = await Http.GetFromJsonAsync<List<Product>>("api/products");
    }

    private void OpenAddModal()
    {
        formModel = new Product();
        isEditing = false;
        showModal = true;
    }

    private void OpenEditModal(Product p)
    {
        formModel = new Product { Id = p.Id, Name = p.Name, Price = p.Price, StockQuantity = p.StockQuantity, Category = p.Category };
        editId = p.Id;
        isEditing = true;
        showModal = true;
    }

    private void CloseModal() => showModal = false;

    private async Task HandleSubmit()
    {
        saving = true;
        try
        {
            if (isEditing)
            {
                var resp = await Http.PutAsJsonAsync($"api/products/{editId}", formModel);
                if (resp.IsSuccessStatusCode) Toast.Show("Product updated");
                else Toast.Show("Failed to update product", ToastLevel.Error);
            }
            else
            {
                var resp = await Http.PostAsJsonAsync("api/products", formModel);
                if (resp.IsSuccessStatusCode) Toast.Show("Product added");
                else Toast.Show("Failed to add product", ToastLevel.Error);
            }
            await LoadProducts();
            showModal = false;
        }
        finally { saving = false; }
    }

    private void ConfirmDelete(Product p)
    {
        deleteTarget = p;
        showDeleteConfirm = true;
    }

    private async Task HandleDelete()
    {
        if (deleteTarget == null) return;
        var resp = await Http.DeleteAsync($"api/products/{deleteTarget.Id}");
        if (resp.IsSuccessStatusCode) Toast.Show("Product deleted");
        else Toast.Show(await ReadErrorMessageAsync(resp, "Failed to delete product."), ToastLevel.Error);
        showDeleteConfirm = false;
        deleteTarget = null;
        await LoadProducts();
    }

    private async Task<string> ReadErrorMessageAsync(HttpResponseMessage response, string fallback)
    {
        try
        {
            var error = await response.Content.ReadFromJsonAsync<ApiError>();
            return string.IsNullOrWhiteSpace(error?.Message) ? fallback : error.Message;
        }
        catch
        {
            return fallback;
        }
    }

    private sealed record ApiError(string? Message);

    private async void HandleStoreChanged()
    {
        await InvokeAsync(async () =>
        {
            await LoadProducts();
            StateHasChanged();
        });
    }

    public void Dispose()
    {
        Store.OnChange -= HandleStoreChanged;
    }
}

@page "/products"
@implements IDisposable
@inject IFinanceService Finance
@inject ToastService Toast
@inject ExportService Export

<PageTitle>@L["productsPageTitle"]</PageTitle>

<div class="workspace-page">
    <section class="workspace-hero workspace-hero--catalog">
        <div class="workspace-hero-copy">
            <span class="workspace-kicker">@L["productsKicker"]</span>
            <h1 class="workspace-title">@L["productsTitle"]</h1>
            <p class="workspace-description">@L["productsDescription"]</p>
        </div>
        <div class="workspace-hero-actions">
            <div class="workspace-action-row">
                <button class="btn btn-primary" @onclick="OpenAddModal">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="me-1"><path d="M12 5v14M5 12h14" /></svg>
                    @L["productsAddButton"]
                </button>
            </div>
        </div>
    </section>

    @if (products == null)
    {
        <LoadingSpinner />
    }
    else
    {
        <div class="workspace-summary-grid">
            <div class="workspace-summary-card">
                <span class="workspace-summary-label">@L["productsSummaryLabel"]</span>
                <strong>@products.Count</strong>
                <p>@L["productsSummaryDesc"]</p>
            </div>
            <div class="workspace-summary-card">
                <span class="workspace-summary-label">@L["productsSummaryLowStock"]</span>
                <strong>@products.Count(p => p.StockQuantity <= 3)</strong>
                <p>@L["productsSummaryLowStockDesc"]</p>
            </div>
            <div class="workspace-summary-card">
                <span class="workspace-summary-label">@L["productsSummaryAvgPrice"]</span>
                <strong>@(products.Count > 0 ? products.Average(p => p.Price).ToString("C") : "$0.00")</strong>
                <p>@L["productsSummaryAvgPriceDesc"]</p>
            </div>
            <div class="workspace-summary-card">
                <span class="workspace-summary-label">@L["productsSummaryCategories"]</span>
                <strong>@products.Select(p => p.Category).Where(category => !string.IsNullOrWhiteSpace(category)).Distinct(StringComparer.OrdinalIgnoreCase).Count()</strong>
                <p>@L["productsSummaryCategoriesDesc"]</p>
            </div>
        </div>

        @if (products.Count == 0)
        {
            <div class="workspace-empty-state">
                <p>@L["productsEmpty"]</p>
            </div>
        }
        else
        {
            <section class="workspace-panel">
                <div class="workspace-panel-header workspace-panel-header-split">
                    <div>
                        <p class="workspace-panel-eyebrow">@L["productsPanelEyebrow"]</p>
                        <h2>@L["productsPanelTitle"]</h2>
                        <p>@L["productsPanelDesc"]</p>
                    </div>
                    <span class="workspace-badge">@products.Count product@(products.Count == 1 ? "" : "s")</span>
                    <div class="d-flex gap-2 ms-2">
                        <button class="btn btn-sm btn-outline-success" @onclick="ExportExcel" disabled="@exporting">
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="me-1"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/></svg>
                            @L["commonExcel"]
                        </button>
                        <button class="btn btn-sm btn-outline-danger" @onclick="ExportPdf" disabled="@exporting">
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="me-1"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/></svg>
                            @L["commonPdf"]
                        </button>
                    </div>
                </div>
                <div class="table-responsive">
                    <table class="data-table workspace-table">
                        <thead>
                            <tr>
                                <th>@L["productsThName"]</th>
                                <th>@L["productsThCategory"]</th>
                                <th>@L["productsThPrice"]</th>
                                <th>@L["productsThStock"]</th>
                                <th class="workspace-table-actions">@L["productsThActions"]</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var p in products)
                            {
                                <tr>
                                    <td class="fw-semibold">@p.Name</td>
                                    <td class="text-muted">@(p.Category ?? "—")</td>
                                    <td>@p.Price.ToString("C")</td>
                                    <td>
                                        @if (p.StockQuantity <= 3)
                                        {
                                            <span class="badge bg-danger">@p.StockQuantity</span>
                                        }
                                        else
                                        {
                                            <span>@p.StockQuantity</span>
                                        }
                                    </td>
                                    <td class="workspace-table-actions">
                                        <button class="btn btn-sm btn-outline-secondary me-1" @onclick="() => OpenEditModal(p)">@L["commonEdit"]</button>
                                        <button class="btn btn-sm btn-outline-danger" @onclick="() => ConfirmDelete(p)">@L["commonDelete"]</button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </section>
        }
    }
</div>

@if (showModal)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.4);">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">@(isEditing ? L["productsModalTitleEdit"] : L["productsModalTitleAdd"])</h5>
                    <button type="button" class="btn-close" @onclick="CloseModal"></button>
                </div>
                <EditForm Model="@formModel" OnValidSubmit="HandleSubmit">
                    <DataAnnotationsValidator />
                    <div class="modal-body">
                        <div class="mb-3">
                            <label class="form-label">@L["productsModalLabelName"]</label>
                            <InputText class="form-control" @bind-Value="formModel.Name" />
                            <ValidationMessage For="() => formModel.Name" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label">@L["productsModalLabelCategory"]</label>
                            <InputText class="form-control" @bind-Value="formModel.Category" placeholder="@L["productsModalCategoryPlaceholder"]" />
                        </div>
                        <div class="row g-3">
                            <div class="col-6">
                                <label class="form-label">@L["productsModalLabelPrice"]</label>
                                <InputNumber class="form-control" @bind-Value="formModel.Price" />
                                <ValidationMessage For="() => formModel.Price" />
                            </div>
                            <div class="col-6">
                                <label class="form-label">@L["productsModalLabelStock"]</label>
                                <InputNumber class="form-control" @bind-Value="formModel.StockQuantity" />
                                <ValidationMessage For="() => formModel.StockQuantity" />
                            </div>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" @onclick="CloseModal">@L["productsModalCancel"]</button>
                        <button type="submit" class="btn btn-primary" disabled="@saving">
                            @(saving ? L["productsModalSaving"] : (isEditing ? L["productsModalUpdate"] : L["productsModalAdd"]))
                        </button>
                    </div>
                </EditForm>
            </div>
        </div>
    </div>
}

<ConfirmDialog IsVisible="showDeleteConfirm"
               Title="@L["productsDeleteTitle"]"
               Message="@(L.T("productsDeleteMsg", deleteTarget?.Name ?? ""))"
               ConfirmText="@L["commonDelete"]"
               OnConfirm="HandleDelete"
               OnCancel="() => { showDeleteConfirm = false; }" />

@code {
    private List<Product>? products;
    private Product formModel = new();
    private Product? deleteTarget;
    private bool showModal, isEditing, saving, showDeleteConfirm;
    private int editId;
    private bool exporting;

    private async Task ExportExcel()
    {
        if (products == null) return;
        exporting = true;
        try
        {
            var headers = new[] { "Name", "Category", "Price", "Stock" };
            var rows = products.Select(p => new object[]
            {
                p.Name, p.Category ?? "", p.Price, p.StockQuantity
            }).ToArray();
            await Export.ExportExcelAsync("products.xlsx", "Products", headers, rows);
        }
        catch { Toast.Show(L["commonExportFailed"], ToastLevel.Error); }
        finally { exporting = false; }
    }

    private async Task ExportPdf()
    {
        if (products == null) return;
        exporting = true;
        try
        {
            var headers = new[] { "Name", "Category", "Price", "Stock" };
            var rows = products.Select(p => new object[]
            {
                p.Name, p.Category ?? "", p.Price.ToString("F2"), p.StockQuantity
            }).ToArray();
            await Export.ExportPdfAsync("products.pdf", "Product Catalog", headers, rows);
        }
        catch { Toast.Show(L["commonExportFailed"], ToastLevel.Error); }
        finally { exporting = false; }
    }

    protected override async Task OnInitializedAsync()
    {
        Finance.OnChange += HandleStoreChanged;
        await LoadProducts();
    }

    private async Task LoadProducts()
    {
        products = (await Finance.GetProductsAsync()).ToList();
    }

    private void OpenAddModal()
    {
        formModel = new Product();
        isEditing = false;
        showModal = true;
    }

    private void OpenEditModal(Product p)
    {
        formModel = new Product { Id = p.Id, Name = p.Name, Price = p.Price, StockQuantity = p.StockQuantity, Category = p.Category };
        editId = p.Id;
        isEditing = true;
        showModal = true;
    }

    private void CloseModal() => showModal = false;

    private async Task HandleSubmit()
    {
        saving = true;
        try
        {
            if (isEditing)
            {
                await Finance.UpdateProductAsync(editId, formModel);
                Toast.Show(L["productsToastUpdated"]);
            }
            else
            {
                await Finance.AddProductAsync(formModel);
                Toast.Show(L["productsToastAdded"]);
            }
            await LoadProducts();
            showModal = false;
        }
        catch (Exception ex)
        {
            Toast.Show(ex is InvalidDataException ? ex.Message : L["productsToastFailed"], ToastLevel.Error);
        }
        finally { saving = false; }
    }

    private void ConfirmDelete(Product p)
    {
        deleteTarget = p;
        showDeleteConfirm = true;
    }

    private async Task HandleDelete()
    {
        if (deleteTarget == null) return;
        var result = await Finance.DeleteProductAsync(deleteTarget.Id);
        if (result.Success) Toast.Show(L["productsToastDeleted"]);
        else Toast.Show(result.ErrorMessage ?? L["productsToastDeleteFailed"], ToastLevel.Error);
        showDeleteConfirm = false;
        deleteTarget = null;
        await LoadProducts();
    }

    private async void HandleStoreChanged()
    {
        await InvokeAsync(async () =>
        {
            await LoadProducts();
            StateHasChanged();
        });
    }

    public void Dispose()
    {
        Finance.OnChange -= HandleStoreChanged;
    }
}

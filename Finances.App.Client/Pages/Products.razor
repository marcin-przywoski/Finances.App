@page "/products"
@inherits CrudPageBase<Product>
@inject IFinanceStore Store
@inject MoneyFormat Money

<PageTitle>Products</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="page-title mb-1">Products</h1>
        <p class="text-muted mb-0">Manage retail products your shop sells (shampoo, styling products, etc.).</p>
    </div>
    <button class="btn btn-primary" @onclick="OpenAddModal">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="me-1" aria-hidden="true"><path d="M12 5v14M5 12h14"/></svg>
        Add Product
    </button>
</div>

@if (items == null)
{
    <LoadingSpinner />
}
else if (items.Count == 0)
{
    <div class="card p-5 text-center">
        <p class="text-muted mb-3">No products yet. Add your first product to get started.</p>
        <div><button class="btn btn-primary" @onclick="OpenAddModal">Add Product</button></div>
    </div>
}
else
{
    <div class="card">
        <div class="table-responsive">
            <table class="table table-hover mb-0">
                <thead>
                    <tr>
                        <th>Product Name</th>
                        <th>Category</th>
                        <th>Price</th>
                        <th>Stock</th>
                        <th style="width: 140px;">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var p in items)
                    {
                        <tr>
                            <td class="fw-semibold">@p.Name</td>
                            <td class="text-muted">@(p.Category ?? "—")</td>
                            <td>@Money.Format(p.Price)</td>
                            <td>
                                @if (p.StockQuantity <= 3)
                                {
                                    <span class="badge bg-danger">@p.StockQuantity — low stock</span>
                                }
                                else
                                {
                                    <span>@p.StockQuantity</span>
                                }
                            </td>
                            <td>
                                <button class="btn btn-sm btn-outline-secondary me-1" @onclick="() => OpenEditModal(p)">Edit</button>
                                <button class="btn btn-sm btn-outline-danger" @onclick="() => ConfirmDelete(p)">Delete</button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}

<ModalDialog IsVisible="showModal" Title="@(isEditing ? "Edit Product" : "Add Product")" OnClose="CloseModal">
    <EditForm Model="@formModel" OnValidSubmit="HandleSubmit">
        <DataAnnotationsValidator />
        <div class="modal-body">
            <div class="mb-3">
                <label class="form-label" for="product-name">Product Name</label>
                <InputText id="product-name" class="form-control" @bind-Value="formModel.Name" />
                <ValidationMessage For="() => formModel.Name" />
            </div>
            <div class="mb-3">
                <label class="form-label" for="product-category">Category</label>
                <InputText id="product-category" class="form-control" @bind-Value="formModel.Category" placeholder="e.g. Hair Care, Styling, Tools" />
            </div>
            <div class="row g-3">
                <div class="col-6">
                    <label class="form-label" for="product-price">Price</label>
                    <InputNumber id="product-price" class="form-control" @bind-Value="formModel.Price" />
                    <ValidationMessage For="() => formModel.Price" />
                </div>
                <div class="col-6">
                    <label class="form-label" for="product-stock">Stock Quantity</label>
                    <InputNumber id="product-stock" class="form-control" @bind-Value="formModel.StockQuantity" />
                    <ValidationMessage For="() => formModel.StockQuantity" />
                </div>
            </div>
        </div>
        <div class="modal-footer">
            <button type="button" class="btn btn-secondary" @onclick="CloseModal">Cancel</button>
            <button type="submit" class="btn btn-primary" disabled="@saving">
                @(saving ? "Saving..." : (isEditing ? "Update" : "Add"))
            </button>
        </div>
    </EditForm>
</ModalDialog>

<ConfirmDialog IsVisible="showDeleteConfirm"
               Title="Delete Product"
               Message="@($"Are you sure you want to delete {deleteTarget?.Name}?")"
               ConfirmText="Delete"
               OnConfirm="HandleDelete"
               OnCancel="() => { showDeleteConfirm = false; }" />

@code {
    protected override string EntityName => "Product";

    protected override async Task<IReadOnlyList<Product>> LoadItemsAsync() => await Store.GetProductsAsync();

    protected override Task AddItemAsync(Product item) => Store.AddProductAsync(item);

    protected override Task UpdateItemAsync(int id, Product item) => Store.UpdateProductAsync(id, item);

    protected override async Task<DeleteResult> DeleteItemAsync(Product item)
    {
        await Store.DeleteProductAsync(item.Id);
        return new DeleteResult(true);
    }

    protected override int GetId(Product item) => item.Id;

    protected override Product CloneItem(Product item) => new()
    {
        Id = item.Id,
        Name = item.Name,
        Price = item.Price,
        StockQuantity = item.StockQuantity,
        Category = item.Category
    };
}

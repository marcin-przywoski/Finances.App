@page "/data"
@implements IDisposable
@inject IFinanceStore Store
@inject WorkerContextService WorkerContext
@inject IJSRuntime JS
@inject NavigationManager Navigation
@inject PwaUpdateService PwaUpdate
@inject ToastService Toast
@inject IStringLocalizer<AppStrings> L

<PageTitle>@L["Data_Title"]</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="page-title mb-1">@L["Data_Title"]</h1>
        <p class="text-muted mb-0">@L["Data_Subtitle"]</p>
    </div>
</div>

@if (summary is null)
{
    <LoadingSpinner />
}
else
{
    <div class="row g-3 mb-4">
        <div class="col-sm-6 col-xl-3">
            <StatCard Value="@summary.WorkerCount.ToString()" Label="@L["Data_Workers"]" Variant="StatCardVariant.Info">
                <IconContent>
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/></svg>
                </IconContent>
            </StatCard>
        </div>
        <div class="col-sm-6 col-xl-3">
            <StatCard Value="@summary.ServiceCount.ToString()" Label="@L["Data_Services"]" Variant="StatCardVariant.Warning">
                <IconContent>
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"/></svg>
                </IconContent>
            </StatCard>
        </div>
        <div class="col-sm-6 col-xl-3">
            <StatCard Value="@summary.ProductCount.ToString()" Label="@L["Data_Products"]" Variant="StatCardVariant.Purple">
                <IconContent>
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/><polyline points="3.27 6.96 12 12.01 20.73 6.96"/><line x1="12" y1="22.08" x2="12" y2="12"/></svg>
                </IconContent>
            </StatCard>
        </div>
        <div class="col-sm-6 col-xl-3">
            <StatCard Value="@summary.ServiceRecordCount.ToString()" Label="@L["Data_RecordedServices"]" Variant="StatCardVariant.Success">
                <IconContent>
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"/></svg>
                </IconContent>
            </StatCard>
        </div>
        <div class="col-sm-6 col-xl-3">
            <StatCard Value="@summary.ProductSaleCount.ToString()" Label="@L["Data_ProductSales"]" Variant="StatCardVariant.Pink">
                <IconContent>
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"/><line x1="3" y1="6" x2="21" y2="6"/><path d="M16 10a4 4 0 0 1-8 0"/></svg>
                </IconContent>
            </StatCard>
        </div>
        <div class="col-sm-6 col-xl-3">
            <StatCard Value="@summary.ExpenseCount.ToString()" Label="@L["Data_Expenses"]" Variant="StatCardVariant.Danger">
                <IconContent>
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="7" width="20" height="14" rx="2"/><path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"/></svg>
                </IconContent>
            </StatCard>
        </div>
    </div>

    @if (quarantinedJson is not null)
    {
        <div class="alert alert-warning mb-4" role="alert">
            <h6 class="fw-semibold mb-2">@L["Data_QuarantineTitle"]</h6>
            <p class="mb-2">
                @L["Data_QuarantineBody"]
            </p>
            <div class="d-flex flex-wrap gap-2">
                <button class="btn btn-sm btn-primary" @onclick="DownloadQuarantineAsync" disabled="@busy">@L["Data_QuarantineDownload"]</button>
                <button class="btn btn-sm btn-outline-secondary" @onclick="DismissQuarantineAsync" disabled="@busy">@L["Data_QuarantineDismiss"]</button>
            </div>
        </div>
    }

    <div class="card p-4 mb-4">
        <h6 class="fw-semibold mb-2">@L["Data_Preferences"]</h6>
        <div class="row g-3 align-items-end">
            <div class="col-sm-6 col-lg-4">
                <label class="form-label" for="settings-currency">@L["Data_Currency"]</label>
                <select id="settings-currency" class="form-select" value="@currencyCode" @onchange="OnCurrencyChangedAsync" disabled="@busy">
                    <option value="">@L["Data_BrowserDefault"]</option>
                    @foreach (var option in MoneyFormat.SupportedCurrencies)
                    {
                        <option value="@option.Code">@option.Code (@option.Symbol)</option>
                    }
                </select>
            </div>
            <div class="col-sm-6 col-lg-4">
                <label class="form-label" for="settings-language">@L["Data_Language"]</label>
                <select id="settings-language" class="form-select" value="@languageCode" @onchange="OnLanguageChangedAsync" disabled="@busy">
                    <option value="">@L["Data_LanguageAuto"]</option>
                    <option value="pl">Polski</option>
                    <option value="en">English</option>
                </select>
            </div>
            <div class="col-lg-4">
                <p class="text-muted small mb-2">@L["Data_CurrencyHint"] @L["Data_LanguageHint"]</p>
            </div>
        </div>
    </div>

    <div class="row g-3">
        <div class="col-lg-7">
            <div class="card p-4 h-100">
                <h6 class="fw-semibold mb-3">@L["Data_BackupTitle"]</h6>
                <p class="text-muted mb-3">
                    @L["Data_BackupBody"]
                </p>
                <div class="d-flex flex-wrap gap-2 align-items-center">
                    <button class="btn btn-primary" @onclick="ExportAsync" disabled="@busy">@(busy ? L["Common_Working"] : L["Data_ExportJson"])</button>
                    <label class="btn btn-outline-primary mb-0 @(busy ? "disabled" : string.Empty)">
                        @L["Data_ImportJson"]
                        <InputFile OnChange="ImportAsync" accept=".json,application/json" class="d-none" disabled="@busy" />
                    </label>
                    <button class="btn btn-outline-danger" @onclick="() => showResetConfirm = true" disabled="@busy">@L["Data_EraseAll"]</button>
                </div>
                @if (preResetAvailable)
                {
                    <div class="d-flex flex-wrap gap-2 align-items-center mt-2">
                        <button class="btn btn-outline-secondary btn-sm" @onclick="() => showRestoreConfirm = true" disabled="@busy" data-testid="restore-previous">
                            @L["Data_RestorePrevious"]
                        </button>
                        <span class="text-muted small">@L["Data_RestoreHint"]</span>
                    </div>
                }
                <p class="mb-0 mt-3 small @(IsStorageNearlyFull ? "text-danger fw-semibold" : "text-muted")">
                    @L["Data_StorageUsed", FormatStorageSize(summary.ApproximateSizeChars)]
                    @if (IsStorageNearlyFull)
                    {
                        <span> @L["Data_StorageFull"]</span>
                    }
                </p>

                <hr class="my-3" />

                <h6 class="fw-semibold mb-2">@L["Data_AccountantTitle"]</h6>
                <p class="text-muted mb-3 small">
                    @L["Data_AccountantBody"]
                </p>
                <div class="d-flex flex-wrap gap-2 align-items-center">
                    <button class="btn btn-outline-primary btn-sm" @onclick="ExportServiceRecordsCsvAsync" disabled="@busy">@L["Data_CsvServices"]</button>
                    <button class="btn btn-outline-primary btn-sm" @onclick="ExportSalesCsvAsync" disabled="@busy">@L["Data_CsvSales"]</button>
                    <button class="btn btn-outline-primary btn-sm" @onclick="ExportExpensesCsvAsync" disabled="@busy">@L["Data_CsvExpenses"]</button>
                </div>
            </div>
        </div>

        <div class="col-lg-5">
            <div class="card p-4 h-100">
                <div class="d-flex flex-wrap justify-content-between align-items-start gap-3 mb-3">
                    <div>
                        <h6 class="fw-semibold mb-1">@L["Data_UpdatesTitle"]</h6>
                        <p class="text-muted mb-0">@L["Data_UpdatesBody"]</p>
                    </div>
                    <span class="badge rounded-pill @(PwaUpdate.State.UpdateAvailable ? "text-bg-primary" : "text-bg-secondary")">@GetPwaStatusLabel()</span>
                </div>

                <dl class="row mb-3 small">
                    <dt class="col-5 text-muted">@L["Data_InstalledBuild"]</dt>
                    <dd class="col-7 fw-semibold" data-testid="installed-build">@GetBuildLabel()</dd>

                    <dt class="col-5 text-muted">@L["Data_AvailableBuild"]</dt>
                    <dd class="col-7" data-testid="available-build">@GetAvailableBuildLabel()</dd>

                    <dt class="col-5 text-muted">@L["Data_LastChecked"]</dt>
                    <dd class="col-7">@FormatDateTime(PwaUpdate.State.LastCheckedUtc)</dd>

                    <dt class="col-5 text-muted">@L["Data_LastApplied"]</dt>
                    <dd class="col-7">@FormatDateTime(PwaUpdate.State.LastAppliedUpdateUtc)</dd>

                    <dt class="col-5 text-muted">@L["Data_BackupSchema"]</dt>
                    <dd class="col-7">v@(summary.SchemaVersion)</dd>
                </dl>

                @if (!string.IsNullOrWhiteSpace(PwaUpdate.State.InstallError))
                {
                    <div class="alert alert-warning py-2 small" role="alert">
                        @L["Data_InstallError", PwaUpdate.State.InstallError!]
                    </div>
                }

                <div class="d-flex flex-wrap gap-2 align-items-center mb-3">
                    <button class="btn btn-outline-primary" @onclick="CheckForUpdatesAsync" disabled="@(busy || pwaBusy)">@(pwaBusy ? L["Data_Checking"] : L["Data_CheckUpdates"])</button>

                    @if (PwaUpdate.State.UpdateAvailable)
                    {
                        <button class="btn btn-primary" @onclick="ApplyUpdateAsync" disabled="@(busy || pwaBusy)">@L["Data_ReloadToUpdate"]</button>
                    }

                    @if (PwaUpdate.State.InstallAvailable && !PwaUpdate.State.IsStandalone)
                    {
                        <button class="btn btn-outline-secondary" @onclick="PromptInstallAsync" disabled="@(busy || pwaBusy)">@L["Data_InstallApp"]</button>
                    }
                </div>

                @if (GetDisplayedRelease() is { } release)
                {
                    <div class="border rounded-3 p-3 bg-body-tertiary mb-3">
                        <div class="d-flex flex-wrap justify-content-between align-items-start gap-2 mb-2">
                            <div>
                                <h6 class="fw-semibold mb-1">@GetReleaseHeading()</h6>
                                @if (!string.IsNullOrWhiteSpace(release.Title))
                                {
                                    <p class="mb-1 fw-semibold">@release.Title</p>
                                }
                            </div>

                            @if (release.PublishedUtc is not null)
                            {
                                <span class="small text-muted">@release.PublishedUtc.Value.ToLocalTime().ToString("yyyy-MM-dd")</span>
                            }
                        </div>

                        @if (!string.IsNullOrWhiteSpace(release.Summary))
                        {
                            <p class="text-muted mb-2">@release.Summary</p>
                        }

                        @if (release.Changes.Count > 0)
                        {
                            <ul class="mb-0 text-muted" style="padding-left: 1rem;">
                                @foreach (var change in release.Changes)
                                {
                                    <li>@change</li>
                                }
                            </ul>
                        }
                    </div>
                }

                <h6 class="fw-semibold mb-3">@L["Data_PrivacyTitle"]</h6>
                <ul class="mb-0 text-muted" style="padding-left: 1rem;">
                    <li>@L["Data_Privacy1"]</li>
                    <li>@L["Data_Privacy2"]</li>
                    <li>@L["Data_Privacy3"]</li>
                    <li>@L["Data_Privacy4"]</li>
                    <li>@L["Data_Privacy5"] <strong>@summary.LastUpdatedUtc.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</strong></li>
                </ul>
            </div>
        </div>
    </div>
}

<ConfirmDialog IsVisible="showResetConfirm"
               Title="@L["Data_EraseTitle"]"
               Message="@L["Data_EraseMessage"]"
               ConfirmText="@L["Data_EraseConfirm"]"
               OnConfirm="HandleResetAsync"
               OnCancel="() => showResetConfirm = false" />

<ConfirmDialog IsVisible="showRestoreConfirm"
               Title="@L["Data_RestoreTitle"]"
               Message="@L["Data_RestoreMessage"]"
               ConfirmText="@L["Data_RestoreConfirm"]"
               OnConfirm="HandleRestorePreviousAsync"
               OnCancel="() => showRestoreConfirm = false" />


@code {
    // localStorage quotas are ~5 MB of UTF-16 units in mainstream browsers;
    // warn well before the hard failure.
    private const int StorageWarningChars = 4_000_000;

    private DataStateSummary? summary;
    private string? quarantinedJson;
    private string currencyCode = string.Empty;
    private string languageCode = string.Empty;
    private bool preResetAvailable;
    private bool busy;
    private bool pwaBusy;
    private bool showResetConfirm;
    private bool showRestoreConfirm;

    private bool IsStorageNearlyFull => summary is not null && summary.ApproximateSizeChars > StorageWarningChars;

    protected override async Task OnInitializedAsync()
    {
        PwaUpdate.OnChange += HandlePwaStateChanged;
        await RefreshSummaryAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        await PwaUpdate.EnsureInitializedAsync();
    }

    private async Task RefreshSummaryAsync()
    {
        summary = await Store.GetDataStateSummaryAsync();
        quarantinedJson = await Store.GetQuarantinedJsonAsync();
        var settings = await Store.GetSettingsAsync();
        currencyCode = settings.CurrencyCode ?? string.Empty;
        languageCode = settings.Language ?? string.Empty;
        preResetAvailable = !string.IsNullOrWhiteSpace(await Store.GetPreResetJsonAsync());
    }

    private async Task OnLanguageChangedAsync(ChangeEventArgs e)
    {
        var code = e.Value?.ToString() ?? string.Empty;

        try
        {
            var settings = await Store.GetSettingsAsync();
            settings.Language = string.IsNullOrEmpty(code) ? null : code;
            await Store.UpdateSettingsAsync(settings);
            languageCode = code;
            // The culture is applied at boot, so a full reload switches the UI.
            Navigation.NavigateTo(Navigation.Uri, forceLoad: true);
        }
        catch (Exception ex)
        {
            Toast.Show(UserFacingError.Message(ex), ToastLevel.Error);
        }
    }

    private async Task OnCurrencyChangedAsync(ChangeEventArgs e)
    {
        var code = e.Value?.ToString() ?? string.Empty;

        try
        {
            var settings = await Store.GetSettingsAsync();
            settings.CurrencyCode = string.IsNullOrEmpty(code) ? null : code;
            await Store.UpdateSettingsAsync(settings);
            currencyCode = code;
            Toast.Show(L["Data_ToastCurrencySaved"]);
        }
        catch (Exception ex)
        {
            Toast.Show(UserFacingError.Message(ex), ToastLevel.Error);
        }
    }

    private async Task DownloadQuarantineAsync()
    {
        if (quarantinedJson is null)
        {
            return;
        }

        try
        {
            var fileName = $"finances-app-preserved-{DateTime.Now:yyyyMMdd-HHmmss}.json";
            await JS.InvokeVoidAsync("financeBrowser.downloadTextFile", fileName, "application/json;charset=utf-8", quarantinedJson);
            Toast.Show(L["Data_ToastQuarantineDownloaded"]);
        }
        catch (Exception ex)
        {
            Toast.Show(ex.Message, ToastLevel.Error);
        }
    }

    private async Task DismissQuarantineAsync()
    {
        try
        {
            await Store.ClearQuarantineAsync();
            quarantinedJson = null;
            Toast.Show(L["Data_ToastQuarantineRemoved"]);
        }
        catch (Exception ex)
        {
            Toast.Show(ex.Message, ToastLevel.Error);
        }
    }

    private string FormatStorageSize(int chars)
    {
        return chars >= 1024 * 1024
            ? string.Format(System.Globalization.CultureInfo.CurrentCulture, L["Data_StorageOf5MB"], $"{chars / (1024.0 * 1024.0):0.0} MB")
            : string.Format(System.Globalization.CultureInfo.CurrentCulture, L["Data_StorageOf5MB"], $"{chars / 1024.0:0} KB");
    }

    private async Task ExportAsync()
    {
        if (busy)
        {
            return;
        }

        busy = true;
        try
        {
            var json = await Store.ExportAsync();
            var fileName = $"finances-app-{DateTime.Now:yyyyMMdd-HHmmss}.json";
            await ShareOrDownloadAsync(fileName, "application/json;charset=utf-8", json, L["Data_Backup"]);
            await RefreshSummaryAsync();
        }
        catch (Exception ex)
        {
            Toast.Show(ex.Message, ToastLevel.Error);
        }
        finally
        {
            busy = false;
        }
    }

    /// <summary>
    /// Mobile browsers (especially installed PWAs) get the native share sheet
    /// when files can be shared; everywhere else this is a plain download.
    /// </summary>
    private async Task ShareOrDownloadAsync(string fileName, string contentType, string content, string what)
    {
        var outcome = await JS.InvokeAsync<string>("financeBrowser.shareOrDownloadFile", fileName, contentType, content);
        switch (outcome)
        {
            case "shared":
                Toast.Show(L["Data_ToastShared", what]);
                break;
            case "downloaded":
                Toast.Show(L["Data_ToastExported", what]);
                break;
            // 'cancelled': the user closed the share sheet — no toast needed.
        }
    }

    private async Task ExportServiceRecordsCsvAsync()
    {
        if (busy)
        {
            return;
        }

        busy = true;
        try
        {
            var csv = CsvExport.BuildServiceRecordsCsv(await Store.GetServiceRecordsAsync());
            await ShareOrDownloadAsync($"finances-services-{DateTime.Now:yyyyMMdd}.csv", CsvExport.ContentType, csv, L["Data_CsvServices"]);
        }
        catch (Exception ex)
        {
            Toast.Show(ex.Message, ToastLevel.Error);
        }
        finally
        {
            busy = false;
        }
    }

    private async Task ExportSalesCsvAsync()
    {
        if (busy)
        {
            return;
        }

        busy = true;
        try
        {
            var csv = CsvExport.BuildProductSalesCsv(await Store.GetProductSalesAsync());
            await ShareOrDownloadAsync($"finances-sales-{DateTime.Now:yyyyMMdd}.csv", CsvExport.ContentType, csv, L["Data_CsvSales"]);
        }
        catch (Exception ex)
        {
            Toast.Show(ex.Message, ToastLevel.Error);
        }
        finally
        {
            busy = false;
        }
    }

    private async Task ExportExpensesCsvAsync()
    {
        if (busy)
        {
            return;
        }

        busy = true;
        try
        {
            var csv = CsvExport.BuildExpensesCsv(await Store.GetExpensesAsync());
            await ShareOrDownloadAsync($"finances-expenses-{DateTime.Now:yyyyMMdd}.csv", CsvExport.ContentType, csv, L["Data_CsvExpenses"]);
        }
        catch (Exception ex)
        {
            Toast.Show(ex.Message, ToastLevel.Error);
        }
        finally
        {
            busy = false;
        }
    }

    private async Task ImportAsync(InputFileChangeEventArgs args)
    {
        if (busy)
        {
            return;
        }

        var file = args.File;
        if (file is null)
        {
            return;
        }

        busy = true;
        try
        {
            using var stream = file.OpenReadStream(5 * 1024 * 1024);
            using var reader = new StreamReader(stream);
            var json = await reader.ReadToEndAsync();

            await Store.ImportAsync(json);
            await SyncSelectedWorkerAsync();
            await RefreshSummaryAsync();
            Toast.Show(L["Data_ToastImported"]);
        }
        catch (Exception ex)
        {
            Toast.Show(ex.Message, ToastLevel.Error);
        }
        finally
        {
            busy = false;
        }
    }

    private async Task HandleResetAsync()
    {
        showResetConfirm = false;

        if (busy)
        {
            return;
        }

        busy = true;
        try
        {
            await Store.ResetAsync();
            await SyncSelectedWorkerAsync();
            await RefreshSummaryAsync();
            Toast.Show(L["Data_ToastErased"]);
        }
        catch (Exception ex)
        {
            Toast.Show(ex.Message, ToastLevel.Error);
        }
        finally
        {
            busy = false;
        }
    }

    private async Task HandleRestorePreviousAsync()
    {
        showRestoreConfirm = false;

        if (busy)
        {
            return;
        }

        busy = true;
        try
        {
            var json = await Store.GetPreResetJsonAsync();
            if (string.IsNullOrWhiteSpace(json))
            {
                Toast.Show(L["Data_ToastNoPrevious"], ToastLevel.Error);
                return;
            }

            // Import writes its own pre-import backup of the current state, so
            // restoring is reversible too.
            await Store.ImportAsync(json);
            await SyncSelectedWorkerAsync();
            await RefreshSummaryAsync();
            Toast.Show(L["Data_ToastRestored"]);
        }
        catch (Exception ex)
        {
            Toast.Show(ex.Message, ToastLevel.Error);
        }
        finally
        {
            busy = false;
        }
    }

    private async Task SyncSelectedWorkerAsync()
    {
        var workers = await Store.GetWorkersAsync();
        await WorkerContext.EnsureWorkerExistsAsync(workers.Select(worker => worker.Id));
    }

    private async Task CheckForUpdatesAsync()
    {
        if (busy || pwaBusy)
        {
            return;
        }

        pwaBusy = true;

        try
        {
            var updateReady = await PwaUpdate.CheckForUpdatesAsync();
            Toast.Show(updateReady
                ? L["Data_ToastUpdateReady"]
                : L["Data_ToastUpToDate"]);
        }
        catch (Exception ex)
        {
            Toast.Show(ex.Message, ToastLevel.Error);
        }
        finally
        {
            pwaBusy = false;
        }
    }

    private async Task ApplyUpdateAsync()
    {
        if (busy || pwaBusy)
        {
            return;
        }

        pwaBusy = true;

        try
        {
            var updateStarted = await PwaUpdate.ApplyUpdateAsync();
            if (!updateStarted)
            {
                Toast.Show(L["Data_ToastNoUpdate"], ToastLevel.Error);
            }
        }
        catch (Exception ex)
        {
            Toast.Show(ex.Message, ToastLevel.Error);
        }
        finally
        {
            pwaBusy = false;
        }
    }

    private async Task PromptInstallAsync()
    {
        if (busy || pwaBusy)
        {
            return;
        }

        pwaBusy = true;

        try
        {
            var accepted = await PwaUpdate.PromptInstallAsync();
            if (!accepted)
            {
                Toast.Show(L["Data_ToastNoInstallPrompt"], ToastLevel.Error);
            }
        }
        catch (Exception ex)
        {
            Toast.Show(ex.Message, ToastLevel.Error);
        }
        finally
        {
            pwaBusy = false;
        }
    }

    private string GetPwaStatusLabel()
    {
        if (pwaBusy || PwaUpdate.State.IsCheckingForUpdates)
        {
            return L["Data_PwaChecking"];
        }

        if (PwaUpdate.State.UpdateAvailable)
        {
            return L["Data_PwaUpdateReady"];
        }

        if (PwaUpdate.State.JustUpdated)
        {
            return L["Data_PwaUpdated"];
        }

        return PwaUpdate.State.IsOfflineReady ? L["Data_PwaUpToDate"] : L["Data_PwaInitializing"];
    }

    private string GetBuildLabel()
    {
        return string.IsNullOrWhiteSpace(PwaUpdate.State.CurrentVersion)
            ? L["Data_Detecting"].Value
            : PwaUpdate.State.CurrentVersion!;
    }

    private string GetAvailableBuildLabel()
    {
        return string.IsNullOrWhiteSpace(PwaUpdate.State.AvailableVersion)
            ? L["Data_NoPendingUpdate"].Value
            : PwaUpdate.State.AvailableVersion!;
    }

    private PwaReleaseInfo? GetDisplayedRelease()
    {
        return PwaUpdate.State.AvailableRelease ?? PwaUpdate.State.InstalledRelease;
    }

    private string GetReleaseHeading()
    {
        return PwaUpdate.State.AvailableRelease is not null
            ? L["Data_WhatChanged"].Value
            : L["Data_CurrentRelease"].Value;
    }

    private string NotYetLabel => L["Data_NotYet"];

    private string FormatDateTime(DateTimeOffset? value)
    {
        return value?.ToLocalTime().ToString("yyyy-MM-dd HH:mm") ?? NotYetLabel;
    }

    private void HandlePwaStateChanged()
    {
        _ = InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        PwaUpdate.OnChange -= HandlePwaStateChanged;
    }
}

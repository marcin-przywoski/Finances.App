@page "/data"
@implements IDisposable
@inject IFinanceService Finance
@inject WorkerContextService WorkerContext
@inject IJSRuntime JS
@inject PwaUpdateService PwaUpdate
@inject ToastService Toast
@inject AttachmentStore Attachments

<PageTitle>@L["dataPageTitle"]</PageTitle>

<div class="workspace-page">
    <section class="workspace-hero workspace-hero--data">
        <div class="workspace-hero-copy">
            <span class="workspace-kicker">@L["dataKicker"]</span>
            <h1 class="workspace-title">@L["dataTitle"]</h1>
            <p class="workspace-description">@L["dataDescription"]</p>

            @if (summary is not null)
            {
                <div class="workspace-hero-meta">
                    <div class="workspace-hero-note">
                        <span>@L["dataBackupSchema"]</span>
                        <strong>v@(summary.SchemaVersion)</strong>
                    </div>
                    <div class="workspace-hero-note">
                        <span>@L["dataLastUpdate"]</span>
                        <strong>@summary.LastUpdatedUtc.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</strong>
                    </div>
                </div>
            }
        </div>

        <div class="workspace-hero-actions">
            <div class="workspace-filter-panel">
                <span>@L["dataStorageModel"]</span>
                <strong>@L["dataStorageModelValue"]</strong>
                <small class="text-muted">@L["dataStorageModelNote"]</small>
            </div>

            @if (summary is not null)
            {
                <div class="workspace-summary-grid">
                    <div class="workspace-summary-card">
                        <span class="workspace-summary-label">@L["dataUpdateStatus"]</span>
                        <strong>@GetPwaStatusLabel()</strong>
                        <p>@L["dataInstalledBuild"]: @GetBuildLabel()</p>
                    </div>
                    <div class="workspace-summary-card">
                        <span class="workspace-summary-label">@L["dataAvailableBuild"]</span>
                        <strong>@GetAvailableBuildLabel()</strong>
                        <p>@L["dataLastChecked"]: @FormatDateTime(PwaUpdate.State.LastCheckedUtc)</p>
                    </div>
                </div>
            }
        </div>
    </section>

    @if (summary is null)
    {
        <LoadingSpinner />
    }
    else
    {
        <div class="row g-3 mb-4">
            <div class="col-sm-6 col-xl-3">
                <StatCard Value="@summary.WorkerCount.ToString()" Label="@L["dataStatWorkers"]" IconBg="#dbeafe" IconColor="#3b82f6" Subtitle="@L["dataStatWorkersSub"]">
                    <IconContent>
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2" /><circle cx="9" cy="7" r="4" /></svg>
                    </IconContent>
                </StatCard>
            </div>
            <div class="col-sm-6 col-xl-3">
                <StatCard Value="@summary.ServiceCount.ToString()" Label="@L["dataStatServices"]" IconBg="#fef3c7" IconColor="#f59e0b" Subtitle="@L["dataStatServicesSub"]">
                    <IconContent>
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z" /></svg>
                    </IconContent>
                </StatCard>
            </div>
            <div class="col-sm-6 col-xl-3">
                <StatCard Value="@summary.ProductCount.ToString()" Label="@L["dataStatProducts"]" IconBg="#ede9fe" IconColor="#7c3aed" Subtitle="@L["dataStatProductsSub"]">
                    <IconContent>
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z" /><polyline points="3.27 6.96 12 12.01 20.73 6.96" /><line x1="12" y1="22.08" x2="12" y2="12" /></svg>
                    </IconContent>
                </StatCard>
            </div>
            <div class="col-sm-6 col-xl-3">
                <StatCard Value="@summary.ServiceRecordCount.ToString()" Label="@L["dataStatRecords"]" IconBg="#d1fae5" IconColor="#10b981" Subtitle="@L["dataStatRecordsSub"]">
                    <IconContent>
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12" /></svg>
                    </IconContent>
                </StatCard>
            </div>
            <div class="col-sm-6 col-xl-3">
                <StatCard Value="@summary.ProductSaleCount.ToString()" Label="@L["dataStatSales"]" IconBg="#fce7f3" IconColor="#ec4899" Subtitle="@L["dataStatSalesSub"]">
                    <IconContent>
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z" /><line x1="3" y1="6" x2="21" y2="6" /><path d="M16 10a4 4 0 0 1-8 0" /></svg>
                    </IconContent>
                </StatCard>
            </div>
        </div>

        <section class="workspace-panel mb-3">
            <div class="workspace-panel-header">
                <p class="workspace-panel-eyebrow">@L["dataStorageEyebrow"]</p>
                <h2>@L["dataStorageTitle"]</h2>
                <p>@L["dataStorageDescription"]</p>
            </div>

            <div class="workspace-summary-grid">
                <div class="workspace-summary-card">
                    <span class="workspace-summary-label">@L["dataStorageQuotaLabel"]</span>
                    <strong>@FormatQuotaHeadline()</strong>
                    @if (storageEstimate?.Quota is long quotaBytes && quotaBytes > 0)
                    {
                        <p>@L.T("dataStorageQuotaDetail", FormatBytes(storageEstimate?.Usage ?? 0), FormatBytes(quotaBytes))</p>
                    }
                    else
                    {
                        <p>@L["dataStorageQuotaUnsupported"]</p>
                    }
                </div>

                <div class="workspace-summary-card">
                    <span class="workspace-summary-label">@L["dataStorageAttachmentsLabel"]</span>
                    <strong>@(attachmentSummaries?.Count.ToString() ?? "…")</strong>
                    @if (attachmentSummaries is not null && attachmentSummaries.Count > 0)
                    {
                        <p>@L.T("dataStorageAttachmentsDetail", FormatBytes(attachmentTotalBytes))</p>
                    }
                    else
                    {
                        <p>@L["dataStorageAttachmentsEmpty"]</p>
                    }
                </div>

                <div class="workspace-summary-card">
                    <span class="workspace-summary-label">@L["dataStorageTopTypeLabel"]</span>
                    <strong>@(TopMimeLabel ?? "—")</strong>
                    @if (attachmentSummaries is not null && attachmentSummaries.Count > 0)
                    {
                        <p>@L.T("dataStorageTopTypeDetail", TopMimeCount, FormatBytes(TopMimeBytes))</p>
                    }
                    else
                    {
                        <p>@L["dataStorageTopTypeEmpty"]</p>
                    }
                </div>
            </div>

            @if (storageEstimate?.Quota is long q && q > 0)
            {
                var pct = Math.Clamp((storageEstimate.Usage ?? 0) * 100.0 / q, 0, 100);
                <div class="mt-3">
                    <div class="progress" role="progressbar" aria-valuenow="@((int)pct)" aria-valuemin="0" aria-valuemax="100" style="height: 6px;">
                        <div class="progress-bar" style="width: @pct.ToString("0.#")%;"></div>
                    </div>
                    <p class="text-muted small mt-1 mb-0">@L.T("dataStorageUsagePercent", pct.ToString("0.#"))</p>
                </div>
            }

            <div class="mt-4">
                <p class="workspace-panel-eyebrow">@L["dataClearRuntimeCachesEyebrow"]</p>
                <h3 class="h5 mb-1">@L["dataClearRuntimeCachesTitle"]</h3>
                <p class="text-muted small">@L["dataClearRuntimeCachesDescription"]</p>
                <button class="btn btn-outline-warning btn-sm" @onclick="ClearRuntimeCachesAsync" disabled="@clearingRuntimeCaches">
                    @L["dataClearRuntimeCachesButton"]
                </button>
            </div>
        </section>

        <div class="row g-3">
            <div class="col-lg-7">
                <section class="workspace-panel">
                    <div class="workspace-panel-header">
                        <p class="workspace-panel-eyebrow">@L["dataBackupEyebrow"]</p>
                        <h2>@L["dataBackupTitle"]</h2>
                        <p>@L["dataBackupDesc"]</p>
                    </div>
                    <div class="workspace-action-row">
                        <button class="btn btn-primary" @onclick="ExportAsync" disabled="@busy">@(busy ? L["dataExportBusy"] : L["dataExportButton"])</button>
                        <label class="btn btn-outline-primary mb-0 @(busy ? "disabled" : string.Empty)">
                            @L["dataImportButton"]
                            <InputFile OnChange="ImportAsync" accept=".json,application/json" class="d-none" disabled="@busy" />
                        </label>
                        <button class="btn btn-outline-danger" @onclick="() => showResetConfirm = true" disabled="@busy">@L["dataResetButton"]</button>
                    </div>
                </section>
            </div>

            <div class="col-lg-5">
                <section class="workspace-panel">
                    <div class="workspace-panel-header workspace-panel-header-split">
                        <div>
                            <p class="workspace-panel-eyebrow">@L["dataUpdatesEyebrow"]</p>
                            <h2>@L["dataUpdatesTitle"]</h2>
                            <p>@L["dataUpdatesDesc"]</p>
                        </div>
                        <span class="workspace-badge">@GetPwaStatusLabel()</span>
                    </div>

                    <dl class="row mb-3 small">
                        <dt class="col-5 text-muted">@L["dataInstalledBuild"]</dt>
                        <dd class="col-7 fw-semibold">@GetBuildLabel()</dd>

                        <dt class="col-5 text-muted">@L["dataAvailableBuild"]</dt>
                        <dd class="col-7">@GetAvailableBuildLabel()</dd>

                        <dt class="col-5 text-muted">@L["dataLastChecked"]</dt>
                        <dd class="col-7">@FormatDateTime(PwaUpdate.State.LastCheckedUtc)</dd>

                        <dt class="col-5 text-muted">Last applied</dt>
                        <dd class="col-7">@FormatDateTime(PwaUpdate.State.LastAppliedUpdateUtc)</dd>

                        <dt class="col-5 text-muted">@L["dataBackupSchema"]</dt>
                        <dd class="col-7">v@(summary.SchemaVersion)</dd>
                    </dl>

                    <div class="workspace-action-row mb-3">
                        <button class="btn btn-outline-primary" @onclick="CheckForUpdatesAsync" disabled="@(busy || pwaBusy)">@(pwaBusy ? L["dataCheckBusy"] : L["dataCheckUpdates"])</button>

                        @if (PwaUpdate.State.UpdateAvailable)
                        {
                            <button class="btn btn-primary" @onclick="ApplyUpdateAsync" disabled="@(busy || pwaBusy)">@L["dataReloadToUpdate"]</button>
                        }

                        @if (PwaUpdate.State.InstallAvailable && !PwaUpdate.State.IsStandalone)
                        {
                            <button class="btn btn-outline-secondary" @onclick="PromptInstallAsync" disabled="@(busy || pwaBusy)">@L["dataInstallApp"]</button>
                        }
                    </div>

                    @if (GetDisplayedRelease() is { } release)
                    {
                        <div class="workspace-summary-card mb-3">
                            <div class="d-flex flex-wrap justify-content-between align-items-start gap-2 mb-2">
                                <div>
                                    <div class="workspace-summary-label mb-1">@GetReleaseHeading()</div>
                                    @if (!string.IsNullOrWhiteSpace(release.Title))
                                    {
                                        <strong>@release.Title</strong>
                                    }
                                </div>

                                @if (release.PublishedUtc is not null)
                                {
                                    <span class="small text-muted">@release.PublishedUtc.Value.ToLocalTime().ToString("yyyy-MM-dd")</span>
                                }
                            </div>

                            @if (!string.IsNullOrWhiteSpace(release.Summary))
                            {
                                <p class="mb-2">@release.Summary</p>
                            }

                            @if (release.Changes.Count > 0)
                            {
                                <ul class="workspace-note-list">
                                    @foreach (var change in release.Changes)
                                    {
                                        <li>@change</li>
                                    }
                                </ul>
                            }
                        </div>
                    }

                    <div class="workspace-panel-header mb-0">
                        <p class="workspace-panel-eyebrow">@L["dataPrivacyEyebrow"]</p>
                        <h2>@L["dataPrivacyTitle"]</h2>
                    </div>
                    <ul class="workspace-note-list">
                        <li>@L["dataPrivacyNote1"]</li>
                        <li>@L["dataPrivacyNote2"]</li>
                        <li>@L["dataPrivacyNote3"]</li>
                        <li>@L["dataPrivacyNote4"]</li>
                        <li>@L.T("dataPrivacyNote5", summary.LastUpdatedUtc.ToLocalTime().ToString("yyyy-MM-dd HH:mm"))</li>
                    </ul>
                </section>
            </div>
        </div>
    }
</div>

<ConfirmDialog IsVisible="showResetConfirm"
               Title="@L["dataResetTitle"]"
               Message="@L["dataResetMsg"]"
               ConfirmText="@L["dataResetConfirm"]"
               OnConfirm="HandleResetAsync"
               OnCancel="() => showResetConfirm = false" />

@code {
    private DataStateSummary? summary;
    private bool busy;
    private bool pwaBusy;
    private bool showResetConfirm;
    private bool clearingRuntimeCaches;
    private StorageEstimate? storageEstimate;
    private IReadOnlyList<AttachmentSummary>? attachmentSummaries;
    private long attachmentTotalBytes;
    private string? TopMimeLabel;
    private int TopMimeCount;
    private long TopMimeBytes;

    protected override async Task OnInitializedAsync()
    {
        PwaUpdate.OnChange += HandlePwaStateChanged;
        await RefreshSummaryAsync();
        await RefreshStorageAsync();
    }

    private async Task ClearRuntimeCachesAsync()
    {
        if (clearingRuntimeCaches) return;
        clearingRuntimeCaches = true;
        try
        {
            var success = await PwaUpdate.ClearRuntimeCachesAsync();
            Toast.Show(success
                ? L["dataClearRuntimeCachesSuccess"]
                : L["dataClearRuntimeCachesFailed"],
                success ? ToastLevel.Success : ToastLevel.Error);
        }
        catch
        {
            Toast.Show(L["dataClearRuntimeCachesFailed"], ToastLevel.Error);
        }
        finally
        {
            clearingRuntimeCaches = false;
            StateHasChanged();
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        await PwaUpdate.EnsureInitializedAsync();
    }

    private async Task RefreshSummaryAsync()
    {
        summary = await Finance.GetDataStateSummaryAsync();
    }

    private async Task RefreshStorageAsync()
    {
        try
        {
            storageEstimate = await Attachments.EstimateUsageAsync();
        }
        catch
        {
            storageEstimate = null;
        }

        try
        {
            attachmentSummaries = await Attachments.ListSummariesAsync();
        }
        catch
        {
            attachmentSummaries = Array.Empty<AttachmentSummary>();
        }

        attachmentTotalBytes = attachmentSummaries?.Sum(a => a.SizeBytes) ?? 0L;

        if (attachmentSummaries is not null && attachmentSummaries.Count > 0)
        {
            var top = attachmentSummaries
                .GroupBy(a => string.IsNullOrWhiteSpace(a.Mime) ? "unknown" : a.Mime)
                .Select(g => new { Mime = g.Key, Count = g.Count(), Bytes = g.Sum(x => x.SizeBytes) })
                .OrderByDescending(g => g.Bytes)
                .First();

            TopMimeLabel = top.Mime;
            TopMimeCount = top.Count;
            TopMimeBytes = top.Bytes;
        }
        else
        {
            TopMimeLabel = null;
            TopMimeCount = 0;
            TopMimeBytes = 0;
        }
    }

    private string FormatQuotaHeadline()
    {
        if (storageEstimate is null) return L["dataStorageQuotaUnsupported"];
        if (storageEstimate.Quota is long q && q > 0 && storageEstimate.Usage is long u)
        {
            return $"{FormatBytes(u)} / {FormatBytes(q)}";
        }
        if (storageEstimate.Usage is long onlyUsage)
        {
            return FormatBytes(onlyUsage);
        }
        return L["dataStorageQuotaUnsupported"];
    }

    private static string FormatBytes(long bytes)
    {
        if (bytes <= 0) return "0 B";
        string[] units = ["B", "KB", "MB", "GB", "TB"];
        double size = bytes;
        int unit = 0;
        while (size >= 1024 && unit < units.Length - 1)
        {
            size /= 1024;
            unit++;
        }
        return $"{size:0.##} {units[unit]}";
    }

    private async Task ExportAsync()
    {
        if (busy)
        {
            return;
        }

        busy = true;
        try
        {
            var json = await Finance.ExportAsync();
            var fileName = $"finances-app-{DateTime.Now:yyyyMMdd-HHmmss}.json";
            await JS.InvokeVoidAsync("financeBrowser.downloadTextFile", fileName, "application/json;charset=utf-8", json);
            Toast.Show(L["dataToastExported"]);
            await RefreshSummaryAsync();
        }
        catch (Exception ex)
        {
            Toast.Show(ex.Message, ToastLevel.Error);
        }
        finally
        {
            busy = false;
        }
    }

    private async Task ImportAsync(InputFileChangeEventArgs args)
    {
        if (busy)
        {
            return;
        }

        var file = args.File;
        if (file is null)
        {
            return;
        }

        busy = true;
        try
        {
            using var stream = file.OpenReadStream(5 * 1024 * 1024);
            using var reader = new StreamReader(stream);
            var json = await reader.ReadToEndAsync();

            await Finance.ImportAsync(json);
            await SyncSelectedWorkerAsync();
            await RefreshSummaryAsync();
            Toast.Show(L["dataToastImported"]);
        }
        catch (Exception ex)
        {
            Toast.Show(ex.Message, ToastLevel.Error);
        }
        finally
        {
            busy = false;
        }
    }

    private async Task HandleResetAsync()
    {
        showResetConfirm = false;

        if (busy)
        {
            return;
        }

        busy = true;
        try
        {
            await Finance.ResetAsync();
            await SyncSelectedWorkerAsync();
            await RefreshSummaryAsync();
            Toast.Show(L["dataToastReset"]);
        }
        catch (Exception ex)
        {
            Toast.Show(ex.Message, ToastLevel.Error);
        }
        finally
        {
            busy = false;
        }
    }

    private async Task SyncSelectedWorkerAsync()
    {
        var workers = await Finance.GetWorkersAsync();
        await WorkerContext.EnsureWorkerExistsAsync(workers.Select(worker => worker.Id));
    }

    private async Task CheckForUpdatesAsync()
    {
        if (busy || pwaBusy)
        {
            return;
        }

        pwaBusy = true;

        try
        {
            var updateReady = await PwaUpdate.CheckForUpdatesAsync();
            Toast.Show(updateReady
                ? L["dataToastUpdateReady"]
                : L["dataToastUpToDate"]);
        }
        catch (Exception ex)
        {
            Toast.Show(ex.Message, ToastLevel.Error);
        }
        finally
        {
            pwaBusy = false;
        }
    }

    private async Task ApplyUpdateAsync()
    {
        if (busy || pwaBusy)
        {
            return;
        }

        pwaBusy = true;

        try
        {
            var updateStarted = await PwaUpdate.ApplyUpdateAsync();
            if (!updateStarted)
            {
                Toast.Show(L["dataToastNoPending"], ToastLevel.Error);
            }
        }
        catch (Exception ex)
        {
            Toast.Show(ex.Message, ToastLevel.Error);
        }
        finally
        {
            pwaBusy = false;
        }
    }

    private async Task PromptInstallAsync()
    {
        if (busy || pwaBusy)
        {
            return;
        }

        pwaBusy = true;

        try
        {
            var accepted = await PwaUpdate.PromptInstallAsync();
            if (!accepted)
            {
                Toast.Show(L["dataToastInstallNotAvailable"], ToastLevel.Error);
            }
        }
        catch (Exception ex)
        {
            Toast.Show(ex.Message, ToastLevel.Error);
        }
        finally
        {
            pwaBusy = false;
        }
    }

    private string GetPwaStatusLabel()
    {
        if (pwaBusy || PwaUpdate.State.IsCheckingForUpdates)
        {
            return L["dataPwaChecking"];
        }

        if (PwaUpdate.State.UpdateAvailable)
        {
            return L["dataPwaUpdateReady"];
        }

        if (PwaUpdate.State.JustUpdated)
        {
            return L["dataPwaUpdated"];
        }

        return PwaUpdate.State.IsOfflineReady ? L["dataPwaUpToDate"] : L["dataPwaInitializing"];
    }

    private string GetBuildLabel()
    {
        return string.IsNullOrWhiteSpace(PwaUpdate.State.CurrentVersion)
            ? L["dataBuildDetecting"]
            : PwaUpdate.State.CurrentVersion!;
    }

    private string GetAvailableBuildLabel()
    {
        return string.IsNullOrWhiteSpace(PwaUpdate.State.AvailableVersion)
            ? L["dataAvailableNone"]
            : PwaUpdate.State.AvailableVersion!;
    }

    private PwaReleaseInfo? GetDisplayedRelease()
    {
        return PwaUpdate.State.AvailableRelease ?? PwaUpdate.State.InstalledRelease;
    }

    private string GetReleaseHeading()
    {
        return PwaUpdate.State.AvailableRelease is not null
            ? L["dataReleaseChanged"]
            : L["dataReleaseCurrent"];
    }

    private string FormatDateTime(DateTimeOffset? value)
    {
        return value?.ToLocalTime().ToString("yyyy-MM-dd HH:mm") ?? L["dataLastCheckedNotYet"];
    }

    private void HandlePwaStateChanged()
    {
        _ = InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        PwaUpdate.OnChange -= HandlePwaStateChanged;
    }
}
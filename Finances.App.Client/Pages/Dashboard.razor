@page "/"
@inject HttpClient Http
@inject IJSRuntime JS
@inject WorkerContextService WorkerContext

<PageTitle>Dashboard</PageTitle>

<div class="mb-4">
    <h2 class="mb-1" style="font-weight: 700;">Dashboard</h2>
    <p class="text-muted mb-0">Overview of your salon's financial performance.</p>
</div>

@if (loading)
{
    <LoadingSpinner />
}
else
{
    <div class="row g-3 mb-4">
        <div class="col-sm-6 col-xl-3">
            <StatCard Value="@totalRevenue" Label="Total Revenue" TrendPercent="@revenueTrend" Subtitle="@("vs last month")">
                <IconContent>
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="12" y1="1" x2="12" y2="23"/><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg>
                </IconContent>
            </StatCard>
        </div>
        <div class="col-sm-6 col-xl-3">
            <StatCard Value="@totalTips" Label="Total Tips" IconBg="#dbeafe" IconColor="#3b82f6" TrendPercent="@tipsTrend" Subtitle="@("vs last month")">
                <IconContent>
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg>
                </IconContent>
            </StatCard>
        </div>
        <div class="col-sm-6 col-xl-3">
            <StatCard Value="@avgTicket" Label="Avg Ticket" IconBg="#fef3c7" IconColor="#f59e0b" TrendPercent="@avgTicketTrend" Subtitle="@("vs last month")">
                <IconContent>
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="1" y="4" width="22" height="16" rx="2" ry="2"/><line x1="1" y1="10" x2="23" y2="10"/></svg>
                </IconContent>
            </StatCard>
        </div>
        <div class="col-sm-6 col-xl-3">
            <StatCard Value="@recordCount" Label="Services Done" IconBg="#d1fae5" IconColor="#10b981" TrendPercent="@countTrend" Subtitle="@("vs last month")">
                <IconContent>
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"/></svg>
                </IconContent>
            </StatCard>
        </div>
    </div>

    <div class="row g-3 mb-4">
        <div class="col-lg-8">
            <div class="card p-3">
                <h6 class="fw-semibold mb-3">Revenue Breakdown</h6>
                <div style="height: 300px;">
                    <canvas id="combinedTimelineChart"></canvas>
                </div>
            </div>
        </div>
        <div class="col-lg-4">
            <div class="card p-3">
                <h6 class="fw-semibold mb-3">Revenue Sources</h6>
                <div style="height: 300px;">
                    <canvas id="revenueSourcesChart"></canvas>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-3 mb-4">
        <div class="col-lg-4">
            <div class="card p-3">
                <h6 class="fw-semibold mb-3">Busiest Days</h6>
                <div style="height: 240px;">
                    <canvas id="dayOfWeekChart"></canvas>
                </div>
            </div>
        </div>
        <div class="col-lg-4">
            <div class="card p-3">
                <h6 class="fw-semibold mb-3">Top Products</h6>
                @if (topProducts != null && topProducts.Length > 0)
                {
                    <div class="list-group list-group-flush">
                        @foreach (var p in topProducts)
                        {
                            <div class="list-group-item px-0" style="border-color: var(--border-color);">
                                <div class="d-flex justify-content-between align-items-center mb-1">
                                    <span class="fw-semibold" style="font-size: 0.875rem;">@p.Product</span>
                                    <span class="fw-semibold" style="color: var(--primary); font-size: 0.875rem;">@p.Revenue.ToString("C")</span>
                                </div>
                                <div class="d-flex justify-content-between align-items-center">
                                    <span class="text-muted" style="font-size: 0.75rem;">@p.Quantity sold</span>
                                    @if (topProducts.Length > 0 && topProducts[0].Revenue > 0)
                                    {
                                        var pct = (double)p.Revenue / (double)topProducts[0].Revenue * 100;
                                        <div class="progress-bar-custom" style="width: 60%;">
                                            <div class="progress-fill" style="width: @($"{pct:F0}")%;"></div>
                                        </div>
                                    }
                                </div>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <p class="text-muted mb-0" style="font-size: 0.875rem;">No product sales yet.</p>
                }
            </div>
        </div>
        <div class="col-lg-4">
            <div class="card p-3">
                <h6 class="fw-semibold mb-3">Recent Activity</h6>
                @if (recentRecords != null && recentRecords.Length > 0)
                {
                    <div class="list-group list-group-flush">
                        @foreach (var r in recentRecords)
                        {
                            <div class="list-group-item px-0 d-flex justify-content-between align-items-start" style="border-color: var(--border-color);">
                                <div>
                                    <div class="fw-semibold" style="font-size: 0.875rem;">@r.Service</div>
                                    <div class="text-muted" style="font-size: 0.75rem;">@r.Worker &middot; @r.Date</div>
                                </div>
                                <span class="fw-semibold" style="color: var(--primary);">@r.AmountPaid.ToString("C")</span>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <p class="text-muted mb-0" style="font-size: 0.875rem;">No recent activity.</p>
                }
            </div>
        </div>
    </div>
}

@code {
    private bool loading = true;
    private string totalRevenue = "0";
    private string totalTips = "0";
    private string avgTicket = "0";
    private string recordCount = "0";
    private decimal? revenueTrend;
    private decimal? tipsTrend;
    private decimal? avgTicketTrend;
    private decimal? countTrend;
    private RecentRecord[]? recentRecords;
    private TopProduct[]? topProducts;
    private DayOfWeekEntry[]? dayOfWeekData;
    private CombinedTimeline? combinedTimeline;
    private decimal serviceRevenueTotal;
    private decimal productRevenueTotal;

    protected override async Task OnInitializedAsync()
    {
        await WorkerContext.InitializeAsync();
        await LoadData();
    }

    private async Task LoadData()
    {
        loading = true;
        try
        {
            var wId = WorkerContext.SelectedWorkerId;
            var now = DateTime.Today;
            var monthStart = new DateTime(now.Year, now.Month, 1);
            var qs = $"?from={monthStart:yyyy-MM-dd}&to={now:yyyy-MM-dd}";
            if (wId.HasValue) qs += $"&workerId={wId.Value}";

            var summary = await Http.GetFromJsonAsync<SummaryDto>($"api/analytics/summary{qs}");
            if (summary != null)
            {
                totalRevenue = summary.TotalRevenue.ToString("C");
                totalTips = summary.TotalTips.ToString("C");
                recordCount = summary.RecordCount.ToString();
                avgTicket = summary.RecordCount > 0
                    ? (summary.TotalRevenue / summary.RecordCount).ToString("C")
                    : "$0.00";
            }

            try
            {
                var comparison = await Http.GetFromJsonAsync<MonthComparisonDto>(
                    $"api/analytics/month-comparison{(wId.HasValue ? $"?workerId={wId.Value}" : "")}");
                if (comparison != null)
                {
                    revenueTrend = CalcTrend(comparison.CurrentRevenue, comparison.PreviousRevenue);
                    tipsTrend = CalcTrend(comparison.CurrentTips, comparison.PreviousTips);
                    avgTicketTrend = CalcTrend(comparison.CurrentAvgTicket, comparison.PreviousAvgTicket);
                    countTrend = CalcTrend(comparison.CurrentCount, comparison.PreviousCount);
                }
            }
            catch { }

            recentRecords = await Http.GetFromJsonAsync<RecentRecord[]>("api/analytics/recent?count=5");

            try
            {
                topProducts = await Http.GetFromJsonAsync<TopProduct[]>($"api/analytics/top-products{qs}");
            }
            catch { topProducts = []; }

            try
            {
                dayOfWeekData = await Http.GetFromJsonAsync<DayOfWeekEntry[]>($"api/analytics/revenue-by-dayofweek{qs}");
            }
            catch { dayOfWeekData = []; }

            try
            {
                combinedTimeline = await Http.GetFromJsonAsync<CombinedTimeline>($"api/analytics/combined-timeline{qs}");
                if (combinedTimeline?.Points != null)
                {
                    serviceRevenueTotal = combinedTimeline.Points.Sum(p => p.ServiceRevenue);
                    productRevenueTotal = combinedTimeline.Points.Sum(p => p.ProductRevenue);
                }
            }
            catch { }
        }
        catch { }
        finally
        {
            loading = false;
            needsChartRender = true;
        }
    }

    private static decimal? CalcTrend(decimal current, decimal previous)
    {
        if (previous == 0) return current > 0 ? 100m : null;
        return Math.Round((current - previous) / previous * 100, 1);
    }

    private bool needsChartRender;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (needsChartRender)
        {
            needsChartRender = false;
            // Yield to let Blazor commit the DOM before JS reads canvas dimensions
            await Task.Yield();
            await RenderCharts();
        }
    }

    private async Task RenderCharts()
    {
        // Each chart is wrapped individually so one failure doesn't block others
        try
        {
            if (combinedTimeline?.Points != null && combinedTimeline.Points.Length > 0)
            {
                var labels = combinedTimeline.Points.Select(p => p.Date).ToArray();
                var datasets = new object[]
                {
                    new { label = "Services", data = combinedTimeline.Points.Select(p => p.ServiceRevenue).ToArray(), color = "#0d9488" },
                    new { label = "Products", data = combinedTimeline.Points.Select(p => p.ProductRevenue).ToArray(), color = "#8b5cf6" }
                };
                await JS.InvokeVoidAsync("financeCharts.renderStackedBarChart", "combinedTimelineChart", labels, datasets);
            }
        }
        catch { }

        try
        {
            var svcTotal = (decimal)serviceRevenueTotal;
            var prdTotal = (decimal)productRevenueTotal;
            if (svcTotal > 0 || prdTotal > 0)
            {
                await JS.InvokeVoidAsync("financeCharts.renderDoughnutChart",
                    "revenueSourcesChart",
                    new[] { "Services", "Products" },
                    new[] { svcTotal, prdTotal },
                    new[] { "#0d9488", "#8b5cf6" });
            }
        }
        catch { }

        try
        {
            if (dayOfWeekData != null && dayOfWeekData.Length > 0)
            {
                var labels = dayOfWeekData.Select(d => d.Day).ToArray();
                var data = dayOfWeekData.Select(d => d.Revenue).ToArray();
                var maxIdx = Array.IndexOf(data, data.Max());
                await JS.InvokeVoidAsync("financeCharts.renderMiniBarChart", "dayOfWeekChart", labels, data, maxIdx);
            }
        }
        catch { }
    }

    private record SummaryDto(decimal TotalRevenue, decimal TotalTips, decimal TotalWorkerShare, decimal TotalSalonShare, int RecordCount);
    private record RecentRecord(int Id, string Date, string Worker, string Service, decimal AmountPaid, decimal Tips, string? ClientName);
    private record MonthComparisonDto(decimal CurrentRevenue, decimal PreviousRevenue, decimal CurrentTips, decimal PreviousTips, int CurrentCount, int PreviousCount, decimal CurrentAvgTicket, decimal PreviousAvgTicket);
    private record TopProduct(string Product, int Quantity, decimal Revenue);
    private record DayOfWeekEntry(string Day, decimal Revenue, int Count);
    private record CombinedTimelinePoint(string Date, decimal ServiceRevenue, decimal ProductRevenue);
    private record CombinedTimeline(CombinedTimelinePoint[] Points);
}

@page "/"
@implements IDisposable
@inject IFinanceService Finance
@inject IJSRuntime JS
@inject WorkerContextService WorkerContext

<PageTitle>@L["dashboardPageTitle"]</PageTitle>

<div class="dashboard-page">
    <section class="dashboard-hero">
        <div class="dashboard-hero-copy">
            <span class="dashboard-hero-kicker">@L["dashboardKicker"]</span>
            <h1 class="dashboard-hero-title">@L["dashboardTitle"]</h1>
            <p class="dashboard-hero-description">@L["dashboardDescription"]</p>
            <div class="dashboard-hero-meta">
                <div class="dashboard-hero-pill">
                    <span>@L["dashboardPeriodLabel"]</span>
                    <strong>@CurrentMonthLabel</strong>
                </div>
                <div class="dashboard-hero-pill">
                    <span>@L["dashboardScopeLabel"]</span>
                    <strong>@WorkerScopeLabel</strong>
                </div>
            </div>
        </div>
        <div class="dashboard-glance">
            <div class="dashboard-glance-card dashboard-glance-card-primary">
                <span class="dashboard-glance-label">@L["dashboardGlanceRevenue"]</span>
                <strong class="dashboard-glance-value">@HeroRevenueDisplay</strong>
                <span class="dashboard-glance-subtext">@HeroRevenueSubtext</span>
            </div>
            <div class="dashboard-glance-grid">
                <div class="dashboard-glance-card" title="@NetProfitHoverSubtext">
                    <span class="dashboard-glance-label">@L["dashboardGlanceNetProfit"]</span>
                    <strong class="dashboard-glance-value">@NetProfitDisplay</strong>
                    <span class="dashboard-glance-subtext">@NetProfitSubtext</span>
                </div>
                <div class="dashboard-glance-card">
                    <span class="dashboard-glance-label">@L["dashboardGlanceTopDay"]</span>
                    <strong class="dashboard-glance-value">@StrongestDayLabel</strong>
                    <span class="dashboard-glance-subtext">@StrongestDaySubtext</span>
                </div>
                <div class="dashboard-glance-card">
                    <span class="dashboard-glance-label">@L["dashboardGlanceTopProduct"]</span>
                    <strong class="dashboard-glance-value">@FeaturedProductLabel</strong>
                    <span class="dashboard-glance-subtext">@FeaturedProductSubtext</span>
                </div>
                <div class="dashboard-glance-card">
                    <span class="dashboard-glance-label">@L["dashboardGlanceLatestActivity"]</span>
                    <strong class="dashboard-glance-value">@LatestActivityLabel</strong>
                    <span class="dashboard-glance-subtext">@LatestActivitySubtext</span>
                </div>
            </div>
        </div>
    </section>

    @if (loading)
    {
        <LoadingSpinner />
    }
    else
    {
        <div class="row g-3 mb-4">
            <div class="col-sm-6 col-xl-3">
                <StatCard Value="@TotalRevenueDisplay" Label="@L["dashboardStatRevenue"]" TrendPercent="@revenueTrend" Subtitle="@L["dashboardStatVsLastMonth"]">
                    <IconContent>
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="12" y1="1" x2="12" y2="23" /><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6" /></svg>
                    </IconContent>
                </StatCard>
            </div>
            <div class="col-sm-6 col-xl-3">
                <StatCard Value="@TotalTipsDisplay" Label="@L["dashboardStatTips"]" IconBg="#dbeafe" IconColor="#2563eb" TrendPercent="@tipsTrend" Subtitle="@L["dashboardStatVsLastMonth"]">
                    <IconContent>
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z" /></svg>
                    </IconContent>
                </StatCard>
            </div>
            <div class="col-sm-6 col-xl-3">
                <StatCard Value="@AvgTicketDisplay" Label="@L["dashboardStatAvgTicket"]" IconBg="#fef3c7" IconColor="#d97706" TrendPercent="@avgTicketTrend" Subtitle="@L["dashboardStatVsLastMonth"]">
                    <IconContent>
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="1" y="4" width="22" height="16" rx="2" ry="2" /><line x1="1" y1="10" x2="23" y2="10" /></svg>
                    </IconContent>
                </StatCard>
            </div>
            <div class="col-sm-6 col-xl-3">
                <StatCard Value="@RecordCountDisplay" Label="@L["dashboardStatAppointments"]" IconBg="#d1fae5" IconColor="#10b981" TrendPercent="@countTrend" Subtitle="@L["dashboardStatVsLastMonth"]">
                    <IconContent>
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12" /></svg>
                    </IconContent>
                </StatCard>
            </div>
        </div>

        @if (goalProgress != null && goalProgress.Length > 0)
        {
            <div class="row g-3 mb-4">
                <div class="col-12">
                    <section class="card dashboard-panel">
                        <div class="dashboard-panel-header">
                            <p class="dashboard-panel-eyebrow">@L["dashboardGoalEyebrow"]</p>
                            <h2>@L["dashboardGoalTitle"]</h2>
                            <p>@L["dashboardGoalDesc"]</p>
                        </div>
                        <div class="goal-progress-list">
                            @foreach (var gp in goalProgress)
                            {
                                var label = !string.IsNullOrEmpty(gp.Goal.Label) ? gp.Goal.Label : $"{gp.Goal.Type} ({gp.Goal.Period})";
                                var scope = gp.WorkerName ?? L["dashboardGoalSalonWide"];
                                var barColor = gp.ProgressPercent >= 100 ? "#10b981" : gp.ProgressPercent >= 75 ? "#f59e0b" : "#3b82f6";
                                <div class="goal-progress-item">
                                    <div class="goal-progress-header">
                                        <div>
                                            <span class="goal-progress-label">@label</span>
                                            <span class="goal-progress-scope">@scope</span>
                                        </div>
                                        <span class="goal-progress-values">
                                            @FormatGoalValue(gp.CurrentValue, gp.Goal.Type) / @FormatGoalValue(gp.TargetValue, gp.Goal.Type)
                                        </span>
                                    </div>
                                    <div class="progress-bar-custom goal-progress-bar">
                                        <div class="progress-fill" style="width: @($"{gp.ProgressPercent:F0}")%; background: @barColor;"></div>
                                    </div>
                                    <div class="goal-progress-footer">
                                        <span>@L.T("dashboardGoalPercentComplete", gp.ProgressPercent.ToString("F0"))</span>
                                        @if (gp.ProgressPercent >= 100)
                                        {
                                            <span class="goal-progress-achieved">@L["dashboardGoalTargetReached"]</span>
                                        }
                                    </div>
                                </div>
                            }
                        </div>
                    </section>
                </div>
            </div>
        }

        <div class="row g-3 mb-4">
            <div class="col-xl-8">
                <section class="card dashboard-panel dashboard-panel-spotlight">
                    <div class="dashboard-panel-header dashboard-panel-header-split">
                        <div>
                            <p class="dashboard-panel-eyebrow">@L["dashboardRevenueEyebrow"]</p>
                            <h2>@L["dashboardRevenueTitle"]</h2>
                            <p>@L["dashboardRevenueDesc"]</p>
                        </div>
                        @if (HasRevenueSources)
                        {
                            <div class="dashboard-inline-summary">
                                <div>
                                    <span>@L["dashboardRevenueServices"]</span>
                                    <strong>@serviceRevenueTotal.ToString("C")</strong>
                                </div>
                                <div>
                                    <span>@L["dashboardRevenueProducts"]</span>
                                    <strong>@productRevenueTotal.ToString("C")</strong>
                                </div>
                            </div>
                        }
                    </div>
                    @if (combinedTimeline?.Points != null && combinedTimeline.Points.Length > 0)
                    {
                        <div class="dashboard-chart dashboard-chart-regular">
                            <canvas id="combinedTimelineChart"></canvas>
                        </div>
                    }
                    else
                    {
                        <div class="dashboard-empty-state">
                            <p>@L["dashboardRevenueEmpty"]</p>
                        </div>
                    }
                </section>
            </div>
            <div class="col-xl-4">
                <section class="card dashboard-panel">
                    <div class="dashboard-panel-header">
                        <p class="dashboard-panel-eyebrow">@L["dashboardSourcesEyebrow"]</p>
                        <h2>@L["dashboardSourcesTitle"]</h2>
                        <p>@L["dashboardSourcesDesc"]</p>
                    </div>
                    @if (HasRevenueSources)
                    {
                        <div class="dashboard-chart dashboard-chart-doughnut">
                            <canvas id="revenueSourcesChart"></canvas>
                        </div>
                        <div class="dashboard-source-list">
                            <div class="dashboard-source-item">
                                <span class="dashboard-source-swatch dashboard-source-swatch-services"></span>
                                <div class="dashboard-source-copy">
                                    <strong>@L["dashboardRevenueServices"]</strong>
                                    <span>@serviceRevenueTotal.ToString("C") · @ServiceRevenueShare.ToString("F1")%</span>
                                </div>
                            </div>
                            <div class="dashboard-source-item">
                                <span class="dashboard-source-swatch dashboard-source-swatch-products"></span>
                                <div class="dashboard-source-copy">
                                    <strong>@L["dashboardRevenueProducts"]</strong>
                                    <span>@productRevenueTotal.ToString("C") · @ProductRevenueShare.ToString("F1")%</span>
                                </div>
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="dashboard-empty-state dashboard-empty-state-compact">
                            <p>@L["dashboardSourcesEmpty"]</p>
                        </div>
                    }
                </section>
            </div>
        </div>

        <div class="row g-3 mb-4">
            <div class="col-lg-4">
                <section class="card dashboard-panel">
                    <div class="dashboard-panel-header dashboard-panel-header-split">
                        <div>
                            <p class="dashboard-panel-eyebrow">@L["dashboardBusiestEyebrow"]</p>
                            <h2>@L["dashboardBusiestTitle"]</h2>
                            <p>@L["dashboardBusiestDesc"]</p>
                        </div>
                        @if (StrongestDay != null)
                        {
                            <span class="dashboard-chip">@L.T("dashboardBusiestPeak", StrongestDay.Day)</span>
                        }
                    </div>
                    @if (dayOfWeekData != null && dayOfWeekData.Length > 0)
                    {
                        <div class="dashboard-chart dashboard-chart-compact">
                            <canvas id="dayOfWeekChart"></canvas>
                        </div>
                    }
                    else
                    {
                        <div class="dashboard-empty-state dashboard-empty-state-compact">
                            <p>@L["dashboardBusiestEmpty"]</p>
                        </div>
                    }
                </section>
            </div>
            <div class="col-lg-4">
                <section class="card dashboard-panel">
                    <div class="dashboard-panel-header">
                        <p class="dashboard-panel-eyebrow">@L["dashboardTopProductsEyebrow"]</p>
                        <h2>@L["dashboardTopProductsTitle"]</h2>
                        <p>@L["dashboardTopProductsDesc"]</p>
                    </div>
                    @if (topProducts != null && topProducts.Length > 0)
                    {
                        var rankedProducts = topProducts.OrderByDescending(p => p.Revenue).Take(5).ToArray();
                        var topRevenue = rankedProducts.Max(p => p.Revenue);
                        <div class="dashboard-ranked-list">
                            @for (var index = 0; index < rankedProducts.Length; index++)
                            {
                                var product = rankedProducts[index];
                                var pct = topRevenue > 0 ? (double)product.Revenue / (double)topRevenue * 100 : 0;
                                <div class="dashboard-ranked-item">
                                    <div class="dashboard-ranked-title">
                                        <div class="dashboard-ranked-name-wrap">
                                            <span class="dashboard-ranked-index">@(index + 1)</span>
                                            <div>
                                                <div class="dashboard-ranked-name">@product.Product</div>
                                                <div class="dashboard-ranked-caption">@L.T("dashboardTopProductsSold", product.Quantity)</div>
                                            </div>
                                        </div>
                                        <span class="dashboard-ranked-value">@product.Revenue.ToString("C")</span>
                                    </div>
                                    <div class="progress-bar-custom dashboard-ranked-bar">
                                        <div class="progress-fill" style="width: @($"{pct:F0}")%;"></div>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="dashboard-empty-state dashboard-empty-state-compact">
                            <p>@L["dashboardTopProductsEmpty"]</p>
                        </div>
                    }
                </section>
            </div>
            <div class="col-lg-4">
                <section class="card dashboard-panel">
                    <div class="dashboard-panel-header">
                        <p class="dashboard-panel-eyebrow">@L["dashboardRecentEyebrow"]</p>
                        <h2>@L["dashboardRecentTitle"]</h2>
                        <p>@L["dashboardRecentDesc"]</p>
                    </div>
                    @if (recentRecords != null && recentRecords.Length > 0)
                    {
                        <div class="dashboard-activity-list">
                            @foreach (var record in recentRecords)
                            {
                                <div class="dashboard-activity-item">
                                    <span class="dashboard-activity-marker"></span>
                                    <div class="dashboard-activity-copy">
                                        <div class="dashboard-activity-title">@record.Service</div>
                                        <div class="dashboard-activity-meta">@record.Worker &middot; @record.Date</div>
                                    </div>
                                    <span class="dashboard-activity-amount">@record.AmountPaid.ToString("C")</span>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="dashboard-empty-state dashboard-empty-state-compact">
                            <p>@L["dashboardRecentEmpty"]</p>
                        </div>
                    }
                </section>
            </div>
        </div>
    }
</div>

@code {
    private bool loading = true;
    private decimal totalRevenueValue;
    private decimal totalTipsValue;
    private decimal avgTicketValue;
    private int recordCountValue;
    private decimal? revenueTrend;
    private decimal? tipsTrend;
    private decimal? avgTicketTrend;
    private decimal? countTrend;
    private RecentRecordResult[]? recentRecords;
    private TopProductResult[]? topProducts;
    private DayOfWeekResult[]? dayOfWeekData;
    private CombinedTimelineResult? combinedTimeline;
    private decimal serviceRevenueTotal;
    private decimal productRevenueTotal;
    private GoalProgressResult[]? goalProgress;
    private NetProfitResult? netProfit;

    private string TotalRevenueDisplay => (totalRevenueValue + productRevenueTotal).ToString("C");
    private string ServiceRevenueDisplay => totalRevenueValue.ToString("C");
    private string RetailRevenueDisplay => productRevenueTotal.ToString("C");
    private string TotalTipsDisplay => totalTipsValue.ToString("C");
    private string AvgTicketDisplay => avgTicketValue.ToString("C");
    private string RecordCountDisplay => recordCountValue.ToString();
    private string CurrentMonthLabel => DateTime.Today.ToString("MMMM yyyy");
    private string WorkerScopeLabel => WorkerContext.SelectedWorkerId.HasValue ? L["dashboardScopeSelected"] : L["dashboardScopeAll"];
    private decimal TotalRevenueSources => serviceRevenueTotal + productRevenueTotal;
    private bool HasRevenueSources => TotalRevenueSources > 0;
    private decimal ServiceRevenueShare => HasRevenueSources ? Math.Round(serviceRevenueTotal / TotalRevenueSources * 100, 1) : 0m;
    private decimal ProductRevenueShare => HasRevenueSources ? Math.Round(productRevenueTotal / TotalRevenueSources * 100, 1) : 0m;
    private TopProductResult? FeaturedProduct => topProducts is { Length: > 0 } ? topProducts.OrderByDescending(p => p.Revenue).First() : null;
    private DayOfWeekResult? StrongestDay => dayOfWeekData is { Length: > 0 } ? dayOfWeekData.OrderByDescending(d => d.Revenue).First() : null;
    private RecentRecordResult? RecentHeadline => recentRecords is { Length: > 0 } ? recentRecords[0] : null;
    private string HeroRevenueDisplay => loading ? L["dashboardLoading"] : TotalRevenueDisplay;
    private string HeroRevenueSubtext => loading ? L["dashboardCalcTotals"] : L.T("dashboardFromServicesAndRetail", ServiceRevenueDisplay, RetailRevenueDisplay);
    private string ServiceShareDisplay => loading ? L["dashboardLoading"] : HasRevenueSources ? $"{ServiceRevenueShare:F0}%" : "--";
    private string ServiceShareSubtext => loading ? L["dashboardCheckingMix"] : HasRevenueSources ? L.T("dashboardCameFromServices", serviceRevenueTotal.ToString("C")) : L["dashboardSourcesWillAppear"];
    private string NetProfitDisplay => loading
        ? L["dashboardLoading"]
        : (netProfit is null ? "—" : netProfit.Net.ToString("C"));
    private string NetProfitSubtext => loading
        ? L["dashboardCalcTotals"]
        : (netProfit is null ? L["dashboardGlanceNetProfitEmpty"] : L.T("dashboardGlanceNetProfitSub", netProfit.Expenses.ToString("C")));
    private string NetProfitHoverSubtext => netProfit is null
        ? string.Empty
        : L.T("dashboardGlanceNetProfitTooltip", netProfit.Revenue.ToString("C"), netProfit.Expenses.ToString("C"));
    private string StrongestDayLabel => loading ? L["dashboardLoading"] : StrongestDay?.Day ?? L["dashboardNoDataYet"];
    private string StrongestDaySubtext => loading ? L["dashboardFindingStrongest"] : StrongestDay == null ? L["dashboardWeekdayWillAppear"] : L.T("dashboardStrongestDaySub", StrongestDay.Revenue.ToString("C"), StrongestDay.Count);
    private string FeaturedProductLabel => loading ? L["dashboardLoading"] : FeaturedProduct?.Product ?? L["dashboardNoProductSales"];
    private string FeaturedProductSubtext => loading ? L["dashboardCheckingRetail"] : FeaturedProduct == null ? L["dashboardRetailWillAppear"] : L.T("dashboardFeaturedSub", FeaturedProduct.Quantity, FeaturedProduct.Revenue.ToString("C"));
    private string LatestActivityLabel => loading ? L["dashboardLoading"] : RecentHeadline?.Service ?? L["dashboardNoRecentActivity"];
    private string LatestActivitySubtext => loading ? L["dashboardLoadingRecent"] : RecentHeadline == null ? L["dashboardNewRecordsWillAppear"] : L.T("dashboardLatestSub", RecentHeadline.Worker, RecentHeadline.AmountPaid.ToString("C"));

    protected override async Task OnInitializedAsync()
    {
        WorkerContext.OnChange += HandleWorkerContextChanged;
        Finance.OnChange += HandleStoreChanged;
        await WorkerContext.InitializeAsync();
        await LoadData();
    }

    private async Task LoadData()
    {
        loading = true;
        totalRevenueValue = 0;
        totalTipsValue = 0;
        avgTicketValue = 0;
        recordCountValue = 0;
        revenueTrend = null;
        tipsTrend = null;
        avgTicketTrend = null;
        countTrend = null;
        recentRecords = null;
        topProducts = null;
        dayOfWeekData = null;
        combinedTimeline = null;
        serviceRevenueTotal = 0;
        productRevenueTotal = 0;
        goalProgress = null;
        netProfit = null;

        try
        {
            var wId = WorkerContext.SelectedWorkerId;
            var now = DateTime.Today;
            var monthStart = new DateTime(now.Year, now.Month, 1);

            var summary = await Finance.GetSummaryAsync(wId, monthStart, now);
            if (summary != null)
            {
                totalRevenueValue = summary.TotalRevenue;
                totalTipsValue = summary.TotalTips;
                recordCountValue = summary.RecordCount;
                avgTicketValue = summary.RecordCount > 0
                    ? summary.TotalRevenue / summary.RecordCount
                    : 0m;
            }

            try
            {
                var comparison = await Finance.GetMonthComparisonAsync(wId);
                if (comparison != null)
                {
                    revenueTrend = CalcTrend(comparison.CurrentRevenue, comparison.PreviousRevenue);
                    tipsTrend = CalcTrend(comparison.CurrentTips, comparison.PreviousTips);
                    avgTicketTrend = CalcTrend(comparison.CurrentAvgTicket, comparison.PreviousAvgTicket);
                    countTrend = CalcTrend(comparison.CurrentCount, comparison.PreviousCount);
                }
            }
            catch { }

            recentRecords = (await Finance.GetRecentAsync(wId, 5)).ToArray();

            try
            {
                topProducts = (await Finance.GetTopProductsAsync(wId, monthStart, now)).ToArray();
            }
            catch { topProducts = []; }

            try
            {
                dayOfWeekData = (await Finance.GetRevenueByDayOfWeekAsync(wId, monthStart, now)).ToArray();
            }
            catch { dayOfWeekData = []; }

            try
            {
                combinedTimeline = await Finance.GetCombinedTimelineAsync(wId, monthStart, now);
                if (combinedTimeline?.Points != null)
                {
                    serviceRevenueTotal = combinedTimeline.Points.Sum(p => p.ServiceRevenue);
                    productRevenueTotal = combinedTimeline.Points.Sum(p => p.ProductRevenue);
                }

                try { netProfit = await Finance.GetNetProfitAsync(wId, monthStart, now); }
                catch { netProfit = null; }
            }
            catch { }

            try { goalProgress = (await Finance.GetGoalProgressAsync(wId)).ToArray(); }
            catch { goalProgress = []; }
        }
        catch { }
        finally
        {
            loading = false;
            needsChartRender = true;
        }
    }

    private static decimal? CalcTrend(decimal current, decimal previous)
    {
        if (previous == 0) return current > 0 ? 100m : null;
        return Math.Round((current - previous) / previous * 100, 1);
    }

    private static string FormatGoalValue(decimal value, GoalType type)
    {
        return type == GoalType.Revenue ? value.ToString("C") : ((int)value).ToString();
    }

    private bool needsChartRender;

    private async void HandleWorkerContextChanged()
    {
        await InvokeAsync(LoadData);
    }

    private async void HandleStoreChanged()
    {
        await InvokeAsync(LoadData);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (needsChartRender)
        {
            needsChartRender = false;
            // Yield to let Blazor commit the DOM before JS reads canvas dimensions
            await Task.Yield();
            await RenderCharts();
        }
    }

    private async Task RenderCharts()
    {
        // Each chart is wrapped individually so one failure doesn't block others
        try
        {
            if (combinedTimeline?.Points != null && combinedTimeline.Points.Length > 0)
            {
                var labels = combinedTimeline.Points.Select(p => p.Date).ToArray();
                var datasets = new object[]
                {
                    new { label = L["dashboardRevenueServices"], data = combinedTimeline.Points.Select(p => p.ServiceRevenue).ToArray(), color = "#0d9488" },
                    new { label = L["dashboardRevenueProducts"], data = combinedTimeline.Points.Select(p => p.ProductRevenue).ToArray(), color = "#8b5cf6" }
                };
                await JS.InvokeVoidAsync("financeCharts.renderStackedBarChart", "combinedTimelineChart", labels, datasets);
            }
        }
        catch { }

        try
        {
            if (HasRevenueSources)
            {
                await JS.InvokeVoidAsync("financeCharts.renderDoughnutChart",
                    "revenueSourcesChart",
                    new[] { L["dashboardRevenueServices"], L["dashboardRevenueProducts"] },
                    new[] { serviceRevenueTotal, productRevenueTotal },
                    new[] { "#0d9488", "#8b5cf6" });
            }
        }
        catch { }

        try
        {
            if (dayOfWeekData != null && dayOfWeekData.Length > 0)
            {
                var labels = dayOfWeekData.Select(d => d.Day).ToArray();
                var data = dayOfWeekData.Select(d => d.Revenue).ToArray();
                var maxIdx = Array.IndexOf(data, data.Max());
                await JS.InvokeVoidAsync("financeCharts.renderMiniBarChart", "dayOfWeekChart", labels, data, maxIdx);
            }
        }
        catch { }
    }

    public void Dispose()
    {
        WorkerContext.OnChange -= HandleWorkerContextChanged;
        Finance.OnChange -= HandleStoreChanged;
    }
}

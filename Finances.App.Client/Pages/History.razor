@page "/history"
@implements IDisposable
@inject IFinanceStore Store
@inject MoneyFormat Money
@inject WorkerContextService WorkerContext
@inject ToastService Toast
@inject IStringLocalizer<AppStrings> L

<PageTitle>@L["Hist_Title"]</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="page-title mb-1">@L["Hist_Title"]</h1>
        <p class="text-muted mb-0">@L["Hist_Subtitle"]</p>
    </div>
</div>

<div class="d-flex flex-wrap align-items-center gap-3">
    <DateRangeFilter From="@dateFrom" To="@dateTo" OnRangeChanged="OnDateRangeChanged" />
    <div class="ms-auto" style="min-width: 240px;">
        <label class="visually-hidden-text" for="history-search">@L["Hist_SearchLabel"]</label>
        <input id="history-search" type="search" class="form-control form-control-sm"
               placeholder="@L["Hist_SearchPlaceholder"]" @oninput="OnSearchInput" />
    </div>
</div>

@if (allRecords == null)
{
    <LoadingSpinner />
}
else if (filtered.Count == 0)
{
    <div class="card p-5 text-center mt-3">
        <p class="text-muted mb-3">@L["Hist_Empty"]</p>
        <div><a class="btn btn-primary" href="record">@L["Nav_RecordService"]</a></div>
    </div>
}
else
{
    <div class="card mt-3">
        <div class="table-responsive" style="max-height: 70vh; overflow-y: auto;">
            <table class="table table-hover mb-0">
                <thead>
                    <tr>
                        <th aria-sort="@sort.AriaSort("date")">
                            <button type="button" class="sort-button" @onclick='() => SetSort("date")'>@L["Common_Date"] <span aria-hidden="true">@sort.Icon("date")</span></button>
                        </th>
                        <th>@L["Common_Worker"]</th>
                        <th>@L["Common_Service"]</th>
                        <th>@L["Common_Client"]</th>
                        <th aria-sort="@sort.AriaSort("amount")">
                            <button type="button" class="sort-button" @onclick='() => SetSort("amount")'>@L["Common_Amount"] <span aria-hidden="true">@sort.Icon("amount")</span></button>
                        </th>
                        <th>@L["Common_Commission"]</th>
                        <th>@L["Common_Tips"]</th>
                        <th aria-sort="@sort.AriaSort("worker_share")">
                            <button type="button" class="sort-button" @onclick='() => SetSort("worker_share")'>@L["Hist_WorkerShare"] <span aria-hidden="true">@sort.Icon("worker_share")</span></button>
                        </th>
                        <th>@L["Common_Notes"]</th>
                        <th style="width: 100px;">@L["Common_Actions"]</th>
                    </tr>
                </thead>
                <tbody>
                    <Virtualize Items="filtered" Context="r" SpacerElement="tr">
                        <tr @key="r.Id">
                            <td>@r.DatePerformed.ToDateKey()</td>
                            <td class="fw-semibold">@(r.Worker?.Name ?? "—")</td>
                            <td>@(r.Service?.Name ?? "—")</td>
                            <td class="text-muted">@(r.ClientName ?? "—")</td>
                            <td>@Money.Format(r.AmountPaid)</td>
                            <td>@r.CommissionPercentageApplied%</td>
                            <td>@Money.Format(r.Tips)</td>
                            <td class="fw-semibold">@Money.Format(r.WorkerShare)</td>
                            <td class="text-muted" style="max-width: 150px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;" title="@r.Notes">@(r.Notes ?? "")</td>
                            <td>
                                <button class="btn btn-sm btn-outline-secondary me-1" @onclick="() => OpenEditModal(r)">@L["Common_Edit"]</button>
                                <button class="btn btn-sm btn-outline-danger" @onclick="() => ConfirmDelete(r)">@L["Common_Delete"]</button>
                            </td>
                        </tr>
                    </Virtualize>
                </tbody>
                <tfoot>
                    <tr class="fw-bold" style="background-color: var(--body-bg);">
                        <td colspan="4">@L["Common_Totals"]</td>
                        <td>@Money.Format(totalAmount)</td>
                        <td></td>
                        <td>@Money.Format(totalTips)</td>
                        <td>@Money.Format(totalWorkerShare)</td>
                        <td colspan="2"></td>
                    </tr>
                </tfoot>
            </table>
        </div>
    </div>
}

<ModalDialog IsVisible="showEditModal" Title="@L["Hist_EditTitle"]" OnClose="CloseEditModal">
    <EditForm Model="@editModel" OnValidSubmit="HandleEditSubmit">
        <DataAnnotationsValidator />
        <div class="modal-body">
            <div class="row g-3">
                <div class="col-md-6">
                    <label class="form-label" for="edit-worker">@L["Common_Worker"]</label>
                    <select id="edit-worker" class="form-select" value="@editModel.WorkerId" @onchange="OnEditWorkerChanged">
                        @if (workers != null)
                        {
                            @foreach (var w in workers)
                            {
                                <option value="@w.Id">@w.Name</option>
                            }
                        }
                    </select>
                </div>
                <div class="col-md-6">
                    <label class="form-label" for="edit-service">@L["Common_Service"]</label>
                    <select id="edit-service" class="form-select" value="@editModel.ServiceId" @onchange="OnEditServiceChanged">
                        @if (services != null)
                        {
                            @foreach (var s in services)
                            {
                                <option value="@s.Id">@s.Name (@Money.Format(s.BasePrice))</option>
                            }
                        }
                    </select>
                </div>
                <div class="col-md-6">
                    <label class="form-label" for="edit-date">@L["Common_Date"]</label>
                    <InputDate id="edit-date" class="form-control" @bind-Value="editModel.DatePerformed" />
                </div>
                <div class="col-md-6">
                    <label class="form-label" for="edit-client">@L["Common_ClientName"]</label>
                    <InputText id="edit-client" class="form-control" @bind-Value="editModel.ClientName" placeholder="@L["Common_Optional"]" />
                </div>
                <div class="col-md-4">
                    <label class="form-label" for="edit-amount">@L["Hist_AmountPaid"]</label>
                    <InputNumber id="edit-amount" class="form-control" @bind-Value="editModel.AmountPaid" />
                </div>
                <div class="col-md-4">
                    <label class="form-label" for="edit-commission">@L["Common_Commission"]</label>
                    <InputNumber id="edit-commission" class="form-control" @bind-Value="editModel.CommissionPercentageApplied" />
                </div>
                <div class="col-md-4">
                    <label class="form-label" for="edit-tips">@L["Common_Tips"]</label>
                    <InputNumber id="edit-tips" class="form-control" @bind-Value="editModel.Tips" />
                </div>
                <div class="col-12">
                    <label class="form-label" for="edit-notes">@L["Common_Notes"]</label>
                    <InputTextArea id="edit-notes" class="form-control" @bind-Value="editModel.Notes" rows="2" />
                </div>
            </div>
        </div>
        <div class="modal-footer">
            <button type="button" class="btn btn-secondary" @onclick="CloseEditModal">@L["Common_Cancel"]</button>
            <button type="submit" class="btn btn-primary" disabled="@saving">
                @(saving ? L["Common_Saving"] : L["Common_Update"])
            </button>
        </div>
    </EditForm>
</ModalDialog>

<ConfirmDialog IsVisible="showDeleteConfirm"
               Title="@L["Hist_DeleteTitle"]"
               Message="@L["Hist_DeleteMessage", deleteTarget?.DatePerformed.ToDateKey() ?? ""]"
               ConfirmText="@L["Common_Delete"]"
               OnConfirm="HandleDelete"
               OnCancel="() => { showDeleteConfirm = false; }" />

@code {
    private List<ServiceRecord>? allRecords;
    private List<ServiceRecord> filtered = new();
    private List<Worker>? workers;
    private List<Service>? services;
    private DateTime? dateFrom;
    private DateTime? dateTo;
    private string searchTerm = string.Empty;
    private CancellationTokenSource? searchCts;
    private decimal totalAmount;
    private decimal totalTips;
    private decimal totalWorkerShare;
    private readonly SortState sort = new("date");

    private ServiceRecord editModel = new();
    private bool showEditModal;
    private bool saving;

    private ServiceRecord? deleteTarget;
    private bool showDeleteConfirm;

    protected override async Task OnInitializedAsync()
    {
        WorkerContext.OnChange += HandleWorkerChanged;
        await WorkerContext.InitializeAsync();
        allRecords = (await Store.GetServiceRecordsAsync()).ToList();
        workers = (await Store.GetWorkersAsync()).ToList();
        services = (await Store.GetServicesAsync()).ToList();
        ApplyFilter();
    }

    private void HandleWorkerChanged()
    {
        _ = InvokeAsync(() =>
        {
            ApplyFilter();
            StateHasChanged();
        });
    }

    public void Dispose()
    {
        WorkerContext.OnChange -= HandleWorkerChanged;
        searchCts?.Cancel();
    }

    private void OnDateRangeChanged((DateTime? From, DateTime? To) range)
    {
        dateFrom = range.From;
        dateTo = range.To;
        ApplyFilter();
    }

    private void SetSort(string column)
    {
        sort.Toggle(column);
        ApplyFilter();
    }

    private void OnSearchInput(ChangeEventArgs e)
    {
        searchTerm = e.Value?.ToString() ?? string.Empty;
        searchCts?.Cancel();
        searchCts = new CancellationTokenSource();
        _ = DebounceSearchAsync(searchCts.Token);
    }

    private async Task DebounceSearchAsync(CancellationToken token)
    {
        try
        {
            await Task.Delay(250, token);
            ApplyFilter();
            StateHasChanged();
        }
        catch (TaskCanceledException)
        {
            // Superseded by newer input.
        }
    }

    private static bool Matches(string? value, string term)
    {
        return value?.Contains(term, StringComparison.CurrentCultureIgnoreCase) == true;
    }

    // Recomputed on state changes rather than inside the render body, so the
    // filter+sort (and the footer totals) do not re-run on every re-render.
    private void ApplyFilter()
    {
        if (allRecords == null)
        {
            filtered = new();
            totalAmount = totalTips = totalWorkerShare = 0;
            return;
        }

        var q = allRecords.AsEnumerable();

        if (WorkerContext.SelectedWorkerId.HasValue)
            q = q.Where(r => r.WorkerId == WorkerContext.SelectedWorkerId.Value);

        if (dateFrom.HasValue)
            q = q.Where(r => r.DatePerformed.Date >= dateFrom.Value.Date);

        if (dateTo.HasValue)
            q = q.Where(r => r.DatePerformed.Date <= dateTo.Value.Date);

        var term = searchTerm.Trim();
        if (term.Length > 0)
        {
            q = q.Where(r => Matches(r.ClientName, term)
                || Matches(r.Notes, term)
                || Matches(r.Worker?.Name, term)
                || Matches(r.Service?.Name, term));
        }

        q = sort.Column switch
        {
            "date" => sort.Ascending ? q.OrderBy(r => r.DatePerformed) : q.OrderByDescending(r => r.DatePerformed),
            "amount" => sort.Ascending ? q.OrderBy(r => r.AmountPaid) : q.OrderByDescending(r => r.AmountPaid),
            "worker_share" => sort.Ascending ? q.OrderBy(r => r.WorkerShare) : q.OrderByDescending(r => r.WorkerShare),
            _ => q.OrderByDescending(r => r.DatePerformed)
        };

        filtered = q.ToList();
        totalAmount = filtered.Sum(r => r.AmountPaid);
        totalTips = filtered.Sum(r => r.Tips);
        totalWorkerShare = filtered.Sum(r => r.WorkerShare);
    }

    private void OpenEditModal(ServiceRecord record)
    {
        editModel = new ServiceRecord
        {
            Id = record.Id,
            WorkerId = record.WorkerId,
            ServiceId = record.ServiceId,
            DatePerformed = record.DatePerformed,
            AmountPaid = record.AmountPaid,
            CommissionPercentageApplied = record.CommissionPercentageApplied,
            Tips = record.Tips,
            ClientName = record.ClientName,
            Notes = record.Notes
        };
        showEditModal = true;
    }

    private void CloseEditModal() => showEditModal = false;

    private void OnEditWorkerChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var id))
        {
            editModel.WorkerId = id;
            var w = workers?.FirstOrDefault(x => x.Id == id);
            if (w != null)
                editModel.CommissionPercentageApplied = w.DefaultCommissionPercentage;
        }
    }

    private void OnEditServiceChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var id))
            editModel.ServiceId = id;
    }

    private async Task HandleEditSubmit()
    {
        saving = true;
        try
        {
            await Store.UpdateServiceRecordAsync(editModel.Id, editModel);
            Toast.Show(L["Hist_Updated"]);
            allRecords = (await Store.GetServiceRecordsAsync()).ToList();
            ApplyFilter();
            showEditModal = false;
        }
        catch (Exception ex)
        {
            Toast.Show(UserFacingError.Message(ex), ToastLevel.Error);
        }
        finally { saving = false; }
    }

    private void ConfirmDelete(ServiceRecord record)
    {
        deleteTarget = record;
        showDeleteConfirm = true;
    }

    private async Task HandleDelete()
    {
        if (deleteTarget == null) return;
        var deleted = deleteTarget;
        try
        {
            await Store.DeleteServiceRecordAsync(deleted.Id);
            // Undo re-adds the record under a fresh id; nothing references
            // service-record ids, so the restore is lossless.
            Toast.Show(L["Hist_Deleted"], ToastLevel.Success, L["Common_Undo"], async () =>
            {
                await Store.AddServiceRecordAsync(deleted);
                await InvokeAsync(async () =>
                {
                    allRecords = (await Store.GetServiceRecordsAsync()).ToList();
                    ApplyFilter();
                    StateHasChanged();
                });
            });
            allRecords = (await Store.GetServiceRecordsAsync()).ToList();
            ApplyFilter();
        }
        catch (Exception ex)
        {
            Toast.Show(UserFacingError.Message(ex), ToastLevel.Error);
        }
        showDeleteConfirm = false;
        deleteTarget = null;
    }
}

@page "/history"
@implements IDisposable
@inject IFinanceService Finance
@inject WorkerContextService WorkerContext
@inject ToastService Toast
@inject ExportService Export

<PageTitle>@L["historyPageTitle"]</PageTitle>

<div class="workspace-page">
    <section class="workspace-hero workspace-hero--history">
        <div class="workspace-hero-copy">
            <span class="workspace-kicker">@L["historyKicker"]</span>
            <h1 class="workspace-title">@L["historyTitle"]</h1>
            <p class="workspace-description">@L["historyDescription"]</p>
            <div class="workspace-hero-meta">
                <div class="workspace-hero-note">
                    <span>@L["historyWorkerScope"]</span>
                    <strong>@WorkerScopeLabel</strong>
                </div>
            </div>
        </div>
        <div class="workspace-hero-actions">
            @if (WorkerContext.SelectedWorkerId.HasValue)
            {
                <div class="workspace-action-row">
                    <button type="button" class="btn btn-outline-secondary btn-sm" @onclick="ClearWorkerFilter">@L["historyClearWorkerFilter"]</button>
                </div>
            }
            <div class="workspace-filter-panel">
                <span>@L["historyDateRange"]</span>
                <DateRangeFilter From="@dateFrom" To="@dateTo" OnRangeChanged="OnDateRangeChanged" />
            </div>
        </div>
    </section>

    @if (allRecords == null)
    {
        <LoadingSpinner />
    }
    else
    {
        var filtered = GetFilteredRecords();

        <div class="workspace-summary-grid">
            <div class="workspace-summary-card">
                <span class="workspace-summary-label">@L["historySummaryRecords"]</span>
                <strong>@filtered.Count</strong>
                <p>@L["historySummaryRecordsDesc"]</p>
            </div>
            <div class="workspace-summary-card">
                <span class="workspace-summary-label">@L["historySummaryRevenue"]</span>
                <strong>@filtered.Sum(r => r.AmountPaid).ToString("C")</strong>
                <p>@L["historySummaryRevenueDesc"]</p>
            </div>
            <div class="workspace-summary-card">
                <span class="workspace-summary-label">@L["historySummaryTips"]</span>
                <strong>@filtered.Sum(r => r.Tips).ToString("C")</strong>
                <p>@L["historySummaryTipsDesc"]</p>
            </div>
            <div class="workspace-summary-card">
                <span class="workspace-summary-label">@L["historySummaryWorkerShare"]</span>
                <strong>@filtered.Sum(r => r.WorkerShare).ToString("C")</strong>
                <p>@L["historySummaryWorkerShareDesc"]</p>
            </div>
        </div>

        @if (filtered.Count == 0)
        {
            <div class="workspace-empty-state">
                <p>@L["historyEmpty"]</p>
            </div>
        }
        else
        {
            <section class="workspace-panel">
                <div class="workspace-panel-header workspace-panel-header-split">
                    <div>
                        <p class="workspace-panel-eyebrow">@L["historyPanelEyebrow"]</p>
                        <h2>@L["historyPanelTitle"]</h2>
                        <p>@L["historyPanelDesc"]</p>
                    </div>
                    <span class="workspace-badge">@L.T(filtered.Count == 1 ? "historyBadgeRecords" : "historyBadgeRecordsPlural", filtered.Count)</span>
                    <div class="d-flex gap-2 ms-2">
                        <button class="btn btn-sm btn-outline-success" @onclick="() => ExportExcel(filtered)" disabled="@exporting">
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="me-1"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/></svg>
                            @L["commonExcel"]
                        </button>
                        <button class="btn btn-sm btn-outline-danger" @onclick="() => ExportPdf(filtered)" disabled="@exporting">
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="me-1"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/></svg>
                            @L["commonPdf"]
                        </button>
                    </div>
                </div>
                <div class="table-responsive">
                    <table class="data-table workspace-table">
                        <thead>
                            <tr>
                                <th @onclick='() => SetSort("date")' style="cursor:pointer;">
                                    @L["historyThDate"] @SortIcon("date")
                                </th>
                                <th>@L["historyThWorker"]</th>
                                <th>@L["historyThService"]</th>
                                <th>@L["historyThClient"]</th>
                                <th @onclick='() => SetSort("amount")' style="cursor:pointer;">
                                    @L["historyThAmount"] @SortIcon("amount")
                                </th>
                                <th>@L["historyThCommission"]</th>
                                <th>@L["historyThTips"]</th>
                                <th @onclick='() => SetSort("worker_share")' style="cursor:pointer;">
                                    @L["historyThWorkerShare"] @SortIcon("worker_share")
                                </th>
                                <th>@L["historyThNotes"]</th>
                                <th class="workspace-table-actions">@L["historyThActions"]</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var r in filtered)
                            {
                                <tr>
                                    <td>@r.DatePerformed.ToString("yyyy-MM-dd")</td>
                                    <td class="fw-semibold">@(r.Worker?.Name ?? "—")</td>
                                    <td>@(r.Service?.Name ?? "—")</td>
                                    <td class="text-muted">@(r.ClientName ?? "—")</td>
                                    <td>@r.AmountPaid.ToString("C")</td>
                                    <td>@r.CommissionPercentageApplied%</td>
                                    <td>@r.Tips.ToString("C")</td>
                                    <td class="fw-semibold">@r.WorkerShare.ToString("C")</td>
                                    <td class="text-muted" style="max-width: 150px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">@(r.Notes ?? "")</td>
                                    <td class="workspace-table-actions">
                                        <button class="btn btn-sm btn-outline-secondary me-1" @onclick="() => OpenEditModal(r)">@L["commonEdit"]</button>
                                        <button class="btn btn-sm btn-outline-danger" @onclick="() => ConfirmDelete(r)">@L["commonDelete"]</button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                        <tfoot>
                            <tr>
                                <td colspan="4">@L["historyTotals"]</td>
                                <td>@filtered.Sum(r => r.AmountPaid).ToString("C")</td>
                                <td></td>
                                <td>@filtered.Sum(r => r.Tips).ToString("C")</td>
                                <td>@filtered.Sum(r => r.WorkerShare).ToString("C")</td>
                                <td colspan="2"></td>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            </section>
        }
    }
</div>

@if (showEditModal)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.4);">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">@L["historyEditTitle"]</h5>
                    <button type="button" class="btn-close" @onclick="CloseEditModal"></button>
                </div>
                <EditForm Model="@editModel" OnValidSubmit="HandleEditSubmit">
                    <DataAnnotationsValidator />
                    <div class="modal-body">
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label class="form-label">@L["historyEditLabelWorker"]</label>
                                <select class="form-select" value="@editModel.WorkerId" @onchange="OnEditWorkerChanged">
                                    @if (workers != null)
                                    {
                                        @foreach (var w in workers)
                                        {
                                            <option value="@w.Id">@w.Name</option>
                                        }
                                    }
                                </select>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">@L["historyEditLabelService"]</label>
                                <select class="form-select" value="@editModel.ServiceId" @onchange="OnEditServiceChanged">
                                    @if (services != null)
                                    {
                                        @foreach (var s in services)
                                        {
                                            <option value="@s.Id">@s.Name (@s.BasePrice.ToString("C"))</option>
                                        }
                                    }
                                </select>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">@L["historyEditLabelDate"]</label>
                                <InputDate class="form-control" @bind-Value="editModel.DatePerformed" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">@L["historyEditLabelClient"]</label>
                                <InputText class="form-control" @bind-Value="editModel.ClientName" placeholder="@L["historyEditClientPlaceholder"]" />
                            </div>
                            <div class="col-md-4">
                                <label class="form-label">@L["historyEditLabelAmount"]</label>
                                <InputNumber class="form-control" @bind-Value="editModel.AmountPaid" />
                            </div>
                            <div class="col-md-4">
                                <label class="form-label">@L["historyEditLabelCommission"]</label>
                                <InputNumber class="form-control" @bind-Value="editModel.CommissionPercentageApplied" />
                            </div>
                            <div class="col-md-4">
                                <label class="form-label">@L["historyEditLabelTips"]</label>
                                <InputNumber class="form-control" @bind-Value="editModel.Tips" />
                            </div>
                            <div class="col-12">
                                <label class="form-label">@L["historyEditLabelNotes"]</label>
                                <InputTextArea class="form-control" @bind-Value="editModel.Notes" rows="2" />
                            </div>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" @onclick="CloseEditModal">@L["historyEditCancel"]</button>
                        <button type="submit" class="btn btn-primary" disabled="@saving">
                            @(saving ? L["historyEditSaving"] : L["historyEditUpdate"])
                        </button>
                    </div>
                </EditForm>
            </div>
        </div>
    </div>
}

<ConfirmDialog IsVisible="showDeleteConfirm"
               Title="@L["historyDeleteTitle"]"
               Message="@L.T("historyDeleteMsg", deleteTarget?.DatePerformed.ToString("yyyy-MM-dd") ?? "")"
               ConfirmText="@L["historyDeleteConfirm"]"
               OnConfirm="HandleDelete"
               OnCancel="() => { showDeleteConfirm = false; }" />

@code {
    private List<ServiceRecord>? allRecords;
    private List<Worker>? workers;
    private List<Service>? services;
    private DateTime? dateFrom;
    private DateTime? dateTo;
    private string sortColumn = "date";
    private bool sortAsc = false;

    private ServiceRecord editModel = new();
    private bool showEditModal;
    private bool saving;

    private ServiceRecord? deleteTarget;
    private bool showDeleteConfirm;
    private bool exporting;

    private async Task ExportExcel(List<ServiceRecord> records)
    {
        exporting = true;
        try
        {
            var headers = new[] { "Date", "Worker", "Service", "Client", "Amount", "Commission %", "Tips", "Worker Share", "Notes" };
            var rows = records.Select(r => new object[]
            {
                r.DatePerformed.ToString("yyyy-MM-dd"),
                r.Worker?.Name ?? "",
                r.Service?.Name ?? "",
                r.ClientName ?? "",
                r.AmountPaid,
                r.CommissionPercentageApplied,
                r.Tips,
                r.WorkerShare,
                r.Notes ?? ""
            }).ToArray();
            await Export.ExportExcelAsync("service-history.xlsx", "Service History", headers, rows);
        }
        catch { Toast.Show(L["commonExportFailed"], ToastLevel.Error); }
        finally { exporting = false; }
    }

    private async Task ExportPdf(List<ServiceRecord> records)
    {
        exporting = true;
        try
        {
            var headers = new[] { "Date", "Worker", "Service", "Client", "Amount", "Comm %", "Tips", "Worker Share" };
            var rows = records.Select(r => new object[]
            {
                r.DatePerformed.ToString("yyyy-MM-dd"),
                r.Worker?.Name ?? "",
                r.Service?.Name ?? "",
                r.ClientName ?? "",
                r.AmountPaid.ToString("F2"),
                $"{r.CommissionPercentageApplied}%",
                r.Tips.ToString("F2"),
                r.WorkerShare.ToString("F2")
            }).ToArray();
            var subtitle = dateFrom.HasValue && dateTo.HasValue
                ? $"{dateFrom.Value:yyyy-MM-dd} to {dateTo.Value:yyyy-MM-dd}"
                : null;
            await Export.ExportPdfAsync("service-history.pdf", "Service History", headers, rows, subtitle, true);
        }
        catch { Toast.Show(L["commonExportFailed"], ToastLevel.Error); }
        finally { exporting = false; }
    }

    protected override async Task OnInitializedAsync()
    {
        Finance.OnChange += HandleStoreChanged;
        WorkerContext.OnChange += HandleWorkerContextChanged;
        await LoadDataAsync();
    }

    private async Task LoadDataAsync()
    {
        await WorkerContext.InitializeAsync();
        allRecords = (await Finance.GetServiceRecordsAsync()).ToList();
        workers = (await Finance.GetWorkersAsync()).ToList();
        services = (await Finance.GetServicesAsync()).ToList();
        await WorkerContext.EnsureWorkerExistsAsync((workers ?? []).Select(worker => worker.Id));
    }

    private string WorkerScopeLabel => WorkerContext.SelectedWorkerId.HasValue ? $"{SelectedWorkerName} only" : "All workers";
    private string SelectedWorkerName => workers?.FirstOrDefault(worker => worker.Id == WorkerContext.SelectedWorkerId)?.Name ?? "Selected worker";

    private void OnDateRangeChanged((DateTime? From, DateTime? To) range)
    {
        dateFrom = range.From;
        dateTo = range.To;
    }

    private List<ServiceRecord> GetFilteredRecords()
    {
        if (allRecords == null) return new();

        var q = allRecords.AsEnumerable();

        if (WorkerContext.SelectedWorkerId.HasValue)
            q = q.Where(r => r.WorkerId == WorkerContext.SelectedWorkerId.Value);

        if (dateFrom.HasValue)
            q = q.Where(r => r.DatePerformed.Date >= dateFrom.Value.Date);

        if (dateTo.HasValue)
            q = q.Where(r => r.DatePerformed.Date <= dateTo.Value.Date);

        q = sortColumn switch
        {
            "date" => sortAsc ? q.OrderBy(r => r.DatePerformed) : q.OrderByDescending(r => r.DatePerformed),
            "amount" => sortAsc ? q.OrderBy(r => r.AmountPaid) : q.OrderByDescending(r => r.AmountPaid),
            "worker_share" => sortAsc ? q.OrderBy(r => r.WorkerShare) : q.OrderByDescending(r => r.WorkerShare),
            _ => q.OrderByDescending(r => r.DatePerformed)
        };

        return q.ToList();
    }

    private void SetSort(string column)
    {
        if (sortColumn == column)
            sortAsc = !sortAsc;
        else
        {
            sortColumn = column;
            sortAsc = true;
        }
    }

    private string SortIcon(string column)
    {
        if (sortColumn != column) return "";
        return sortAsc ? "▲" : "▼";
    }

    private async Task ClearWorkerFilter()
    {
        await WorkerContext.SetWorkerAsync(null);
    }

    private void OpenEditModal(ServiceRecord record)
    {
        editModel = new ServiceRecord
        {
            Id = record.Id,
            WorkerId = record.WorkerId,
            ServiceId = record.ServiceId,
            DatePerformed = record.DatePerformed,
            AmountPaid = record.AmountPaid,
            CommissionPercentageApplied = record.CommissionPercentageApplied,
            Tips = record.Tips,
            ClientName = record.ClientName,
            Notes = record.Notes
        };
        showEditModal = true;
    }

    private void CloseEditModal() => showEditModal = false;

    private void OnEditWorkerChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var id))
        {
            editModel.WorkerId = id;
            var w = workers?.FirstOrDefault(x => x.Id == id);
            if (w != null)
                editModel.CommissionPercentageApplied = w.DefaultCommissionPercentage;
        }
    }

    private void OnEditServiceChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var id))
            editModel.ServiceId = id;
    }

    private async Task HandleEditSubmit()
    {
        saving = true;
        try
        {
            await Finance.UpdateServiceRecordAsync(editModel.Id, editModel);
            Toast.Show(L["historyToastUpdated"]);
            allRecords = (await Finance.GetServiceRecordsAsync()).ToList();
            showEditModal = false;
        }
        catch (Exception ex)
        {
            Toast.Show(ex is InvalidDataException ? ex.Message : L["historyToastUpdateFailed"], ToastLevel.Error);
        }
        finally { saving = false; }
    }

    private void ConfirmDelete(ServiceRecord record)
    {
        deleteTarget = record;
        showDeleteConfirm = true;
    }

    private async Task HandleDelete()
    {
        if (deleteTarget == null) return;
        try
        {
            await Finance.DeleteServiceRecordAsync(deleteTarget.Id);
            Toast.Show(L["historyToastDeleted"]);
            allRecords = (await Finance.GetServiceRecordsAsync()).ToList();
        }
        catch
        {
            Toast.Show(L["historyToastDeleteFailed"], ToastLevel.Error);
        }
        showDeleteConfirm = false;
        deleteTarget = null;
    }

    private async void HandleWorkerContextChanged()
    {
        await InvokeAsync(StateHasChanged);
    }

    private async void HandleStoreChanged()
    {
        await InvokeAsync(async () =>
        {
            await LoadDataAsync();
            StateHasChanged();
        });
    }

    public void Dispose()
    {
        WorkerContext.OnChange -= HandleWorkerContextChanged;
        Finance.OnChange -= HandleStoreChanged;
    }
}

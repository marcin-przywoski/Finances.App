@page "/history"
@implements IDisposable
@inject IFinanceStore Store
@inject MoneyFormat Money
@inject WorkerContextService WorkerContext
@inject ToastService Toast

<PageTitle>History</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="page-title mb-1">Service History</h1>
        <p class="text-muted mb-0">View, edit, and manage past service records.</p>
    </div>
</div>

<DateRangeFilter From="@dateFrom" To="@dateTo" OnRangeChanged="OnDateRangeChanged" />

@if (allRecords == null)
{
    <LoadingSpinner />
}
else if (filtered.Count == 0)
{
    <div class="card p-5 text-center mt-3">
        <p class="text-muted mb-3">No records found for the selected period.</p>
        <div><a class="btn btn-primary" href="record">Record Service</a></div>
    </div>
}
else
{
    <div class="card mt-3">
        <div class="table-responsive">
            <table class="table table-hover mb-0">
                <thead>
                    <tr>
                        <th aria-sort="@sort.AriaSort("date")">
                            <button type="button" class="sort-button" @onclick='() => SetSort("date")'>Date <span aria-hidden="true">@sort.Icon("date")</span></button>
                        </th>
                        <th>Worker</th>
                        <th>Service</th>
                        <th>Client</th>
                        <th aria-sort="@sort.AriaSort("amount")">
                            <button type="button" class="sort-button" @onclick='() => SetSort("amount")'>Amount <span aria-hidden="true">@sort.Icon("amount")</span></button>
                        </th>
                        <th>Commission</th>
                        <th>Tips</th>
                        <th aria-sort="@sort.AriaSort("worker_share")">
                            <button type="button" class="sort-button" @onclick='() => SetSort("worker_share")'>Worker Share <span aria-hidden="true">@sort.Icon("worker_share")</span></button>
                        </th>
                        <th>Notes</th>
                        <th style="width: 100px;">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var r in filtered)
                    {
                        <tr>
                            <td>@r.DatePerformed.ToDateKey()</td>
                            <td class="fw-semibold">@(r.Worker?.Name ?? "—")</td>
                            <td>@(r.Service?.Name ?? "—")</td>
                            <td class="text-muted">@(r.ClientName ?? "—")</td>
                            <td>@Money.Format(r.AmountPaid)</td>
                            <td>@r.CommissionPercentageApplied%</td>
                            <td>@Money.Format(r.Tips)</td>
                            <td class="fw-semibold">@Money.Format(r.WorkerShare)</td>
                            <td class="text-muted" style="max-width: 150px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">@(r.Notes ?? "")</td>
                            <td>
                                <button class="btn btn-sm btn-outline-secondary me-1" @onclick="() => OpenEditModal(r)">Edit</button>
                                <button class="btn btn-sm btn-outline-danger" @onclick="() => ConfirmDelete(r)">Delete</button>
                            </td>
                        </tr>
                    }
                </tbody>
                <tfoot>
                    <tr class="fw-bold" style="background-color: var(--body-bg);">
                        <td colspan="4">Totals</td>
                        <td>@Money.Format(filtered.Sum(r => r.AmountPaid))</td>
                        <td></td>
                        <td>@Money.Format(filtered.Sum(r => r.Tips))</td>
                        <td>@Money.Format(filtered.Sum(r => r.WorkerShare))</td>
                        <td colspan="2"></td>
                    </tr>
                </tfoot>
            </table>
        </div>
    </div>
}

<ModalDialog IsVisible="showEditModal" Title="Edit Service Record" OnClose="CloseEditModal">
    <EditForm Model="@editModel" OnValidSubmit="HandleEditSubmit">
        <DataAnnotationsValidator />
        <div class="modal-body">
            <div class="row g-3">
                <div class="col-md-6">
                    <label class="form-label" for="edit-worker">Worker</label>
                    <select id="edit-worker" class="form-select" value="@editModel.WorkerId" @onchange="OnEditWorkerChanged">
                        @if (workers != null)
                        {
                            @foreach (var w in workers)
                            {
                                <option value="@w.Id">@w.Name</option>
                            }
                        }
                    </select>
                </div>
                <div class="col-md-6">
                    <label class="form-label" for="edit-service">Service</label>
                    <select id="edit-service" class="form-select" value="@editModel.ServiceId" @onchange="OnEditServiceChanged">
                        @if (services != null)
                        {
                            @foreach (var s in services)
                            {
                                <option value="@s.Id">@s.Name (@Money.Format(s.BasePrice))</option>
                            }
                        }
                    </select>
                </div>
                <div class="col-md-6">
                    <label class="form-label" for="edit-date">Date</label>
                    <InputDate id="edit-date" class="form-control" @bind-Value="editModel.DatePerformed" />
                </div>
                <div class="col-md-6">
                    <label class="form-label" for="edit-client">Client Name</label>
                    <InputText id="edit-client" class="form-control" @bind-Value="editModel.ClientName" placeholder="Optional" />
                </div>
                <div class="col-md-4">
                    <label class="form-label" for="edit-amount">Amount Paid</label>
                    <InputNumber id="edit-amount" class="form-control" @bind-Value="editModel.AmountPaid" />
                </div>
                <div class="col-md-4">
                    <label class="form-label" for="edit-commission">Commission %</label>
                    <InputNumber id="edit-commission" class="form-control" @bind-Value="editModel.CommissionPercentageApplied" />
                </div>
                <div class="col-md-4">
                    <label class="form-label" for="edit-tips">Tips</label>
                    <InputNumber id="edit-tips" class="form-control" @bind-Value="editModel.Tips" />
                </div>
                <div class="col-12">
                    <label class="form-label" for="edit-notes">Notes</label>
                    <InputTextArea id="edit-notes" class="form-control" @bind-Value="editModel.Notes" rows="2" />
                </div>
            </div>
        </div>
        <div class="modal-footer">
            <button type="button" class="btn btn-secondary" @onclick="CloseEditModal">Cancel</button>
            <button type="submit" class="btn btn-primary" disabled="@saving">
                @(saving ? "Saving..." : "Update")
            </button>
        </div>
    </EditForm>
</ModalDialog>

<ConfirmDialog IsVisible="showDeleteConfirm"
               Title="Delete Record"
               Message="@($"Delete this service record from {deleteTarget?.DatePerformed.ToDateKey()}? You can undo right after deleting.")"
               ConfirmText="Delete"
               OnConfirm="HandleDelete"
               OnCancel="() => { showDeleteConfirm = false; }" />

@code {
    private List<ServiceRecord>? allRecords;
    private List<ServiceRecord> filtered = new();
    private List<Worker>? workers;
    private List<Service>? services;
    private DateTime? dateFrom;
    private DateTime? dateTo;
    private readonly SortState sort = new("date");

    private ServiceRecord editModel = new();
    private bool showEditModal;
    private bool saving;

    private ServiceRecord? deleteTarget;
    private bool showDeleteConfirm;

    protected override async Task OnInitializedAsync()
    {
        WorkerContext.OnChange += HandleWorkerChanged;
        await WorkerContext.InitializeAsync();
        allRecords = (await Store.GetServiceRecordsAsync()).ToList();
        workers = (await Store.GetWorkersAsync()).ToList();
        services = (await Store.GetServicesAsync()).ToList();
        ApplyFilter();
    }

    private void HandleWorkerChanged()
    {
        _ = InvokeAsync(() =>
        {
            ApplyFilter();
            StateHasChanged();
        });
    }

    public void Dispose()
    {
        WorkerContext.OnChange -= HandleWorkerChanged;
    }

    private void OnDateRangeChanged((DateTime? From, DateTime? To) range)
    {
        dateFrom = range.From;
        dateTo = range.To;
        ApplyFilter();
    }

    private void SetSort(string column)
    {
        sort.Toggle(column);
        ApplyFilter();
    }

    // Recomputed on state changes rather than inside the render body, so the
    // filter+sort does not re-run on every re-render.
    private void ApplyFilter()
    {
        if (allRecords == null)
        {
            filtered = new();
            return;
        }

        var q = allRecords.AsEnumerable();

        if (WorkerContext.SelectedWorkerId.HasValue)
            q = q.Where(r => r.WorkerId == WorkerContext.SelectedWorkerId.Value);

        if (dateFrom.HasValue)
            q = q.Where(r => r.DatePerformed.Date >= dateFrom.Value.Date);

        if (dateTo.HasValue)
            q = q.Where(r => r.DatePerformed.Date <= dateTo.Value.Date);

        q = sort.Column switch
        {
            "date" => sort.Ascending ? q.OrderBy(r => r.DatePerformed) : q.OrderByDescending(r => r.DatePerformed),
            "amount" => sort.Ascending ? q.OrderBy(r => r.AmountPaid) : q.OrderByDescending(r => r.AmountPaid),
            "worker_share" => sort.Ascending ? q.OrderBy(r => r.WorkerShare) : q.OrderByDescending(r => r.WorkerShare),
            _ => q.OrderByDescending(r => r.DatePerformed)
        };

        filtered = q.ToList();
    }

    private void OpenEditModal(ServiceRecord record)
    {
        editModel = new ServiceRecord
        {
            Id = record.Id,
            WorkerId = record.WorkerId,
            ServiceId = record.ServiceId,
            DatePerformed = record.DatePerformed,
            AmountPaid = record.AmountPaid,
            CommissionPercentageApplied = record.CommissionPercentageApplied,
            Tips = record.Tips,
            ClientName = record.ClientName,
            Notes = record.Notes
        };
        showEditModal = true;
    }

    private void CloseEditModal() => showEditModal = false;

    private void OnEditWorkerChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var id))
        {
            editModel.WorkerId = id;
            var w = workers?.FirstOrDefault(x => x.Id == id);
            if (w != null)
                editModel.CommissionPercentageApplied = w.DefaultCommissionPercentage;
        }
    }

    private void OnEditServiceChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var id))
            editModel.ServiceId = id;
    }

    private async Task HandleEditSubmit()
    {
        saving = true;
        try
        {
            await Store.UpdateServiceRecordAsync(editModel.Id, editModel);
            Toast.Show("Record updated");
            allRecords = (await Store.GetServiceRecordsAsync()).ToList();
            ApplyFilter();
            showEditModal = false;
        }
        catch (Exception ex)
        {
            Toast.Show(UserFacingError.Message(ex), ToastLevel.Error);
        }
        finally { saving = false; }
    }

    private void ConfirmDelete(ServiceRecord record)
    {
        deleteTarget = record;
        showDeleteConfirm = true;
    }

    private async Task HandleDelete()
    {
        if (deleteTarget == null) return;
        var deleted = deleteTarget;
        try
        {
            await Store.DeleteServiceRecordAsync(deleted.Id);
            // Undo re-adds the record under a fresh id; nothing references
            // service-record ids, so the restore is lossless.
            Toast.Show("Record deleted", ToastLevel.Success, "Undo", async () =>
            {
                await Store.AddServiceRecordAsync(deleted);
                await InvokeAsync(async () =>
                {
                    allRecords = (await Store.GetServiceRecordsAsync()).ToList();
                    ApplyFilter();
                    StateHasChanged();
                });
            });
            allRecords = (await Store.GetServiceRecordsAsync()).ToList();
            ApplyFilter();
        }
        catch (Exception ex)
        {
            Toast.Show(UserFacingError.Message(ex), ToastLevel.Error);
        }
        showDeleteConfirm = false;
        deleteTarget = null;
    }
}

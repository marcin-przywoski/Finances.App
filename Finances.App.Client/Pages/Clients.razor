@page "/clients"
@implements IDisposable
@inject IFinanceService Finance
@inject ToastService Toast
@inject ExportService Export
@inject NavigationManager Nav

<div class="workspace-page">
    <section class="workspace-hero workspace-hero--catalog">
        <div class="workspace-hero-copy">
            <p class="workspace-kicker">@L["clientsKicker"]</p>
            <h1 class="workspace-title">@L["clientsTitle"]</h1>
            <p class="workspace-description">@L["clientsDescription"]</p>
        </div>
        <div class="workspace-hero-actions">
            <button class="btn btn-primary" @onclick="OpenAddModal">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="me-1"><path d="M12 5v14M5 12h14"/></svg>
                @L["clientsAddButton"]
            </button>

            <div class="workspace-hero-meta">
                <div class="workspace-hero-note">
                    <span>@L["clientsTotalClients"]</span>
                    <strong>@clients.Count</strong>
                </div>
            </div>
        </div>
    </section>

    @if (!string.IsNullOrWhiteSpace(searchQuery))
    {
        <div class="workspace-summary-grid">
            <div class="workspace-summary-card">
                <span class="workspace-summary-label">@L["clientsSearchResults"]</span>
                <strong>@filteredClients.Count</strong>
                <p>@L.T("clientsSearchOf", clients.Count)</p>
            </div>
        </div>
    }

    <section class="workspace-panel">
        <div class="workspace-panel-header workspace-panel-header-split d-flex">
            <div>
                <p class="workspace-panel-eyebrow">@L["clientsPanelEyebrow"]</p>
                <h2>@L["clientsPanelTitle"]</h2>
            </div>
            <div>
                <input type="text" class="form-control" placeholder="@L["clientsSearchPlaceholder"]"
                       @bind="searchQuery" @bind:event="oninput" style="min-width: 220px;" />
            </div>
            <div class="d-flex gap-2 ms-2">
                <button class="btn btn-sm btn-outline-success" @onclick="ExportExcel" disabled="@exporting">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="me-1"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/></svg>
                    @L["commonExcel"]
                </button>
                <button class="btn btn-sm btn-outline-danger" @onclick="ExportPdf" disabled="@exporting">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="me-1"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/></svg>
                    @L["commonPdf"]
                </button>
            </div>
        </div>

        @if (filteredClients.Count == 0)
        {
            <div class="workspace-empty-state">
                <p>@(clients.Count == 0 ? L["clientsNoClients"] : L["clientsNoMatch"])</p>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="data-table">
                    <thead>
                        <tr>
                            <th>@L["clientsThName"]</th>
                            <th>@L["clientsThPhone"]</th>
                            <th>@L["clientsThEmail"]</th>
                            <th>@L["clientsThCreated"]</th>
                            <th class="text-end">@L["clientsThActions"]</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var c in filteredClients)
                        {
                            <tr>
                                <td>
                                    <a class="btn btn-link p-0 text-decoration-none fw-bold" href="/clients/@c.Id">
                                        @c.Name
                                    </a>
                                </td>
                                <td class="text-muted">@(c.Phone ?? "—")</td>
                                <td class="text-muted">@(c.Email ?? "—")</td>
                                <td class="text-muted">@c.CreatedDate.ToString("yyyy-MM-dd")</td>
                                <td class="text-end">
                                    <button class="btn btn-sm btn-outline-primary me-1" @onclick="() => OpenEditModal(c)" title="@L["commonEdit"]">
                                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
                                    </button>
                                    <button class="btn btn-sm btn-outline-danger" @onclick="() => ConfirmDelete(c)" title="@L["commonDelete"]">
                                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="3 6 5 6 21 6"/><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/></svg>
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </section>

    @* ── Detail panel ── *@
    @if (detailResult is not null)
    {
        <section class="workspace-panel">
            <div class="workspace-panel-header workspace-panel-header-split d-flex">
                <div>
                    <p class="workspace-panel-eyebrow">@L["clientsDetailEyebrow"]</p>
                    <h2>@detailResult.Client.Name</h2>
                    @if (!string.IsNullOrWhiteSpace(detailResult.Client.Notes))
                    {
                        <p>@detailResult.Client.Notes</p>
                    }
                </div>
                <button class="btn btn-sm btn-outline-primary" @onclick="CloseDetail">@L["clientsDetailClose"]</button>
            </div>

            <div class="workspace-summary-grid mb-3">
                <div class="workspace-summary-card">
                    <span class="workspace-summary-label">@L["clientsDetailVisits"]</span>
                    <strong>@detailResult.TotalVisits</strong>
                </div>
                <div class="workspace-summary-card">
                    <span class="workspace-summary-label">@L["clientsDetailSpend"]</span>
                    <strong>@detailResult.TotalSpend.ToString("N2") PLN</strong>
                </div>
                <div class="workspace-summary-card">
                    <span class="workspace-summary-label">@L["clientsDetailLastVisit"]</span>
                    <strong>@(detailResult.LastVisit?.ToString("yyyy-MM-dd") ?? "—")</strong>
                </div>
                <div class="workspace-summary-card">
                    <span class="workspace-summary-label">@L["clientsDetailSince"]</span>
                    <strong>@detailResult.Client.CreatedDate.ToString("yyyy-MM-dd")</strong>
                </div>
            </div>

            @if (detailResult.RecentServices.Count > 0)
            {
                <h6 class="mt-3 mb-2">@L["clientsDetailRecentServices"]</h6>
                <div class="table-responsive">
                    <table class="data-table">
                        <thead>
                            <tr><th>@L["clientsDetailThDate"]</th><th>@L["clientsDetailThService"]</th><th>@L["clientsDetailThWorker"]</th><th class="text-end">@L["clientsDetailThAmount"]</th><th class="text-end">@L["clientsDetailThTips"]</th></tr>
                        </thead>
                        <tbody>
                            @foreach (var r in detailResult.RecentServices)
                            {
                                <tr>
                                    <td>@r.Date</td>
                                    <td>@r.Service</td>
                                    <td>@r.Worker</td>
                                    <td class="text-end">@r.AmountPaid.ToString("N2")</td>
                                    <td class="text-end">@r.Tips.ToString("N2")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }

            @if (detailResult.RecentProductSales.Count > 0)
            {
                <h6 class="mt-3 mb-2">@L["clientsDetailRecentPurchases"]</h6>
                <div class="table-responsive">
                    <table class="data-table">
                        <thead>
                            <tr><th>@L["clientsDetailThDate"]</th><th>@L["clientsDetailThProduct"]</th><th>@L["clientsDetailThQty"]</th><th class="text-end">@L["clientsDetailThTotal"]</th><th>@L["clientsDetailThSoldBy"]</th></tr>
                        </thead>
                        <tbody>
                            @foreach (var s in detailResult.RecentProductSales)
                            {
                                <tr>
                                    <td>@s.Date</td>
                                    <td>@s.Product</td>
                                    <td>@s.Quantity</td>
                                    <td class="text-end">@s.Total.ToString("N2")</td>
                                    <td>@(s.Worker ?? "—")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }

            @if (detailResult.TotalVisits == 0)
            {
                <div class="workspace-empty-state" style="min-height: 120px;">
                    <p>@L["clientsDetailNoHistory"]</p>
                </div>
            }
        </section>
    }
</div>

@* ── Add / Edit modal ── *@
@if (showModal)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">@(isEditing ? L["clientsModalTitleEdit"] : L["clientsModalTitleAdd"])</h5>
                    <button type="button" class="btn-close" @onclick="CloseModal"></button>
                </div>
                <EditForm Model="formModel" OnValidSubmit="HandleSubmit">
                    <DataAnnotationsValidator />
                    <div class="modal-body">
                        <div class="mb-3">
                            <label class="form-label">@L["clientsModalLabelName"]</label>
                            <InputText class="form-control" @bind-Value="formModel.Name" />
                            <ValidationMessage For="() => formModel.Name" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label">@L["clientsModalLabelPhone"]</label>
                            <InputText class="form-control" @bind-Value="formModel.Phone" placeholder="@L["clientsModalPhonePlaceholder"]" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label">@L["clientsModalLabelEmail"]</label>
                            <InputText class="form-control" @bind-Value="formModel.Email" placeholder="@L["clientsModalEmailPlaceholder"]" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label">@L["clientsModalLabelNotes"]</label>
                            <InputTextArea class="form-control" @bind-Value="formModel.Notes" rows="3" placeholder="@L["clientsModalNotesPlaceholder"]" />
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-outline-secondary" @onclick="CloseModal">@L["clientsModalCancel"]</button>
                        <button type="submit" class="btn btn-primary">@(isEditing ? L["clientsModalSaveChanges"] : L["clientsModalAddClient"])</button>
                    </div>
                </EditForm>
            </div>
        </div>
    </div>
}

@* ── Delete confirmation ── *@
@if (clientToDelete is not null)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog modal-sm">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">@L["clientsDeleteTitle"]</h5>
                    <button type="button" class="btn-close" @onclick="() => clientToDelete = null"></button>
                </div>
                <div class="modal-body">
                    <p>@L.T("clientsDeleteMsg", clientToDelete.Name)</p>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" @onclick="() => clientToDelete = null">@L["clientsDeleteCancel"]</button>
                    <button type="button" class="btn btn-danger" @onclick="HandleDelete">@L["clientsDeleteConfirm"]</button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private List<SalonClient> clients = [];
    private SalonClient formModel = new();
    private SalonClient? clientToDelete;
    private ClientDetailResult? detailResult;
    private bool showModal;
    private bool isEditing;
    private bool exporting;
    private string searchQuery = string.Empty;

    private async Task ExportExcel()
    {
        exporting = true;
        try
        {
            var headers = new[] { "Name", "Phone", "Email", "Created" };
            var rows = filteredClients.Select(c => new object[]
            {
                c.Name, c.Phone ?? "", c.Email ?? "", c.CreatedDate.ToString("yyyy-MM-dd")
            }).ToArray();
            await Export.ExportExcelAsync("clients.xlsx", "Clients", headers, rows);
        }
        catch { Toast.Show(L["commonExportFailed"], ToastLevel.Error); }
        finally { exporting = false; }
    }

    private async Task ExportPdf()
    {
        exporting = true;
        try
        {
            var headers = new[] { "Name", "Phone", "Email", "Created" };
            var rows = filteredClients.Select(c => new object[]
            {
                c.Name, c.Phone ?? "", c.Email ?? "", c.CreatedDate.ToString("yyyy-MM-dd")
            }).ToArray();
            await Export.ExportPdfAsync("clients.pdf", "Client Directory", headers, rows);
        }
        catch { Toast.Show(L["commonExportFailed"], ToastLevel.Error); }
        finally { exporting = false; }
    }

    private List<SalonClient> filteredClients => string.IsNullOrWhiteSpace(searchQuery)
        ? clients
        : clients.Where(c =>
            c.Name.Contains(searchQuery, StringComparison.CurrentCultureIgnoreCase) ||
            (c.Phone?.Contains(searchQuery, StringComparison.CurrentCultureIgnoreCase) == true) ||
            (c.Email?.Contains(searchQuery, StringComparison.CurrentCultureIgnoreCase) == true))
          .ToList();

    protected override async Task OnInitializedAsync()
    {
        Finance.OnChange += HandleStoreChanged;
        await LoadClients();
    }

    private async Task LoadClients()
    {
        clients = (await Finance.GetClientsAsync()).ToList();
    }

    private void OpenAddModal()
    {
        formModel = new SalonClient();
        isEditing = false;
        showModal = true;
    }

    private void OpenEditModal(SalonClient client)
    {
        formModel = new SalonClient
        {
            Id = client.Id,
            Name = client.Name,
            Phone = client.Phone,
            Email = client.Email,
            Notes = client.Notes,
            CreatedDate = client.CreatedDate
        };
        isEditing = true;
        showModal = true;
    }

    private async Task HandleSubmit()
    {
        try
        {
            if (isEditing)
            {
                await Finance.UpdateClientAsync(formModel.Id, formModel);
                Toast.Show(L["clientsToastUpdated"]);
            }
            else
            {
                await Finance.AddClientAsync(formModel);
                Toast.Show(L["clientsToastAdded"]);
            }

            showModal = false;
            await LoadClients();
        }
        catch (Exception ex)
        {
            Toast.Show(ex is InvalidDataException ? ex.Message : L["clientsToastFailed"], ToastLevel.Error);
        }
    }

    private void ConfirmDelete(SalonClient client)
    {
        clientToDelete = client;
    }

    private async Task HandleDelete()
    {
        if (clientToDelete is null) return;

        try
        {
            var result = await Finance.DeleteClientAsync(clientToDelete.Id);
            if (result.Success)
            {
                Toast.Show(L["clientsToastDeleted"]);
                if (detailResult?.Client.Id == clientToDelete.Id) detailResult = null;
            }
            else
            {
                Toast.Show(result.ErrorMessage ?? L["clientsToastDeleteFailed"], ToastLevel.Error);
            }

            clientToDelete = null;
            await LoadClients();
        }
        catch (Exception ex)
        {
            Toast.Show(ex is InvalidDataException ? ex.Message : L["clientsToastDeleteFailed"], ToastLevel.Error);
        }
    }

    private async Task OpenDetail(SalonClient client)
    {
        try
        {
            detailResult = await Finance.GetClientDetailAsync(client.Id);
        }
        catch
        {
            Toast.Show(L["clientsToastDetailFailed"], ToastLevel.Error);
        }
    }

    private void CloseDetail()
    {
        detailResult = null;
    }

    private void CloseModal()
    {
        showModal = false;
    }

    private async void HandleStoreChanged()
    {
        await LoadClients();
        await InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        Finance.OnChange -= HandleStoreChanged;
    }
}

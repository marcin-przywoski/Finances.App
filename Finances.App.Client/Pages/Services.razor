@page "/services"
@implements IDisposable
@inject IFinanceService Finance
@inject ToastService Toast

<PageTitle>Services</PageTitle>

<div class="workspace-page">
    <section class="workspace-hero workspace-hero--catalog">
        <div class="workspace-hero-copy">
            <span class="workspace-kicker">Service menu</span>
            <h1 class="workspace-title">Services</h1>
            <p class="workspace-description">Keep the service menu current so pricing, appointment logging, and analytics all start from the right base values.</p>
        </div>
        <div class="workspace-hero-actions">
            <div class="workspace-action-row">
                <button class="btn btn-primary" @onclick="OpenAddModal">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="me-1"><path d="M12 5v14M5 12h14" /></svg>
                    Add service
                </button>
            </div>
        </div>
    </section>

    @if (services == null)
    {
        <LoadingSpinner />
    }
    else
    {
        <div class="workspace-summary-grid">
            <div class="workspace-summary-card">
                <span class="workspace-summary-label">Services</span>
                <strong>@services.Count</strong>
                <p>Service offerings currently available to log and analyze.</p>
            </div>
            <div class="workspace-summary-card">
                <span class="workspace-summary-label">Average base price</span>
                <strong>@(services.Count > 0 ? services.Average(s => s.BasePrice).ToString("C") : "$0.00")</strong>
                <p>Typical starting price across the service menu.</p>
            </div>
            <div class="workspace-summary-card">
                <span class="workspace-summary-label">Highest base price</span>
                <strong>@(services.Count > 0 ? services.Max(s => s.BasePrice).ToString("C") : "$0.00")</strong>
                <p>Premium offer currently listed in the menu.</p>
            </div>
            <div class="workspace-summary-card">
                <span class="workspace-summary-label">Lowest base price</span>
                <strong>@(services.Count > 0 ? services.Min(s => s.BasePrice).ToString("C") : "$0.00")</strong>
                <p>Entry-level offer in the current service range.</p>
            </div>
        </div>

        @if (services.Count == 0)
        {
            <div class="workspace-empty-state">
                <p>No services yet. Add the first service to start building the menu.</p>
            </div>
        }
        else
        {
            <section class="workspace-panel">
                <div class="workspace-panel-header workspace-panel-header-split">
                    <div>
                        <p class="workspace-panel-eyebrow">Menu</p>
                        <h2>Service list</h2>
                        <p>Update naming and pricing here before new appointments and reports are recorded.</p>
                    </div>
                    <span class="workspace-badge">@services.Count service@(services.Count == 1 ? "" : "s")</span>
                </div>
                <div class="table-responsive">
                    <table class="data-table workspace-table">
                        <thead>
                            <tr>
                                <th>Service Name</th>
                                <th>Base Price</th>
                                <th class="workspace-table-actions">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var svc in services)
                            {
                                <tr>
                                    <td class="fw-semibold">@svc.Name</td>
                                    <td>@svc.BasePrice.ToString("C")</td>
                                    <td class="workspace-table-actions">
                                        <button class="btn btn-sm btn-outline-secondary me-1" @onclick="() => OpenEditModal(svc)">Edit</button>
                                        <button class="btn btn-sm btn-outline-danger" @onclick="() => ConfirmDelete(svc)">Delete</button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </section>
        }
    }
</div>

@if (showModal)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.4);">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">@(isEditing ? "Edit Service" : "Add Service")</h5>
                    <button type="button" class="btn-close" @onclick="CloseModal"></button>
                </div>
                <EditForm Model="@formModel" OnValidSubmit="HandleSubmit">
                    <DataAnnotationsValidator />
                    <div class="modal-body">
                        <div class="mb-3">
                            <label class="form-label">Service Name</label>
                            <InputText class="form-control" @bind-Value="formModel.Name" />
                            <ValidationMessage For="() => formModel.Name" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Base Price</label>
                            <InputNumber class="form-control" @bind-Value="formModel.BasePrice" />
                            <ValidationMessage For="() => formModel.BasePrice" />
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" @onclick="CloseModal">Cancel</button>
                        <button type="submit" class="btn btn-primary" disabled="@saving">
                            @(saving ? "Saving..." : (isEditing ? "Update" : "Add"))
                        </button>
                    </div>
                </EditForm>
            </div>
        </div>
    </div>
}

<ConfirmDialog IsVisible="showDeleteConfirm"
               Title="Delete Service"
               Message="@($"Are you sure you want to delete {deleteTarget?.Name}? This cannot be undone.")"
               ConfirmText="Delete"
               OnConfirm="HandleDelete"
               OnCancel="() => { showDeleteConfirm = false; }" />

@code {
    private List<Service>? services;
    private Service formModel = new();
    private Service? deleteTarget;
    private bool showModal, isEditing, saving, showDeleteConfirm;
    private int editId;

    protected override async Task OnInitializedAsync()
    {
        Finance.OnChange += HandleStoreChanged;
        await LoadServices();
    }

    private async Task LoadServices()
    {
        services = (await Finance.GetServicesAsync()).ToList();
    }

    private void OpenAddModal()
    {
        formModel = new Service();
        isEditing = false;
        showModal = true;
    }

    private void OpenEditModal(Service s)
    {
        formModel = new Service { Id = s.Id, Name = s.Name, BasePrice = s.BasePrice };
        editId = s.Id;
        isEditing = true;
        showModal = true;
    }

    private void CloseModal() => showModal = false;

    private async Task HandleSubmit()
    {
        saving = true;
        try
        {
            if (isEditing)
            {
                await Finance.UpdateServiceAsync(editId, formModel);
                Toast.Show("Service updated");
            }
            else
            {
                await Finance.AddServiceAsync(formModel);
                Toast.Show("Service added");
            }
            await LoadServices();
            showModal = false;
        }
        catch (Exception ex)
        {
            Toast.Show(ex is InvalidDataException ? ex.Message : "Failed to save service", ToastLevel.Error);
        }
        finally { saving = false; }
    }

    private void ConfirmDelete(Service s)
    {
        deleteTarget = s;
        showDeleteConfirm = true;
    }

    private async Task HandleDelete()
    {
        if (deleteTarget == null) return;
        var result = await Finance.DeleteServiceAsync(deleteTarget.Id);
        if (result.Success) Toast.Show("Service deleted");
        else Toast.Show(result.ErrorMessage ?? "Failed to delete service. It may have related records.", ToastLevel.Error);
        showDeleteConfirm = false;
        deleteTarget = null;
        await LoadServices();
    }

    private async void HandleStoreChanged()
    {
        await InvokeAsync(async () =>
        {
            await LoadServices();
            StateHasChanged();
        });
    }

    public void Dispose()
    {
        Finance.OnChange -= HandleStoreChanged;
    }
}

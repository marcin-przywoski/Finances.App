@page "/services"
@implements IDisposable
@inject IFinanceService Finance
@inject ToastService Toast

<PageTitle>@L["servicesPageTitle"]</PageTitle>

<div class="workspace-page">
    <section class="workspace-hero workspace-hero--catalog">
        <div class="workspace-hero-copy">
            <span class="workspace-kicker">@L["servicesKicker"]</span>
            <h1 class="workspace-title">@L["servicesTitle"]</h1>
            <p class="workspace-description">@L["servicesDescription"]</p>
        </div>
        <div class="workspace-hero-actions">
            <div class="workspace-action-row">
                <button class="btn btn-primary" @onclick="OpenAddModal">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="me-1"><path d="M12 5v14M5 12h14" /></svg>
                    @L["servicesAddButton"]
                </button>
            </div>
        </div>
    </section>

    @if (services == null)
    {
        <LoadingSpinner />
    }
    else
    {
        <div class="workspace-summary-grid">
            <div class="workspace-summary-card">
                <span class="workspace-summary-label">@L["servicesSummaryLabel"]</span>
                <strong>@services.Count</strong>
                <p>@L["servicesSummaryDesc"]</p>
            </div>
            <div class="workspace-summary-card">
                <span class="workspace-summary-label">@L["servicesSummaryAvgPrice"]</span>
                <strong>@(services.Count > 0 ? services.Average(s => s.BasePrice).ToString("C") : "$0.00")</strong>
                <p>@L["servicesSummaryAvgPriceDesc"]</p>
            </div>
            <div class="workspace-summary-card">
                <span class="workspace-summary-label">@L["servicesSummaryHighest"]</span>
                <strong>@(services.Count > 0 ? services.Max(s => s.BasePrice).ToString("C") : "$0.00")</strong>
                <p>@L["servicesSummaryHighestDesc"]</p>
            </div>
            <div class="workspace-summary-card">
                <span class="workspace-summary-label">@L["servicesSummaryLowest"]</span>
                <strong>@(services.Count > 0 ? services.Min(s => s.BasePrice).ToString("C") : "$0.00")</strong>
                <p>@L["servicesSummaryLowestDesc"]</p>
            </div>
        </div>

        @if (services.Count == 0)
        {
            <div class="workspace-empty-state">
                <p>@L["servicesEmpty"]</p>
            </div>
        }
        else
        {
            <section class="workspace-panel">
                <div class="workspace-panel-header workspace-panel-header-split">
                    <div>
                        <p class="workspace-panel-eyebrow">@L["servicesPanelEyebrow"]</p>
                        <h2>@L["servicesPanelTitle"]</h2>
                        <p>@L["servicesPanelDesc"]</p>
                    </div>
                    <span class="workspace-badge">@services.Count service@(services.Count == 1 ? "" : "s")</span>
                </div>
                <div class="table-responsive">
                    <table class="data-table workspace-table">
                        <thead>
                            <tr>
                                <th>@L["servicesThName"]</th>
                                <th>@L["servicesThBasePrice"]</th>
                                <th class="workspace-table-actions">@L["servicesThActions"]</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var svc in services)
                            {
                                <tr>
                                    <td class="fw-semibold">@svc.Name</td>
                                    <td>@svc.BasePrice.ToString("C")</td>
                                    <td class="workspace-table-actions">
                                        <button class="btn btn-sm btn-outline-secondary me-1" @onclick="() => OpenEditModal(svc)">@L["commonEdit"]</button>
                                        <button class="btn btn-sm btn-outline-danger" @onclick="() => ConfirmDelete(svc)">@L["commonDelete"]</button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </section>
        }
    }
</div>

@if (showModal)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.4);">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">@(isEditing ? L["servicesModalTitleEdit"] : L["servicesModalTitleAdd"])</h5>
                    <button type="button" class="btn-close" @onclick="CloseModal"></button>
                </div>
                <EditForm Model="@formModel" OnValidSubmit="HandleSubmit">
                    <DataAnnotationsValidator />
                    <div class="modal-body">
                        <div class="mb-3">
                            <label class="form-label">@L["servicesModalLabelName"]</label>
                            <InputText class="form-control" @bind-Value="formModel.Name" />
                            <ValidationMessage For="() => formModel.Name" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label">@L["servicesModalLabelPrice"]</label>
                            <InputNumber class="form-control" @bind-Value="formModel.BasePrice" />
                            <ValidationMessage For="() => formModel.BasePrice" />
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" @onclick="CloseModal">@L["servicesModalCancel"]</button>
                        <button type="submit" class="btn btn-primary" disabled="@saving">
                            @(saving ? L["servicesModalSaving"] : (isEditing ? L["servicesModalUpdate"] : L["servicesModalAdd"]))
                        </button>
                    </div>
                </EditForm>
            </div>
        </div>
    </div>
}

<ConfirmDialog IsVisible="showDeleteConfirm"
               Title="@L["servicesDeleteTitle"]"
               Message="@(L.T("servicesDeleteMsg", deleteTarget?.Name ?? ""))"
               ConfirmText="@L["servicesDeleteConfirm"]"
               OnConfirm="HandleDelete"
               OnCancel="() => { showDeleteConfirm = false; }" />

@code {
    private List<Service>? services;
    private Service formModel = new();
    private Service? deleteTarget;
    private bool showModal, isEditing, saving, showDeleteConfirm;
    private int editId;

    protected override async Task OnInitializedAsync()
    {
        Finance.OnChange += HandleStoreChanged;
        await LoadServices();
    }

    private async Task LoadServices()
    {
        services = (await Finance.GetServicesAsync()).ToList();
    }

    private void OpenAddModal()
    {
        formModel = new Service();
        isEditing = false;
        showModal = true;
    }

    private void OpenEditModal(Service s)
    {
        formModel = new Service { Id = s.Id, Name = s.Name, BasePrice = s.BasePrice };
        editId = s.Id;
        isEditing = true;
        showModal = true;
    }

    private void CloseModal() => showModal = false;

    private async Task HandleSubmit()
    {
        saving = true;
        try
        {
            if (isEditing)
            {
                await Finance.UpdateServiceAsync(editId, formModel);
                Toast.Show(L["servicesToastUpdated"]);
            }
            else
            {
                await Finance.AddServiceAsync(formModel);
                Toast.Show(L["servicesToastAdded"]);
            }
            await LoadServices();
            showModal = false;
        }
        catch (Exception ex)
        {
            Toast.Show(ex is InvalidDataException ? ex.Message : L["servicesToastFailed"], ToastLevel.Error);
        }
        finally { saving = false; }
    }

    private void ConfirmDelete(Service s)
    {
        deleteTarget = s;
        showDeleteConfirm = true;
    }

    private async Task HandleDelete()
    {
        if (deleteTarget == null) return;
        var result = await Finance.DeleteServiceAsync(deleteTarget.Id);
        if (result.Success) Toast.Show(L["servicesToastDeleted"]);
        else Toast.Show(result.ErrorMessage ?? L["servicesToastDeleteFailed"], ToastLevel.Error);
        showDeleteConfirm = false;
        deleteTarget = null;
        await LoadServices();
    }

    private async void HandleStoreChanged()
    {
        await InvokeAsync(async () =>
        {
            await LoadServices();
            StateHasChanged();
        });
    }

    public void Dispose()
    {
        Finance.OnChange -= HandleStoreChanged;
    }
}

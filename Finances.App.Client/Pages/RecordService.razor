@page "/record"
@inject IFinanceStore Store
@inject MoneyFormat Money
@inject ToastService Toast
@inject WorkerContextService WorkerContext
@inject NavigationManager Nav

<PageTitle>Record Service</PageTitle>

<div class="mb-4">
    <h1 class="page-title mb-1">Record a Service</h1>
    <p class="text-muted mb-0">Log a completed service for a client.</p>
</div>

@if (workers == null || services == null)
{
    <LoadingSpinner />
}
else if (workers.Count == 0 || services.Count == 0)
{
    <div class="card p-5 text-center" style="max-width: 640px;">
        <p class="text-muted mb-3">
            Recording a visit needs at least one worker and one service.
        </p>
        <div class="d-flex justify-content-center gap-2 flex-wrap">
            @if (workers.Count == 0)
            {
                <a class="btn btn-primary" href="workers">Add Workers</a>
            }
            @if (services.Count == 0)
            {
                <a class="btn btn-primary" href="services">Add Services</a>
            }
        </div>
    </div>
}
else
{
    <div class="card p-4" style="max-width: 640px;">
        <EditForm Model="@record" OnValidSubmit="HandleSubmit">
            <DataAnnotationsValidator />

            <div class="row g-3">
                <div class="col-md-6">
                    <label class="form-label" for="record-worker">Worker</label>
                    <select id="record-worker" class="form-select" value="@record.WorkerId" @onchange="OnWorkerChanged">
                        <option value="0">-- Select Worker --</option>
                        @foreach (var w in workers)
                        {
                            <option value="@w.Id">@w.Name</option>
                        }
                    </select>
                </div>

                <div class="col-md-6">
                    <label class="form-label" for="record-service">Service</label>
                    <select id="record-service" class="form-select" value="@record.ServiceId" @onchange="OnServiceChanged">
                        <option value="0">-- Select Service --</option>
                        @foreach (var s in services)
                        {
                            <option value="@s.Id">@s.Name (@Money.Format(s.BasePrice))</option>
                        }
                    </select>
                </div>

                <div class="col-md-6">
                    <label class="form-label" for="record-date">Date</label>
                    <InputDate id="record-date" class="form-control" @bind-Value="record.DatePerformed" />
                </div>

                <div class="col-md-6">
                    <label class="form-label" for="record-client">Client Name</label>
                    <InputText id="record-client" class="form-control" @bind-Value="record.ClientName" placeholder="Optional" />
                </div>

                <div class="col-md-4">
                    <label class="form-label" for="record-amount">Amount Paid</label>
                    <InputNumber id="record-amount" class="form-control" @bind-Value="record.AmountPaid" />
                    <ValidationMessage For="() => record.AmountPaid" />
                </div>

                <div class="col-md-4">
                    <label class="form-label" for="record-commission">Commission %</label>
                    <InputNumber id="record-commission" class="form-control" @bind-Value="record.CommissionPercentageApplied" />
                    <ValidationMessage For="() => record.CommissionPercentageApplied" />
                </div>

                <div class="col-md-4">
                    <label class="form-label" for="record-tips">Tips</label>
                    <InputNumber id="record-tips" class="form-control" @bind-Value="record.Tips" />
                    <ValidationMessage For="() => record.Tips" />
                </div>

                <div class="col-12">
                    <label class="form-label" for="record-notes">Notes</label>
                    <InputTextArea id="record-notes" class="form-control" @bind-Value="record.Notes" rows="2" placeholder="Optional notes..." />
                </div>
            </div>

            <hr class="my-3" />

            <div class="d-flex justify-content-between align-items-center">
                <div>
                    @if (record.AmountPaid > 0 && record.CommissionPercentageApplied > 0)
                    {
                        <span class="text-muted" style="font-size: 0.875rem;">
                            Worker: <strong>@Money.Format(record.WorkerShare)</strong> &middot; Salon: <strong>@Money.Format(record.SalonShare)</strong>
                        </span>
                    }
                </div>
                <button type="submit" class="btn btn-primary" disabled="@saving">
                    @(saving ? "Saving..." : "Save Record")
                </button>
            </div>
        </EditForm>
    </div>
}


@code {
    private List<Worker>? workers;
    private List<Service>? services;
    private ServiceRecord record = new() { DatePerformed = DateTime.Today };
    private bool saving;

    protected override async Task OnInitializedAsync()
    {
        workers = (await Store.GetWorkersAsync()).ToList();
        services = (await Store.GetServicesAsync()).ToList();

        await WorkerContext.InitializeAsync();
        if (WorkerContext.SelectedWorkerId.HasValue && workers != null)
        {
            var w = workers.FirstOrDefault(x => x.Id == WorkerContext.SelectedWorkerId.Value);
            if (w != null)
            {
                record.WorkerId = w.Id;
                record.CommissionPercentageApplied = w.DefaultCommissionPercentage;
            }
        }
    }

    private void OnWorkerChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var id))
        {
            record.WorkerId = id;
            var w = workers?.FirstOrDefault(x => x.Id == id);
            if (w != null)
                record.CommissionPercentageApplied = w.DefaultCommissionPercentage;
        }
    }

    private void OnServiceChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var id))
        {
            record.ServiceId = id;
            var s = services?.FirstOrDefault(x => x.Id == id);
            if (s != null)
                record.AmountPaid = s.BasePrice;
        }
    }

    private async Task HandleSubmit()
    {
        if (record.WorkerId == 0 || record.ServiceId == 0)
        {
            Toast.Show("Please select a worker and a service.", ToastLevel.Error);
            return;
        }

        saving = true;
        try
        {
            await Store.AddServiceRecordAsync(record);
            Toast.Show("Service recorded successfully!", ToastLevel.Success, "View History", () =>
            {
                Nav.NavigateTo("history");
                return Task.CompletedTask;
            });

            // Keep worker, commission, and service: a salon logging a run of
            // identical visits should not re-pick the service every time.
            var service = services?.FirstOrDefault(s => s.Id == record.ServiceId);
            record = new ServiceRecord
            {
                DatePerformed = DateTime.Today,
                WorkerId = record.WorkerId,
                CommissionPercentageApplied = record.CommissionPercentageApplied,
                ServiceId = record.ServiceId,
                AmountPaid = service?.BasePrice ?? 0
            };
        }
        catch (Exception ex)
        {
            Toast.Show(UserFacingError.Message(ex), ToastLevel.Error);
        }
        finally { saving = false; }
    }
}

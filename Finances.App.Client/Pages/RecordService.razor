@page "/record"
@implements IDisposable
@inject IFinanceService Finance
@inject ToastService Toast
@inject WorkerContextService WorkerContext
@inject NavigationManager Nav

<PageTitle>@L["recordPageTitle"]</PageTitle>

<div class="workspace-page">
    <section class="workspace-hero workspace-hero--record">
        <div class="workspace-hero-copy">
            <span class="workspace-kicker">@L["recordKicker"]</span>
            <h1 class="workspace-title">@L["recordTitle"]</h1>
            <p class="workspace-description">@L["recordDescription"]</p>
        </div>
    </section>

@if (workers == null || services == null)
{
    <LoadingSpinner />
}
else
{
    <div class="card p-4" style="max-width: 640px;">
        <EditForm Model="@record" OnValidSubmit="HandleSubmit">
            <DataAnnotationsValidator />

            <div class="row g-3">
                <div class="col-md-6">
                    <label class="form-label">@L["recordLabelWorker"]</label>
                    <select class="form-select" value="@record.WorkerId" @onchange="OnWorkerChanged">
                        <option value="0">@L["recordSelectWorker"]</option>
                        @foreach (var w in workers)
                        {
                            <option value="@w.Id">@w.Name</option>
                        }
                    </select>
                </div>

                <div class="col-md-6">
                    <label class="form-label">@L["recordLabelService"]</label>
                    <select class="form-select" value="@record.ServiceId" @onchange="OnServiceChanged">
                        <option value="0">@L["recordSelectService"]</option>
                        @foreach (var s in services)
                        {
                            <option value="@s.Id">@s.Name (@s.BasePrice.ToString("C"))</option>
                        }
                    </select>
                </div>

                <div class="col-md-6">
                    <label class="form-label">@L["recordLabelDate"]</label>
                    <InputDate class="form-control" @bind-Value="record.DatePerformed" />
                </div>

                <div class="col-md-6">
                    <label class="form-label">@L["recordLabelClient"]</label>
                    <ClientSelector @bind-Value="record.ClientName" @bind-ClientId="record.ClientId" />
                </div>

                <div class="col-md-4">
                    <label class="form-label">@L["recordLabelAmount"]</label>
                    <InputNumber class="form-control" @bind-Value="record.AmountPaid" />
                    <ValidationMessage For="() => record.AmountPaid" />
                </div>

                <div class="col-md-4">
                    <label class="form-label">@L["recordLabelCommission"]</label>
                    <InputNumber class="form-control" @bind-Value="record.CommissionPercentageApplied" />
                    <ValidationMessage For="() => record.CommissionPercentageApplied" />
                </div>

                <div class="col-md-4">
                    <label class="form-label">@L["recordLabelTips"]</label>
                    <InputNumber class="form-control" @bind-Value="record.Tips" />
                    <ValidationMessage For="() => record.Tips" />
                </div>

                <div class="col-12">
                    <label class="form-label">@L["recordLabelNotes"]</label>
                    <InputTextArea class="form-control" @bind-Value="record.Notes" rows="2" placeholder="@L["recordNotesPlaceholder"]" />
                </div>
            </div>

            <hr class="my-3" />

            <div class="d-flex justify-content-between align-items-center">
                <div>
                    @if (record.AmountPaid > 0 && record.CommissionPercentageApplied > 0)
                    {
                        var workerShare = record.AmountPaid * (record.CommissionPercentageApplied / 100);
                        var salonShare = record.AmountPaid - workerShare;
                        <span class="text-muted" style="font-size: 0.875rem;">
                            @L["recordWorkerLabel"] <strong>@workerShare.ToString("C")</strong> &middot; @L["recordSalonLabel"] <strong>@salonShare.ToString("C")</strong>
                        </span>
                    }
                </div>
                <button type="submit" class="btn btn-primary" disabled="@saving">
                    @(saving ? L["recordSaving"] : L["recordSaveButton"])
                </button>
            </div>
        </EditForm>
    </div>
}
</div>

@code {
    private List<Worker>? workers;
    private List<Service>? services;
    private ServiceRecord record = new() { DatePerformed = DateTime.Today };
    private bool saving;

    protected override async Task OnInitializedAsync()
    {
        Finance.OnChange += HandleStoreChange;
        await LoadLookupDataAsync();
    }

    private async Task LoadLookupDataAsync()
    {
        workers = (await Finance.GetWorkersAsync()).ToList();
        services = (await Finance.GetServicesAsync()).ToList();

        await WorkerContext.InitializeAsync();
        if (WorkerContext.SelectedWorkerId.HasValue && workers != null)
        {
            var w = workers.FirstOrDefault(x => x.Id == WorkerContext.SelectedWorkerId.Value);
            if (w != null)
            {
                record.WorkerId = w.Id;
                record.CommissionPercentageApplied = w.DefaultCommissionPercentage;
            }
        }
    }

    private async Task OnWorkerChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var id))
        {
            record.WorkerId = id;
            var w = workers?.FirstOrDefault(x => x.Id == id);
            if (w != null)
            {
                record.CommissionPercentageApplied = w.DefaultCommissionPercentage;
                await WorkerContext.SetWorkerAsync(w.Id);
            }
        }
    }

    private void OnServiceChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var id))
        {
            record.ServiceId = id;
            var s = services?.FirstOrDefault(x => x.Id == id);
            if (s != null)
                record.AmountPaid = s.BasePrice;
        }
    }

    private async Task HandleSubmit()
    {
        if (record.WorkerId == 0 || record.ServiceId == 0)
        {
            Toast.Show(L["recordValidation"], ToastLevel.Error);
            return;
        }

        saving = true;
        try
        {
            await Finance.AddServiceRecordAsync(record);

            if (record.WorkerId != 0)
            {
                await WorkerContext.SetWorkerAsync(record.WorkerId);
            }

            Toast.Show(L["recordToastSuccess"]);
            record = new ServiceRecord
            {
                DatePerformed = DateTime.Today,
                WorkerId = record.WorkerId,
                CommissionPercentageApplied = record.CommissionPercentageApplied
            };
        }
        catch (Exception ex)
        {
            Toast.Show(ex is InvalidDataException ? ex.Message : L["recordToastFailed"], ToastLevel.Error);
        }
        finally { saving = false; }
    }

    private async void HandleStoreChange()
    {
        await InvokeAsync(async () =>
        {
            await LoadLookupDataAsync();
            StateHasChanged();
        });
    }

    public void Dispose()
    {
        Finance.OnChange -= HandleStoreChange;
    }
}

@page "/history"
@inject HttpClient Http
@inject WorkerContextService WorkerContext
@inject ToastService Toast

<PageTitle>History</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="mb-1" style="font-weight: 700;">Service History</h2>
        <p class="text-muted mb-0">View, edit, and manage past service records.</p>
    </div>
</div>

<DateRangeFilter From="@dateFrom" To="@dateTo" OnRangeChanged="OnDateRangeChanged" />

@if (allRecords == null)
{
    <LoadingSpinner />
}
else
{
    var filtered = GetFilteredRecords();

    @if (filtered.Count == 0)
    {
        <div class="card p-5 text-center mt-3">
            <p class="text-muted mb-0">No records found for the selected period.</p>
        </div>
    }
    else
    {
        <div class="card mt-3">
            <div class="table-responsive">
                <table class="table table-hover mb-0">
                    <thead>
                        <tr>
                            <th @onclick='() => SetSort("date")' style="cursor:pointer;">
                                Date @SortIcon("date")
                            </th>
                            <th>Worker</th>
                            <th>Service</th>
                            <th>Client</th>
                            <th @onclick='() => SetSort("amount")' style="cursor:pointer;">
                                Amount @SortIcon("amount")
                            </th>
                            <th>Commission</th>
                            <th>Tips</th>
                            <th @onclick='() => SetSort("worker_share")' style="cursor:pointer;">
                                Worker Share @SortIcon("worker_share")
                            </th>
                            <th>Notes</th>
                            <th style="width: 100px;">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var r in filtered)
                        {
                            <tr>
                                <td>@r.DatePerformed.ToString("yyyy-MM-dd")</td>
                                <td class="fw-semibold">@(r.Worker?.Name ?? "—")</td>
                                <td>@(r.Service?.Name ?? "—")</td>
                                <td class="text-muted">@(r.ClientName ?? "—")</td>
                                <td>@r.AmountPaid.ToString("C")</td>
                                <td>@r.CommissionPercentageApplied%</td>
                                <td>@r.Tips.ToString("C")</td>
                                <td class="fw-semibold">@r.WorkerShare.ToString("C")</td>
                                <td class="text-muted" style="max-width: 150px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">@(r.Notes ?? "")</td>
                                <td>
                                    <button class="btn btn-sm btn-outline-secondary me-1" @onclick="() => OpenEditModal(r)">Edit</button>
                                    <button class="btn btn-sm btn-outline-danger" @onclick="() => ConfirmDelete(r)">Delete</button>
                                </td>
                            </tr>
                        }
                    </tbody>
                    <tfoot>
                        <tr class="fw-bold" style="background-color: var(--body-bg);">
                            <td colspan="4">Totals</td>
                            <td>@filtered.Sum(r => r.AmountPaid).ToString("C")</td>
                            <td></td>
                            <td>@filtered.Sum(r => r.Tips).ToString("C")</td>
                            <td>@filtered.Sum(r => r.WorkerShare).ToString("C")</td>
                            <td colspan="2"></td>
                        </tr>
                    </tfoot>
                </table>
            </div>
        </div>
    }
}

@if (showEditModal)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.4);">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Edit Service Record</h5>
                    <button type="button" class="btn-close" @onclick="CloseEditModal"></button>
                </div>
                <EditForm Model="@editModel" OnValidSubmit="HandleEditSubmit">
                    <DataAnnotationsValidator />
                    <div class="modal-body">
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label class="form-label">Worker</label>
                                <select class="form-select" value="@editModel.WorkerId" @onchange="OnEditWorkerChanged">
                                    @if (workers != null)
                                    {
                                        @foreach (var w in workers)
                                        {
                                            <option value="@w.Id">@w.Name</option>
                                        }
                                    }
                                </select>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">Service</label>
                                <select class="form-select" value="@editModel.ServiceId" @onchange="OnEditServiceChanged">
                                    @if (services != null)
                                    {
                                        @foreach (var s in services)
                                        {
                                            <option value="@s.Id">@s.Name (@s.BasePrice.ToString("C"))</option>
                                        }
                                    }
                                </select>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">Date</label>
                                <InputDate class="form-control" @bind-Value="editModel.DatePerformed" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">Client Name</label>
                                <InputText class="form-control" @bind-Value="editModel.ClientName" placeholder="Optional" />
                            </div>
                            <div class="col-md-4">
                                <label class="form-label">Amount Paid</label>
                                <InputNumber class="form-control" @bind-Value="editModel.AmountPaid" />
                            </div>
                            <div class="col-md-4">
                                <label class="form-label">Commission %</label>
                                <InputNumber class="form-control" @bind-Value="editModel.CommissionPercentageApplied" />
                            </div>
                            <div class="col-md-4">
                                <label class="form-label">Tips</label>
                                <InputNumber class="form-control" @bind-Value="editModel.Tips" />
                            </div>
                            <div class="col-12">
                                <label class="form-label">Notes</label>
                                <InputTextArea class="form-control" @bind-Value="editModel.Notes" rows="2" />
                            </div>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" @onclick="CloseEditModal">Cancel</button>
                        <button type="submit" class="btn btn-primary" disabled="@saving">
                            @(saving ? "Saving..." : "Update")
                        </button>
                    </div>
                </EditForm>
            </div>
        </div>
    </div>
}

<ConfirmDialog IsVisible="showDeleteConfirm"
               Title="Delete Record"
               Message="@($"Are you sure you want to delete this service record from {deleteTarget?.DatePerformed.ToString("yyyy-MM-dd")}? This cannot be undone.")"
               ConfirmText="Delete"
               OnConfirm="HandleDelete"
               OnCancel="() => { showDeleteConfirm = false; }" />

<Toast />

@code {
    private List<ServiceRecord>? allRecords;
    private List<Worker>? workers;
    private List<Service>? services;
    private DateTime? dateFrom;
    private DateTime? dateTo;
    private string sortColumn = "date";
    private bool sortAsc = false;

    private ServiceRecord editModel = new();
    private bool showEditModal;
    private bool saving;

    private ServiceRecord? deleteTarget;
    private bool showDeleteConfirm;

    protected override async Task OnInitializedAsync()
    {
        await WorkerContext.InitializeAsync();
        allRecords = await Http.GetFromJsonAsync<List<ServiceRecord>>("api/servicerecords");
        workers = await Http.GetFromJsonAsync<List<Worker>>("api/workers");
        services = await Http.GetFromJsonAsync<List<Service>>("api/services");
    }

    private void OnDateRangeChanged((DateTime? From, DateTime? To) range)
    {
        dateFrom = range.From;
        dateTo = range.To;
    }

    private List<ServiceRecord> GetFilteredRecords()
    {
        if (allRecords == null) return new();

        var q = allRecords.AsEnumerable();

        if (WorkerContext.SelectedWorkerId.HasValue)
            q = q.Where(r => r.WorkerId == WorkerContext.SelectedWorkerId.Value);

        if (dateFrom.HasValue)
            q = q.Where(r => r.DatePerformed.Date >= dateFrom.Value.Date);

        if (dateTo.HasValue)
            q = q.Where(r => r.DatePerformed.Date <= dateTo.Value.Date);

        q = sortColumn switch
        {
            "date" => sortAsc ? q.OrderBy(r => r.DatePerformed) : q.OrderByDescending(r => r.DatePerformed),
            "amount" => sortAsc ? q.OrderBy(r => r.AmountPaid) : q.OrderByDescending(r => r.AmountPaid),
            "worker_share" => sortAsc ? q.OrderBy(r => r.WorkerShare) : q.OrderByDescending(r => r.WorkerShare),
            _ => q.OrderByDescending(r => r.DatePerformed)
        };

        return q.ToList();
    }

    private void SetSort(string column)
    {
        if (sortColumn == column)
            sortAsc = !sortAsc;
        else
        {
            sortColumn = column;
            sortAsc = true;
        }
    }

    private string SortIcon(string column)
    {
        if (sortColumn != column) return "";
        return sortAsc ? "▲" : "▼";
    }

    private void OpenEditModal(ServiceRecord record)
    {
        editModel = new ServiceRecord
        {
            Id = record.Id,
            WorkerId = record.WorkerId,
            ServiceId = record.ServiceId,
            DatePerformed = record.DatePerformed,
            AmountPaid = record.AmountPaid,
            CommissionPercentageApplied = record.CommissionPercentageApplied,
            Tips = record.Tips,
            ClientName = record.ClientName,
            Notes = record.Notes
        };
        showEditModal = true;
    }

    private void CloseEditModal() => showEditModal = false;

    private void OnEditWorkerChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var id))
        {
            editModel.WorkerId = id;
            var w = workers?.FirstOrDefault(x => x.Id == id);
            if (w != null)
                editModel.CommissionPercentageApplied = w.DefaultCommissionPercentage;
        }
    }

    private void OnEditServiceChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var id))
            editModel.ServiceId = id;
    }

    private async Task HandleEditSubmit()
    {
        saving = true;
        try
        {
            var resp = await Http.PutAsJsonAsync($"api/servicerecords/{editModel.Id}", editModel);
            if (resp.IsSuccessStatusCode)
            {
                Toast.Show("Record updated");
                allRecords = await Http.GetFromJsonAsync<List<ServiceRecord>>("api/servicerecords");
                showEditModal = false;
            }
            else
            {
                Toast.Show("Failed to update record", ToastLevel.Error);
            }
        }
        finally { saving = false; }
    }

    private void ConfirmDelete(ServiceRecord record)
    {
        deleteTarget = record;
        showDeleteConfirm = true;
    }

    private async Task HandleDelete()
    {
        if (deleteTarget == null) return;
        var resp = await Http.DeleteAsync($"api/servicerecords/{deleteTarget.Id}");
        if (resp.IsSuccessStatusCode)
        {
            Toast.Show("Record deleted");
            allRecords = await Http.GetFromJsonAsync<List<ServiceRecord>>("api/servicerecords");
        }
        else
        {
            Toast.Show("Failed to delete record", ToastLevel.Error);
        }
        showDeleteConfirm = false;
        deleteTarget = null;
    }
}
